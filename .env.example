# Atlas Backend — environment variables.
#
# Copy to `.env` for local development. Every value here is validated at
# process boot (src/config/env.validation.ts) — the app refuses to start
# with a missing or malformed required variable rather than falling back to
# a silent default for anything security- or connectivity-critical.
#
# NEVER commit a real `.env` file. NEVER put a real secret in this example file.

# --- Runtime ---
NODE_ENV=development
PORT=3000

# --- Database (PostgreSQL) ---
# Local default matches docker-compose.yml's postgres service.
DATABASE_URL=postgresql://atlas:atlas_dev_password@localhost:5432/atlas_dev?schema=public

# --- Cache / Queue broker (Redis) ---
# Local default matches docker-compose.yml's redis service.
REDIS_URL=redis://localhost:6379

# --- CORS ---
# Comma-separated list of allowed origins. Required in production (no
# wildcard is ever accepted when NODE_ENV=production) — optional in
# development, where it defaults to the Vite dev server's usual origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Logging ---
# One of: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
