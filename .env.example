# Atlas Backend — environment variables.
#
# Copy to `.env` for local development. Every value here is validated at
# process boot (src/config/env.validation.ts) — the app refuses to start
# with a missing or malformed required variable rather than falling back to
# a silent default for anything security- or connectivity-critical.
#
# NEVER commit a real `.env` file. NEVER put a real secret in this example file.

# --- Runtime ---
NODE_ENV=development
PORT=3000

# --- Database (PostgreSQL) ---
# Local default matches docker-compose.yml's postgres service.
DATABASE_URL=postgresql://atlas:atlas_dev_password@localhost:5432/atlas_dev?schema=public

# --- Cache / Queue broker (Redis) ---
# Local default matches docker-compose.yml's redis service.
REDIS_URL=redis://localhost:6379

# --- CORS ---
# Comma-separated list of allowed origins. Required in production (no
# wildcard is ever accepted when NODE_ENV=production) — optional in
# development, where it defaults to the Vite dev server's usual origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Logging ---
# One of: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Object Storage (Phase P8 — Cloudflare R2, S3-compatible, ADR-005) ---
# Local default targets docker-compose.yml's MinIO service — a real,
# local, S3-compatible store R2StorageProvider talks the exact same
# protocol against. Point these at real Cloudflare R2 in production.
R2_ENDPOINT=http://localhost:9000
# R2 documents 'auto' as its own recommended region; MinIO needs a real
# region string instead (confirmed during implementation) — use 'auto'
# only when pointed at real Cloudflare R2.
R2_REGION=us-east-1
R2_ACCESS_KEY_ID=atlas_media_dev
R2_SECRET_ACCESS_KEY=atlas_media_dev_password
R2_BUCKET=atlas-media-dev
R2_PUBLIC_URL_BASE=http://localhost:9000/atlas-media-dev
# MinIO/R2 both support path-style addressing; true is correct for both
# the local default above and real R2.
R2_FORCE_PATH_STYLE=true
# Per-file upload ceiling (bytes) for the V1 base64-bridge upload path.
MEDIA_MAX_UPLOAD_BYTES=10485760

# P11 — Public Website Runtime, Domains & Edge (all optional; leave unset
# for local dev — every domain/SSL/CDN status then honestly reports
# "not configured"/connected: false, matching the real frontend contract).
# PLATFORM_BASE_DOMAIN=atlas.dev
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_ACCOUNT_ID=

# --- P12 — Atlas Subscription Billing (master plan §5.7, §12, §16) ---
# HMAC signing secret for inbound payment-provider webhooks. Required —
# unlike Cloudflare above, Atlas controls both ends of this contract, so
# there's no "no real account exists" reason to leave it optional. Generate
# a real random value per environment; never reuse the dev example below.
PAYMENT_WEBHOOK_SECRET=replace-with-a-real-32-plus-character-random-secret

# AES-256-GCM key `CredentialEncryptionService` uses to envelope-encrypt
# organization-owned gateway credentials at rest (master plan §5.8, §16).
# Required — exactly 64 hex characters (32 raw bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse the dev example below in a real environment.
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=replace-with-a-real-64-character-hex-key-000000000000000000000000
