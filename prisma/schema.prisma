// Atlas Backend — Prisma schema.
//
// Phase P0 (Foundation) scope only. Per Reports/ATLAS_BACKEND_MASTER_PLAN.md
// §21's Phase P0 entry: "Database changes: none domain-specific — migration
// tooling proven with one trivial migration (e.g. a `schema_meta` table) to
// confirm the pipeline works."
//
// No business/domain tables (users, organizations, academies, courses, ...)
// are defined here. They begin in Phase P1 onward, each phase extending this
// file with its own models — see the master plan's §5 for the full,
// eventual schema this file grows into. Do not add a table here that a
// later phase owns; this file's only job right now is to prove the
// migration pipeline is real, not to anticipate future schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Proves the migration pipeline end-to-end (create, apply, and read back a
/// real table) without modeling any business domain. Intentionally the only
/// model in this phase. Not tenant-scoped — this is platform-infrastructure
/// metadata (e.g. a schema version marker), not tenant data, so it
/// deliberately carries no `organization_id`/`academy_id` and needs no RLS
/// policy (see the master plan §7's tenant-scoping rule, which applies to
/// domain tables, not this one).
model SchemaMeta {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("schema_meta")
}

// ---------------------------------------------------------------------------
// Phase P1 — Identity, Auth & Sessions (master plan §5.1, §21 Phase P1).
//
// Platform-scoped, not tenant-scoped: a user is not owned by one
// organization (that relationship — `organization_memberships` — is Phase
// P2's job). No RLS policy applies here for the same reason §7 exempts
// `schema_meta`: these tables carry no `organization_id`/`academy_id`.
// ---------------------------------------------------------------------------

/// Matches `PlatformUserAccountStatus`/`CurrentUser` exactly. Deliberately
/// only these three values — do not add `locked`/`pending_verification`
/// states; both email verification and account lockout are explicitly
/// `SPECIFICATION-UNDEFINED` per master plan §8/§24 and must not be built
/// into the schema ahead of a product decision.
enum UserAccountStatus {
  active
  invited
  suspended

  @@map("user_account_status")
}

/// One account per human — mirrors `CurrentUser` (master plan §5.1).
///
/// Email case-insensitivity note: the master plan suggests Postgres
/// `citext`, but Prisma has no first-class `citext` column type (it can
/// only be modeled via `Unsupported("citext")`, which the Prisma Client
/// cannot use in ordinary `where`/`create` calls — every lookup would need
/// hand-written raw SQL, which is inconsistent with every other table in
/// this codebase using the Client normally). Case-insensitivity is instead
/// enforced at the application layer: every write and lookup normalizes
/// email via `.trim().toLowerCase()` before it ever reaches Prisma
/// (`identity/utils/email.util.ts`), so the plain `@unique` constraint below
/// still guarantees one account per email regardless of the case a user
/// types it in.
model User {
  id              String            @id @default(uuid())
  email           String            @unique
  passwordHash    String            @map("password_hash")
  name            String
  avatarUrl       String?           @map("avatar_url")
  isPlatformOwner Boolean           @default(false) @map("is_platform_owner")
  /// Mirrors `UserPreferences` (`theme?`, `language?`, `notifications?`).
  /// Validated server-side (not schema-enforced) — see `PreferencesService`.
  preferences     Json              @default("{}")
  status          UserAccountStatus @default(active)
  lastSignInAt    DateTime?         @map("last_sign_in_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  ownedOrganizations      Organization[]           @relation("OrganizationOwner")
  organizationMemberships OrganizationMembership[]
  academyMemberships      AcademyMember[]
  courseInstructorships   CourseInstructor[]

  @@index([status])
  @@map("users")
}

/// Rotating session tokens backing `TokenMetadata.refreshToken`. Only the
/// SHA-256 hash of the raw token is ever persisted — a database leak alone
/// never yields a usable token (master plan §5.1, §8, §16).
model RefreshToken {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @map("token_hash")
  deviceLabel String?   @map("device_label")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

/// Backs `PasswordResetRequest`/`PasswordResetConfirmation`. Single-use,
/// short-lived, hashed at rest — same rationale as `RefreshToken`.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Phase P2 — Organizations, Membership & Multi-Tenancy Core (master plan
// §5.2, §7, §21 Phase P2).
//
// `organizations` is the tenant root. Every tenant-scoped table from this
// phase forward carries `organization_id` as a real FK column (§5's
// universal convention) and gets an RLS policy created in the SAME
// migration that creates it (§17) — see migration.sql for the
// `ENABLE ROW LEVEL SECURITY` / `FORCE ROW LEVEL SECURITY` / `CREATE
// POLICY` statements; Prisma's schema language has no RLS syntax, so those
// are appended by hand to the generated migration, not expressed here.
// ---------------------------------------------------------------------------

/// Matches `Organization`'s status union (mirrored from
/// `PlatformOrganizationSummary`/`Detail` — there is no standalone bare
/// `Organization` type in the frontend today; this enum's values are taken
/// directly from the master plan §5.2 definition, which all
/// organization-shaped frontend types agree with).
enum OrganizationStatus {
  active
  suspended
  archived

  @@map("organization_status")
}

/// The SaaS tenant boundary — the root of the tenant hierarchy (master plan
/// §7). Soft-delete only: no delete endpoint exists or is planned for this
/// table; `status` is the only lifecycle mechanism.
model Organization {
  id          String             @id @default(uuid())
  name        String
  slug        String             @unique
  status      OrganizationStatus @default(active)
  ownerUserId String             @map("owner_user_id")
  owner       User               @relation("OrganizationOwner", fields: [ownerUserId], references: [id])
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  memberships  OrganizationMembership[]
  academies    Academy[]
  subscription TenantSubscription?
  addOns       TenantAddOn[]
  usage        TenantUsage?

  @@index([status])
  @@map("organizations")
}

/// Join table between `users` and `organizations` — mirrors
/// `OrganizationMembership` (`identity.types.ts`) field-for-field. `role`
/// stays a flat string and `permissions` a flat string array by deliberate
/// design (master plan §9): there is no Role/Permission catalog table, and
/// P2 must not introduce one.
model OrganizationMembership {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  permissions    String[]     @default([])
  isPrimary      Boolean      @default(false) @map("is_primary")
  joinedAt       DateTime     @default(now()) @map("joined_at")

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_memberships")
}

// ---------------------------------------------------------------------------
// Phase P3 — Academy Management (master plan §5.2, §21 Phase P3).
//
// Academy is the second-level tenant scope, belonging to exactly one
// Organization. RLS resolves tenant ownership transitively through
// `organization_id`/`academy_id` — no new session variable, no parallel
// tenant mechanism; the same `app.current_organization_id`/
// `app.current_user_id` variables P2 established are reused. See
// migration.sql for the policies (Prisma's schema language has no RLS
// syntax).
// ---------------------------------------------------------------------------

/// Matches `AcademyStatus` (`academy.types.ts`) exactly.
enum AcademyStatus {
  draft
  active
  suspended
  archived

  @@map("academy_status")
}

/// Matches `AcademyMemberRole` (`academy.types.ts`) exactly — flat string
/// values, not a catalog table (master plan §9: no Role/Permission catalog).
enum AcademyMemberRole {
  owner
  administrator
  manager
  instructor
  staff

  @@map("academy_member_role")
}

/// Matches `AcademyMemberStatus` (`academy.types.ts`) exactly.
enum AcademyMemberStatus {
  active
  inactive
  pending

  @@map("academy_member_status")
}

/// Mirrors `Academy` (`academy.types.ts`) field-for-field. Soft-delete
/// only, matching `Organization`'s own precedent and master plan §5's
/// "no hard delete" convention for this domain — `DELETE
/// /academies/:id` (the frontend's real, defined contract) is implemented
/// as a status transition to `archived`, never a SQL `DELETE`; there is no
/// DELETE RLS policy on this table at all (see migration.sql).
model Academy {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String        @unique
  description    String?
  logoUrl        String?       @map("logo_url")
  faviconUrl     String?       @map("favicon_url")
  status         AcademyStatus @default(draft)
  timezone       String        @default("UTC")
  language       String        @default("en")
  currency       String        @default("USD")
  contactEmail   String?       @map("contact_email")
  contactPhone   String?       @map("contact_phone")
  websiteUrl     String?       @map("website_url")
  /// Mirrors `AcademyAddress` (`street?`, `city?`, `state?`, `postalCode?`,
  /// `country`). Validated server-side (DTO), not schema-enforced —
  /// consistent with `users.preferences`' existing precedent in this file.
  address        Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  members          AcademyMember[]
  courseCategories CourseCategory[]
  courses          Course[]

  @@index([organizationId, status])
  @@map("academies")
}

/// Mirrors `AcademyMember` (`academy.types.ts`) — `name`/`email` are not
/// stored here (the frontend type's own fields for those are resolved via
/// a join to `users` at query time, never duplicated).
model AcademyMember {
  id        String              @id @default(uuid())
  academyId String              @map("academy_id")
  academy   Academy             @relation(fields: [academyId], references: [id], onDelete: Cascade)
  userId    String              @map("user_id")
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AcademyMemberRole
  status    AcademyMemberStatus @default(active)
  joinedAt  DateTime            @default(now()) @map("joined_at")

  @@unique([academyId, userId])
  @@index([academyId])
  @@index([userId])
  @@map("academy_members")
}

// ---------------------------------------------------------------------------
// Phase P4 — Plans, Subscription & Entitlements (master plan §5.6, §21
// Phase P4).
//
// `plans`/`add_ons`/`trial_policy` are PLATFORM-owned catalog/config —
// exactly like `schema_meta` (§0) and `users` (§P1), they carry no
// `organization_id`/`academy_id` and get NO RLS policy: every authenticated
// caller reads the same catalog, matching `PlanService`'s own doc comment
// ("unlike `TenantService` nothing here takes an `organizationId`").
//
// `tenant_subscriptions`/`tenant_add_ons`/`tenant_usage` ARE organization-
// scoped and get RLS in the same migration that creates them, reusing the
// exact P2/P3 `app.current_organization_id` mechanism — no new session
// variable, no second tenant mechanism. See migration.sql for the policies.
// ---------------------------------------------------------------------------

/// Matches `PlanStatus` (`plan.types.ts`) exactly.
enum PlanStatus {
  active
  archived

  @@map("plan_status")
}

/// Matches `TenantSubscriptionStatus` (`tenant.types.ts`) exactly — 7 states.
enum TenantSubscriptionStatus {
  trialing
  active
  past_due
  paused
  grace_period
  cancelled
  expired

  @@map("tenant_subscription_status")
}

/// Matches `SubscriptionBillingCycle` (`money.types.ts`) exactly.
enum SubscriptionBillingCycle {
  monthly
  yearly

  @@map("subscription_billing_cycle")
}

/// Platform-owned catalog entity — mirrors `Plan` (`plan.types.ts`)
/// field-for-field. Not tenant-scoped (see this section's header comment).
model Plan {
  id           String     @id @default(uuid())
  key          String     @unique
  name         String
  description  String?
  status       PlanStatus @default(active)
  displayOrder Int        @default(0) @map("display_order")
  /// Mirrors `PlanResourceLimits` — validated server-side (DTO), not
  /// schema-enforced, matching `users.preferences`'s established precedent
  /// in this file. Each of the 7 `PlanLimitKey` fields is either an `int`
  /// or the literal string `"unlimited"` (`LimitValue`).
  limits       Json
  /// Mirrors `PlanFeatures` — 11 booleans, one per `PlanFeatureKey`.
  features     Json
  /// Mirrors `PlanPricingMetadata`. Display-only — never read by a
  /// checkout/payment flow in this phase (`PlanPricingMetadata`'s own doc
  /// comment: "Prompt 7... owns the real pricing strategy").
  pricing      Json?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  subscriptions TenantSubscription[]

  @@index([status, displayOrder])
  @@map("plans")
}

/// Platform-owned catalog entity — mirrors `AddOn` (`plan.types.ts`).
model AddOn {
  id                 String   @id @default(uuid())
  key                String   @unique
  name               String
  description        String?
  /// Mirrors the `AddOnLimitEffect`/`AddOnFeatureEffect` discriminated
  /// union (`{type: 'limit', limitKey, amount}` or `{type: 'feature',
  /// featureKey}`) — validated server-side, not schema-enforced.
  effect             Json
  compatiblePlanKeys String[] @default([]) @map("compatible_plan_keys")
  pricing            Json?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenantAddOns TenantAddOn[]

  @@map("add_ons")
}

/// Organization-scoped, one subscription per organization (PK = FK) —
/// mirrors `TenantSubscription` (`tenant.types.ts`). No creation endpoint
/// exists in P4 (matches `organizations` itself — real creation is Phase
/// P14 provisioning); test fixtures seed this table via the admin
/// superuser connection, exactly like `organizations`/`academies`.
model TenantSubscription {
  organizationId     String                    @id @map("organization_id")
  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId             String                    @map("plan_id")
  plan               Plan                      @relation(fields: [planId], references: [id])
  status             TenantSubscriptionStatus  @default(trialing)
  /// Present only while `status` is `'trialing'` — not schema-enforced
  /// (mirrors the frontend type's own comment), validated at the service
  /// layer where meaningful.
  trialEndsAt        DateTime?                 @map("trial_ends_at")
  /// Present only while `status` is `'grace_period'`.
  graceEndsAt        DateTime?                 @map("grace_ends_at")
  currentPeriodStart DateTime?                 @map("current_period_start")
  currentPeriodEnd   DateTime?                 @map("current_period_end")
  cancelAtPeriodEnd  Boolean                   @default(false) @map("cancel_at_period_end")
  /// Nullable — "a subscription can exist before any real Checkout ever
  /// set one" (`TenantSubscription.billingCycle`'s own doc comment).
  billingCycle       SubscriptionBillingCycle? @map("billing_cycle")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  @@index([planId])
  @@map("tenant_subscriptions")
}

/// Organization-scoped — mirrors `TenantAddOn` (`tenant.types.ts`). No
/// activation endpoint exists in P4 (no payment provider) — same
/// no-creation-endpoint precedent as `TenantSubscription` above.
model TenantAddOn {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  addOnId        String       @map("add_on_id")
  addOn          AddOn        @relation(fields: [addOnId], references: [id])
  activatedAt    DateTime     @default(now()) @map("activated_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([organizationId, addOnId])
  @@index([organizationId])
  @@map("tenant_add_ons")
}

/// Organization-scoped, one row per organization (PK = FK) — a computed/
/// cached representation, refreshed by the `tenant-usage-recompute` worker
/// (§12), never computed live on a dashboard read (master plan §5.6).
/// Stores only raw `used` counts per `UsageMetric` — the paired `limit`
/// each `UsageMetric` also carries in the API response is derived at read
/// time from the organization's effective entitlements
/// (`EntitlementService`), never persisted here (it would immediately go
/// stale the moment a plan/add-on changed).
model TenantUsage {
  organizationId   String       @id @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academies        Int          @default(0)
  students         Int          @default(0)
  instructors      Int          @default(0)
  staff            Int          @default(0)
  courses          Int          @default(0)
  /// GB.
  generalStorageGb Int          @default(0) @map("general_storage_gb")
  /// GB — tracked separately from general storage.
  videoStorageGb   Int          @default(0) @map("video_storage_gb")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@map("tenant_usage")
}

/// Platform-owned singleton — mirrors `TrialPolicy` (`plan.types.ts`).
/// Exactly one logical row ever exists; enforced at the service layer
/// (there is no natural single-row DB constraint for a Prisma model with a
/// generated `id`, so `TrialPolicyRepository` always reads/writes the one
/// earliest-created row rather than trusting a hardcoded id).
model TrialPolicy {
  id           String   @id @default(uuid())
  enabled      Boolean  @default(true)
  durationDays Int      @default(7) @map("duration_days")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("trial_policy")
}

// ---------------------------------------------------------------------------
// Phase P5 — Course Management (master plan §5.3, §21 Phase P5).
//
// Course is Academy-scoped — tenant ownership resolves transitively
// (`course → academy_id → academies.organization_id`), reusing the exact
// P3 mechanism (`academies_org_member_select`-style bootstrap +
// `runInTenantContext`). No `app.current_academy_id`, no second tenant
// mechanism. See migration.sql for the RLS policies.
//
// Scope boundary confirmed against the actual frontend contract before
// writing this schema (Backend Prompt 6 §1's "inspect first" rule):
// `CourseService` (atlas frontend) has NO write method for either course
// categories or course instructors — `getCourseCategories`/
// `getCourseCategory` are its only category methods, and
// `Course.instructors` (`CourseInstructorSummary[]`) is a read-only
// projection with no assignment/removal endpoint anywhere in the
// frontend (confirmed by a full repo-wide grep, not assumed). Both tables
// below exist (master plan §5.3 requires them, and `Course.instructors`
// needs a real source), but carry NO write endpoint in P5 — mirrors the
// exact precedent already established twice in this codebase
// (`organizations` in P2, `tenant_subscriptions` in P4: table exists, RLS
// is real, but creation happens outside the request/response cycle until
// a later phase adds the real capability). Product-confirmed 2026-08-24.
// `discoverCourses`/`discoverCourse` (the flat, cross-academy, session-
// scoped course catalog) are also out of P5's scope — `course.types.ts`'s
// own doc comment ("student consumption... [is a] separate, future
// module") and the frontend's own separate `courseDiscoveryKeys` query-key
// tree both confirm this is Student Learning (P6) scope, not authoring.
// ---------------------------------------------------------------------------

/// Matches `CourseStatus` (`course.types.ts`) exactly. `archived` is the
/// soft-delete terminal state — `DELETE /academies/:id/courses/:id`
/// (the frontend's real, defined contract) is implemented as a status
/// transition, never a SQL `DELETE`, matching `Academy`'s own precedent;
/// there is no DELETE RLS policy on `courses` at all.
enum CourseStatus {
  draft
  published
  archived

  @@map("course_status")
}

/// Matches `CourseVisibility` (`course.types.ts`) exactly.
enum CourseVisibility {
  public
  private

  @@map("course_visibility")
}

/// Matches `CoursePricingType` (`course.types.ts`) exactly.
enum CoursePricingType {
  free
  paid

  @@map("course_pricing_type")
}

/// Matches `CourseLessonContentType` (`course.types.ts`) exactly.
enum CourseLessonContentType {
  text
  video
  file

  @@map("course_lesson_content_type")
}

/// Matches `CourseLessonStatus` (`course.types.ts`) exactly — deliberately
/// only `draft`/`published`, no `archived` (the frontend type has none):
/// unlike `Course`, a lesson has no soft-delete state machine, so
/// `DELETE .../lessons/:id` is a real SQL DELETE (see migration.sql).
/// Same reasoning applies to `CourseSection`, which carries no `status`
/// column at all.
enum CourseLessonStatus {
  draft
  published

  @@map("course_lesson_status")
}

/// Mirrors `CourseCategory` (`course.types.ts`) field-for-field.
/// Academy-scoped (master plan §5.3's explicit FK). Read-only in P5 — see
/// this section's header comment.
model CourseCategory {
  id          String   @id @default(uuid())
  academyId   String   @map("academy_id")
  academy     Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  courses Course[]

  @@unique([academyId, slug])
  @@index([academyId])
  @@map("course_categories")
}

/// Mirrors `Course` (`course.types.ts`) field-for-field.
///
/// Pricing bridge: the frontend's `CoursePricing.amount` is a plain
/// decimal number (e.g. `29.99`, matching what the create/edit form
/// collects via `pricingAmount: z.coerce.number()`) — NOT the `Money`/
/// `amountMinorUnits` shape `money.types.ts` defines for the real
/// Checkout/Payment/Invoice commercial contract (Prompt 7/P12-13).
/// Master plan §5.3 still specifies `pricing_amount_minor_units bigint`
/// for this table — the established "money is always a minor-unit
/// integer at rest, never a float" convention — so the DB column stores
/// integer cents and the response/request DTOs (`course.contract.ts`)
/// convert to/from the frontend's plain decimal number. This avoids
/// floating-point money bugs at rest while exposing exactly the shape
/// `CoursePricing` already defines; no new field or endpoint invented.
model Course {
  id                      String            @id @default(uuid())
  academyId               String            @map("academy_id")
  academy                 Academy           @relation(fields: [academyId], references: [id], onDelete: Cascade)
  categoryId              String?           @map("category_id")
  category                CourseCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title                   String
  slug                    String
  description             String?
  shortDescription        String?           @map("short_description")
  thumbnailUrl            String?           @map("thumbnail_url")
  status                  CourseStatus      @default(draft)
  visibility              CourseVisibility  @default(private)
  pricingType             CoursePricingType @default(free) @map("pricing_type")
  pricingAmountMinorUnits BigInt?           @map("pricing_amount_minor_units")
  pricingCurrency         String?           @map("pricing_currency")
  publishedAt             DateTime?         @map("published_at")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  sections    CourseSection[]
  instructors CourseInstructor[]

  @@unique([academyId, slug])
  @@index([academyId, status, visibility])
  @@index([status, visibility])
  @@map("courses")
}

/// Join table — mirrors master plan §5.3's `course_instructors` exactly
/// ("the server-side source of truth for 'which courses can this
/// instructor teach,' resolved fresh on every request, never client-
/// trusted"). Read-only in P5 (projected into `Course.instructors`) — see
/// this section's header comment; real assignment is a future phase
/// (InstructorService, P7) once the frontend defines one.
model CourseInstructor {
  courseId   String   @map("course_id")
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([courseId, userId])
  @@index([userId])
  @@map("course_instructors")
}

/// Mirrors `CourseSection` (`course.types.ts`) — `lessons` are returned
/// nested (the frontend type embeds them directly), never paginated
/// separately. No `status` column — sections have no soft-delete state
/// machine, so `DELETE .../sections/:id` is a real SQL DELETE, cascading
/// to its lessons (matches `CourseService.deleteCourseSection`'s own doc
/// comment: "Deletes a course section and its lessons").
model CourseSection {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lessons CourseLesson[]

  @@index([courseId, order])
  @@map("course_sections")
}

/// Mirrors `CourseLesson` (`course.types.ts`). `courseId` is denormalized
/// (master plan §5.3: "for direct scoping without a join") — kept in sync
/// with the parent section's `courseId` at creation time, never updated
/// afterward (a lesson never moves to a different course). No `archived`
/// status (see `CourseLessonStatus`'s doc comment) — `DELETE
/// .../lessons/:id` is a real SQL DELETE.
model CourseLesson {
  id          String                  @id @default(uuid())
  sectionId   String                  @map("section_id")
  section     CourseSection           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  courseId    String                  @map("course_id")
  title       String
  description String?
  order       Int
  contentType CourseLessonContentType @map("content_type")
  contentUrl  String?                 @map("content_url")
  status      CourseLessonStatus      @default(draft)
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  @@index([sectionId, order])
  @@map("course_lessons")
}
