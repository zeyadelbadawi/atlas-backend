// Atlas Backend — Prisma schema.
//
// Phase P0 (Foundation) scope only. Per Reports/ATLAS_BACKEND_MASTER_PLAN.md
// §21's Phase P0 entry: "Database changes: none domain-specific — migration
// tooling proven with one trivial migration (e.g. a `schema_meta` table) to
// confirm the pipeline works."
//
// No business/domain tables (users, organizations, academies, courses, ...)
// are defined here. They begin in Phase P1 onward, each phase extending this
// file with its own models — see the master plan's §5 for the full,
// eventual schema this file grows into. Do not add a table here that a
// later phase owns; this file's only job right now is to prove the
// migration pipeline is real, not to anticipate future schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Proves the migration pipeline end-to-end (create, apply, and read back a
/// real table) without modeling any business domain. Intentionally the only
/// model in this phase. Not tenant-scoped — this is platform-infrastructure
/// metadata (e.g. a schema version marker), not tenant data, so it
/// deliberately carries no `organization_id`/`academy_id` and needs no RLS
/// policy (see the master plan §7's tenant-scoping rule, which applies to
/// domain tables, not this one).
model SchemaMeta {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("schema_meta")
}

// ---------------------------------------------------------------------------
// Phase P1 — Identity, Auth & Sessions (master plan §5.1, §21 Phase P1).
//
// Platform-scoped, not tenant-scoped: a user is not owned by one
// organization (that relationship — `organization_memberships` — is Phase
// P2's job). No RLS policy applies here for the same reason §7 exempts
// `schema_meta`: these tables carry no `organization_id`/`academy_id`.
// ---------------------------------------------------------------------------

/// Matches `PlatformUserAccountStatus`/`CurrentUser` exactly. Deliberately
/// only these three values — do not add `locked`/`pending_verification`
/// states; both email verification and account lockout are explicitly
/// `SPECIFICATION-UNDEFINED` per master plan §8/§24 and must not be built
/// into the schema ahead of a product decision.
enum UserAccountStatus {
  active
  invited
  suspended

  @@map("user_account_status")
}

/// One account per human — mirrors `CurrentUser` (master plan §5.1).
///
/// Email case-insensitivity note: the master plan suggests Postgres
/// `citext`, but Prisma has no first-class `citext` column type (it can
/// only be modeled via `Unsupported("citext")`, which the Prisma Client
/// cannot use in ordinary `where`/`create` calls — every lookup would need
/// hand-written raw SQL, which is inconsistent with every other table in
/// this codebase using the Client normally). Case-insensitivity is instead
/// enforced at the application layer: every write and lookup normalizes
/// email via `.trim().toLowerCase()` before it ever reaches Prisma
/// (`identity/utils/email.util.ts`), so the plain `@unique` constraint below
/// still guarantees one account per email regardless of the case a user
/// types it in.
model User {
  id              String            @id @default(uuid())
  email           String            @unique
  passwordHash    String            @map("password_hash")
  name            String
  avatarUrl       String?           @map("avatar_url")
  isPlatformOwner Boolean           @default(false) @map("is_platform_owner")
  /// Mirrors `UserPreferences` (`theme?`, `language?`, `notifications?`).
  /// Validated server-side (not schema-enforced) — see `PreferencesService`.
  preferences     Json              @default("{}")
  status          UserAccountStatus @default(active)
  lastSignInAt    DateTime?         @map("last_sign_in_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  ownedOrganizations      Organization[]           @relation("OrganizationOwner")
  organizationMemberships OrganizationMembership[]
  academyMemberships      AcademyMember[]
  courseInstructorships   CourseInstructor[]
  enrollments             Enrollment[]
  quizAttempts            QuizAttempt[]
  assignmentSubmissions   AssignmentSubmission[]   @relation("SubmissionStudent")
  gradedSubmissions       AssignmentSubmission[]   @relation("SubmissionGrader")
  announcements           Announcement[]
  blogPosts               BlogPost[]
  forumThreads            ForumThread[]
  forumReplies            ForumReply[]

  @@index([status])
  @@map("users")
}

/// Rotating session tokens backing `TokenMetadata.refreshToken`. Only the
/// SHA-256 hash of the raw token is ever persisted — a database leak alone
/// never yields a usable token (master plan §5.1, §8, §16).
model RefreshToken {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @map("token_hash")
  deviceLabel String?   @map("device_label")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

/// Backs `PasswordResetRequest`/`PasswordResetConfirmation`. Single-use,
/// short-lived, hashed at rest — same rationale as `RefreshToken`.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Phase P2 — Organizations, Membership & Multi-Tenancy Core (master plan
// §5.2, §7, §21 Phase P2).
//
// `organizations` is the tenant root. Every tenant-scoped table from this
// phase forward carries `organization_id` as a real FK column (§5's
// universal convention) and gets an RLS policy created in the SAME
// migration that creates it (§17) — see migration.sql for the
// `ENABLE ROW LEVEL SECURITY` / `FORCE ROW LEVEL SECURITY` / `CREATE
// POLICY` statements; Prisma's schema language has no RLS syntax, so those
// are appended by hand to the generated migration, not expressed here.
// ---------------------------------------------------------------------------

/// Matches `Organization`'s status union (mirrored from
/// `PlatformOrganizationSummary`/`Detail` — there is no standalone bare
/// `Organization` type in the frontend today; this enum's values are taken
/// directly from the master plan §5.2 definition, which all
/// organization-shaped frontend types agree with).
enum OrganizationStatus {
  active
  suspended
  archived

  @@map("organization_status")
}

/// The SaaS tenant boundary — the root of the tenant hierarchy (master plan
/// §7). Soft-delete only: no delete endpoint exists or is planned for this
/// table; `status` is the only lifecycle mechanism.
model Organization {
  id          String             @id @default(uuid())
  name        String
  slug        String             @unique
  status      OrganizationStatus @default(active)
  ownerUserId String             @map("owner_user_id")
  owner       User               @relation("OrganizationOwner", fields: [ownerUserId], references: [id])
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  memberships  OrganizationMembership[]
  academies    Academy[]
  subscription TenantSubscription?
  addOns       TenantAddOn[]
  usage        TenantUsage?

  @@index([status])
  @@map("organizations")
}

/// Join table between `users` and `organizations` — mirrors
/// `OrganizationMembership` (`identity.types.ts`) field-for-field. `role`
/// stays a flat string and `permissions` a flat string array by deliberate
/// design (master plan §9): there is no Role/Permission catalog table, and
/// P2 must not introduce one.
model OrganizationMembership {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  permissions    String[]     @default([])
  isPrimary      Boolean      @default(false) @map("is_primary")
  joinedAt       DateTime     @default(now()) @map("joined_at")

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_memberships")
}

// ---------------------------------------------------------------------------
// Phase P3 — Academy Management (master plan §5.2, §21 Phase P3).
//
// Academy is the second-level tenant scope, belonging to exactly one
// Organization. RLS resolves tenant ownership transitively through
// `organization_id`/`academy_id` — no new session variable, no parallel
// tenant mechanism; the same `app.current_organization_id`/
// `app.current_user_id` variables P2 established are reused. See
// migration.sql for the policies (Prisma's schema language has no RLS
// syntax).
// ---------------------------------------------------------------------------

/// Matches `AcademyStatus` (`academy.types.ts`) exactly.
enum AcademyStatus {
  draft
  active
  suspended
  archived

  @@map("academy_status")
}

/// Matches `AcademyMemberRole` (`academy.types.ts`) exactly — flat string
/// values, not a catalog table (master plan §9: no Role/Permission catalog).
enum AcademyMemberRole {
  owner
  administrator
  manager
  instructor
  staff

  @@map("academy_member_role")
}

/// Matches `AcademyMemberStatus` (`academy.types.ts`) exactly.
enum AcademyMemberStatus {
  active
  inactive
  pending

  @@map("academy_member_status")
}

/// Mirrors `Academy` (`academy.types.ts`) field-for-field. Soft-delete
/// only, matching `Organization`'s own precedent and master plan §5's
/// "no hard delete" convention for this domain — `DELETE
/// /academies/:id` (the frontend's real, defined contract) is implemented
/// as a status transition to `archived`, never a SQL `DELETE`; there is no
/// DELETE RLS policy on this table at all (see migration.sql).
model Academy {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String        @unique
  description    String?
  logoUrl        String?       @map("logo_url")
  faviconUrl     String?       @map("favicon_url")
  status         AcademyStatus @default(draft)
  timezone       String        @default("UTC")
  language       String        @default("en")
  currency       String        @default("USD")
  contactEmail   String?       @map("contact_email")
  contactPhone   String?       @map("contact_phone")
  websiteUrl     String?       @map("website_url")
  /// Mirrors `AcademyAddress` (`street?`, `city?`, `state?`, `postalCode?`,
  /// `country`). Validated server-side (DTO), not schema-enforced —
  /// consistent with `users.preferences`' existing precedent in this file.
  address        Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  members              AcademyMember[]
  courseCategories     CourseCategory[]
  courses              Course[]
  announcements        Announcement[]
  blogPosts            BlogPost[]
  mediaAssets          MediaAsset[]
  websiteConfiguration WebsiteConfiguration?
  websitePages         WebsitePage[]
  websiteFaqEntries    WebsiteFaqEntry[]
  websiteTestimonials  WebsiteTestimonialEntry[]
  subdomainAllocation  SubdomainAllocation?
  domainConnection     DomainConnection?

  @@index([organizationId, status])
  @@map("academies")
}

/// Mirrors `AcademyMember` (`academy.types.ts`) — `name`/`email` are not
/// stored here (the frontend type's own fields for those are resolved via
/// a join to `users` at query time, never duplicated).
model AcademyMember {
  id        String              @id @default(uuid())
  academyId String              @map("academy_id")
  academy   Academy             @relation(fields: [academyId], references: [id], onDelete: Cascade)
  userId    String              @map("user_id")
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AcademyMemberRole
  status    AcademyMemberStatus @default(active)
  joinedAt  DateTime            @default(now()) @map("joined_at")

  @@unique([academyId, userId])
  @@index([academyId])
  @@index([userId])
  @@map("academy_members")
}

// ---------------------------------------------------------------------------
// Phase P4 — Plans, Subscription & Entitlements (master plan §5.6, §21
// Phase P4).
//
// `plans`/`add_ons`/`trial_policy` are PLATFORM-owned catalog/config —
// exactly like `schema_meta` (§0) and `users` (§P1), they carry no
// `organization_id`/`academy_id` and get NO RLS policy: every authenticated
// caller reads the same catalog, matching `PlanService`'s own doc comment
// ("unlike `TenantService` nothing here takes an `organizationId`").
//
// `tenant_subscriptions`/`tenant_add_ons`/`tenant_usage` ARE organization-
// scoped and get RLS in the same migration that creates them, reusing the
// exact P2/P3 `app.current_organization_id` mechanism — no new session
// variable, no second tenant mechanism. See migration.sql for the policies.
// ---------------------------------------------------------------------------

/// Matches `PlanStatus` (`plan.types.ts`) exactly.
enum PlanStatus {
  active
  archived

  @@map("plan_status")
}

/// Matches `TenantSubscriptionStatus` (`tenant.types.ts`) exactly — 7 states.
enum TenantSubscriptionStatus {
  trialing
  active
  past_due
  paused
  grace_period
  cancelled
  expired

  @@map("tenant_subscription_status")
}

/// Matches `SubscriptionBillingCycle` (`money.types.ts`) exactly.
enum SubscriptionBillingCycle {
  monthly
  yearly

  @@map("subscription_billing_cycle")
}

/// Platform-owned catalog entity — mirrors `Plan` (`plan.types.ts`)
/// field-for-field. Not tenant-scoped (see this section's header comment).
model Plan {
  id           String     @id @default(uuid())
  key          String     @unique
  name         String
  description  String?
  status       PlanStatus @default(active)
  displayOrder Int        @default(0) @map("display_order")
  /// Mirrors `PlanResourceLimits` — validated server-side (DTO), not
  /// schema-enforced, matching `users.preferences`'s established precedent
  /// in this file. Each of the 7 `PlanLimitKey` fields is either an `int`
  /// or the literal string `"unlimited"` (`LimitValue`).
  limits       Json
  /// Mirrors `PlanFeatures` — 11 booleans, one per `PlanFeatureKey`.
  features     Json
  /// Mirrors `PlanPricingMetadata`. Display-only — never read by a
  /// checkout/payment flow in this phase (`PlanPricingMetadata`'s own doc
  /// comment: "Prompt 7... owns the real pricing strategy").
  pricing      Json?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  subscriptions TenantSubscription[]

  @@index([status, displayOrder])
  @@map("plans")
}

/// Platform-owned catalog entity — mirrors `AddOn` (`plan.types.ts`).
model AddOn {
  id                 String   @id @default(uuid())
  key                String   @unique
  name               String
  description        String?
  /// Mirrors the `AddOnLimitEffect`/`AddOnFeatureEffect` discriminated
  /// union (`{type: 'limit', limitKey, amount}` or `{type: 'feature',
  /// featureKey}`) — validated server-side, not schema-enforced.
  effect             Json
  compatiblePlanKeys String[] @default([]) @map("compatible_plan_keys")
  pricing            Json?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenantAddOns TenantAddOn[]

  @@map("add_ons")
}

/// Organization-scoped, one subscription per organization (PK = FK) —
/// mirrors `TenantSubscription` (`tenant.types.ts`). No creation endpoint
/// exists in P4 (matches `organizations` itself — real creation is Phase
/// P14 provisioning); test fixtures seed this table via the admin
/// superuser connection, exactly like `organizations`/`academies`.
model TenantSubscription {
  organizationId     String                    @id @map("organization_id")
  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId             String                    @map("plan_id")
  plan               Plan                      @relation(fields: [planId], references: [id])
  status             TenantSubscriptionStatus  @default(trialing)
  /// Present only while `status` is `'trialing'` — not schema-enforced
  /// (mirrors the frontend type's own comment), validated at the service
  /// layer where meaningful.
  trialEndsAt        DateTime?                 @map("trial_ends_at")
  /// Present only while `status` is `'grace_period'`.
  graceEndsAt        DateTime?                 @map("grace_ends_at")
  currentPeriodStart DateTime?                 @map("current_period_start")
  currentPeriodEnd   DateTime?                 @map("current_period_end")
  cancelAtPeriodEnd  Boolean                   @default(false) @map("cancel_at_period_end")
  /// Nullable — "a subscription can exist before any real Checkout ever
  /// set one" (`TenantSubscription.billingCycle`'s own doc comment).
  billingCycle       SubscriptionBillingCycle? @map("billing_cycle")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  @@index([planId])
  @@map("tenant_subscriptions")
}

/// Organization-scoped — mirrors `TenantAddOn` (`tenant.types.ts`). No
/// activation endpoint exists in P4 (no payment provider) — same
/// no-creation-endpoint precedent as `TenantSubscription` above.
model TenantAddOn {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  addOnId        String       @map("add_on_id")
  addOn          AddOn        @relation(fields: [addOnId], references: [id])
  activatedAt    DateTime     @default(now()) @map("activated_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([organizationId, addOnId])
  @@index([organizationId])
  @@map("tenant_add_ons")
}

/// Organization-scoped, one row per organization (PK = FK) — a computed/
/// cached representation, refreshed by the `tenant-usage-recompute` worker
/// (§12), never computed live on a dashboard read (master plan §5.6).
/// Stores only raw `used` counts per `UsageMetric` — the paired `limit`
/// each `UsageMetric` also carries in the API response is derived at read
/// time from the organization's effective entitlements
/// (`EntitlementService`), never persisted here (it would immediately go
/// stale the moment a plan/add-on changed).
model TenantUsage {
  organizationId   String       @id @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academies        Int          @default(0)
  students         Int          @default(0)
  instructors      Int          @default(0)
  staff            Int          @default(0)
  courses          Int          @default(0)
  /// GB.
  generalStorageGb Int          @default(0) @map("general_storage_gb")
  /// GB — tracked separately from general storage.
  videoStorageGb   Int          @default(0) @map("video_storage_gb")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@map("tenant_usage")
}

/// Platform-owned singleton — mirrors `TrialPolicy` (`plan.types.ts`).
/// Exactly one logical row ever exists; enforced at the service layer
/// (there is no natural single-row DB constraint for a Prisma model with a
/// generated `id`, so `TrialPolicyRepository` always reads/writes the one
/// earliest-created row rather than trusting a hardcoded id).
model TrialPolicy {
  id           String   @id @default(uuid())
  enabled      Boolean  @default(true)
  durationDays Int      @default(7) @map("duration_days")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("trial_policy")
}

// ---------------------------------------------------------------------------
// Phase P5 — Course Management (master plan §5.3, §21 Phase P5).
//
// Course is Academy-scoped — tenant ownership resolves transitively
// (`course → academy_id → academies.organization_id`), reusing the exact
// P3 mechanism (`academies_org_member_select`-style bootstrap +
// `runInTenantContext`). No `app.current_academy_id`, no second tenant
// mechanism. See migration.sql for the RLS policies.
//
// Scope boundary confirmed against the actual frontend contract before
// writing this schema (Backend Prompt 6 §1's "inspect first" rule):
// `CourseService` (atlas frontend) has NO write method for either course
// categories or course instructors — `getCourseCategories`/
// `getCourseCategory` are its only category methods, and
// `Course.instructors` (`CourseInstructorSummary[]`) is a read-only
// projection with no assignment/removal endpoint anywhere in the
// frontend (confirmed by a full repo-wide grep, not assumed). Both tables
// below exist (master plan §5.3 requires them, and `Course.instructors`
// needs a real source), but carry NO write endpoint in P5 — mirrors the
// exact precedent already established twice in this codebase
// (`organizations` in P2, `tenant_subscriptions` in P4: table exists, RLS
// is real, but creation happens outside the request/response cycle until
// a later phase adds the real capability). Product-confirmed 2026-08-24.
// `discoverCourses`/`discoverCourse` (the flat, cross-academy, session-
// scoped course catalog) are also out of P5's scope — `course.types.ts`'s
// own doc comment ("student consumption... [is a] separate, future
// module") and the frontend's own separate `courseDiscoveryKeys` query-key
// tree both confirm this is Student Learning (P6) scope, not authoring.
// ---------------------------------------------------------------------------

/// Matches `CourseStatus` (`course.types.ts`) exactly. `archived` is the
/// soft-delete terminal state — `DELETE /academies/:id/courses/:id`
/// (the frontend's real, defined contract) is implemented as a status
/// transition, never a SQL `DELETE`, matching `Academy`'s own precedent;
/// there is no DELETE RLS policy on `courses` at all.
enum CourseStatus {
  draft
  published
  archived

  @@map("course_status")
}

/// Matches `CourseVisibility` (`course.types.ts`) exactly.
enum CourseVisibility {
  public
  private

  @@map("course_visibility")
}

/// Matches `CoursePricingType` (`course.types.ts`) exactly.
enum CoursePricingType {
  free
  paid

  @@map("course_pricing_type")
}

/// Matches `CourseLessonContentType` (`course.types.ts`) exactly.
enum CourseLessonContentType {
  text
  video
  file

  @@map("course_lesson_content_type")
}

/// Matches `CourseLessonStatus` (`course.types.ts`) exactly — deliberately
/// only `draft`/`published`, no `archived` (the frontend type has none):
/// unlike `Course`, a lesson has no soft-delete state machine, so
/// `DELETE .../lessons/:id` is a real SQL DELETE (see migration.sql).
/// Same reasoning applies to `CourseSection`, which carries no `status`
/// column at all.
enum CourseLessonStatus {
  draft
  published

  @@map("course_lesson_status")
}

/// Mirrors `CourseCategory` (`course.types.ts`) field-for-field.
/// Academy-scoped (master plan §5.3's explicit FK). Read-only in P5 — see
/// this section's header comment.
model CourseCategory {
  id          String   @id @default(uuid())
  academyId   String   @map("academy_id")
  academy     Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  courses Course[]

  @@unique([academyId, slug])
  @@index([academyId])
  @@map("course_categories")
}

/// Mirrors `Course` (`course.types.ts`) field-for-field.
///
/// Pricing bridge: the frontend's `CoursePricing.amount` is a plain
/// decimal number (e.g. `29.99`, matching what the create/edit form
/// collects via `pricingAmount: z.coerce.number()`) — NOT the `Money`/
/// `amountMinorUnits` shape `money.types.ts` defines for the real
/// Checkout/Payment/Invoice commercial contract (Prompt 7/P12-13).
/// Master plan §5.3 still specifies `pricing_amount_minor_units bigint`
/// for this table — the established "money is always a minor-unit
/// integer at rest, never a float" convention — so the DB column stores
/// integer cents and the response/request DTOs (`course.contract.ts`)
/// convert to/from the frontend's plain decimal number. This avoids
/// floating-point money bugs at rest while exposing exactly the shape
/// `CoursePricing` already defines; no new field or endpoint invented.
model Course {
  id                      String            @id @default(uuid())
  academyId               String            @map("academy_id")
  academy                 Academy           @relation(fields: [academyId], references: [id], onDelete: Cascade)
  categoryId              String?           @map("category_id")
  category                CourseCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title                   String
  slug                    String
  description             String?
  shortDescription        String?           @map("short_description")
  thumbnailUrl            String?           @map("thumbnail_url")
  status                  CourseStatus      @default(draft)
  visibility              CourseVisibility  @default(private)
  pricingType             CoursePricingType @default(free) @map("pricing_type")
  pricingAmountMinorUnits BigInt?           @map("pricing_amount_minor_units")
  pricingCurrency         String?           @map("pricing_currency")
  publishedAt             DateTime?         @map("published_at")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  sections      CourseSection[]
  instructors   CourseInstructor[]
  enrollments   Enrollment[]
  quizzes       Quiz[]
  assignments   Assignment[]
  announcements Announcement[]
  forum         Forum?

  @@unique([academyId, slug])
  @@index([academyId, status, visibility])
  @@index([status, visibility])
  @@map("courses")
}

/// Join table — mirrors master plan §5.3's `course_instructors` exactly
/// ("the server-side source of truth for 'which courses can this
/// instructor teach,' resolved fresh on every request, never client-
/// trusted"). Read-only in P5 (projected into `Course.instructors`) — see
/// this section's header comment; real assignment is a future phase
/// (InstructorService, P7) once the frontend defines one.
model CourseInstructor {
  courseId   String   @map("course_id")
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([courseId, userId])
  @@index([userId])
  @@map("course_instructors")
}

/// Mirrors `CourseSection` (`course.types.ts`) — `lessons` are returned
/// nested (the frontend type embeds them directly), never paginated
/// separately. No `status` column — sections have no soft-delete state
/// machine, so `DELETE .../sections/:id` is a real SQL DELETE, cascading
/// to its lessons (matches `CourseService.deleteCourseSection`'s own doc
/// comment: "Deletes a course section and its lessons").
model CourseSection {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lessons CourseLesson[]

  @@index([courseId, order])
  @@map("course_sections")
}

/// Mirrors `CourseLesson` (`course.types.ts`). `courseId` is denormalized
/// (master plan §5.3: "for direct scoping without a join") — kept in sync
/// with the parent section's `courseId` at creation time, never updated
/// afterward (a lesson never moves to a different course). No `archived`
/// status (see `CourseLessonStatus`'s doc comment) — `DELETE
/// .../lessons/:id` is a real SQL DELETE.
model CourseLesson {
  id          String                  @id @default(uuid())
  sectionId   String                  @map("section_id")
  section     CourseSection           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  courseId    String                  @map("course_id")
  title       String
  description String?
  order       Int
  contentType CourseLessonContentType @map("content_type")
  contentUrl  String?                 @map("content_url")
  status      CourseLessonStatus      @default(draft)
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  lessonProgress LessonProgress[]

  @@index([sectionId, order])
  @@map("course_lessons")
}

// ---------------------------------------------------------------------------
// Phase P6 — Student Learning & Assessment (master plan §5.3/§5.4, §21
// Phase P6).
//
// Every table here is USER-owned, not organization/academy-owned (master
// plan §7's resource-ownership table: "Owned by User: ... own Enrollments,
// own Quiz Attempts/Submissions"). Tenant resolution reuses
// `TenancyContextService.runInUserContext` verbatim — the exact
// `app.current_user_id` session variable P2 already introduced for
// `CurrentUser.organizations`, extended here to a second legitimate
// use: a student is never an `organization_memberships`/`academy_members`
// row, so the existing `app.current_organization_id` mechanism structurally
// cannot express "this row belongs to the signed-in student." No new
// session variable, no new tenancy model — see migration.sql for the RLS
// policies built on this.
//
// `quizzes`/`quiz_questions`/`quiz_question_options`/`assignments` carry NO
// write endpoint in P6 — confirmed against the actual frontend contract
// before writing this schema: `QuizService`/`AssignmentService` (atlas
// frontend) are read-only for these four, by their own file-header comments
// ("Quiz authoring is out of scope" / "Assignment authoring and grading
// workflows are out of scope"). Mirrors the exact precedent already
// established for `course_categories`/`course_instructors` in P5: table +
// RLS real, populated only via seed/admin-only inserts, no write endpoint
// until a later phase defines one (Instructor Operations, P7, for grading;
// no phase yet owns authoring).
//
// `discoverCourses`/`discoverCourse` (the flat, cross-academy, published-
// only course catalog) is P6 scope — see this file's own P5 section header,
// which already deferred it here. Reading a published+public `courses` row
// (plus its `course_categories`/`course_instructors` projections) does not
// fit the existing academy-membership-scoped `courses_tenant_select`
// policy — a student is never an organization member of the academy that
// owns the course. Migration.sql adds narrow, ADDITIVE SELECT policies
// (`courses.status = 'published' AND courses.visibility = 'public'`, no
// session-context dependency) alongside the existing academy-staff
// policies — Postgres OR's multiple SELECT policies together, so this
// never weakens or replaces P5's own tenant-scoped policy, it only adds a
// second, legitimate, narrow read path. The `(status, visibility)` index on
// `courses` (P5) was already declared "for the flat cross-academy
// discoverCourses endpoint" — this is that endpoint, arriving on schedule.
//
// Enrollment is free-course-only in P6, by explicit master plan instruction
// ("no payment gate on enrollment yet ... free-course behavior is fully
// buildable now, paid-course gating lands in P13"). `EnrollmentsService`
// rejects a paid course's enrollment attempt outright (403) rather than
// granting free access to paid content or inventing a partial payment gate
// — no course-purchase flow exists to gate on yet.
//
// `assignment_submissions` deliberately has NO `assignment_submission_
// history` table — master plan §5.4 itself says this table is only added
// "when Phase 6 discovers resubmission history is actually needed for
// grading UX; not built speculatively now." It wasn't discovered to be
// needed: `AssignmentSubmission` (frontend) carries no history field, and
// the one write endpoint (`submitAssignment`) is a single create-or-replace
// call. `(assignment_id, student_id)` stays unconditionally unique; a
// resubmission updates that same row in place when
// `assignments.allow_resubmission` is true, and is rejected with 409 when
// it is false — "keep the latest row" exactly as instructed, no history
// table invented.
// ---------------------------------------------------------------------------

/// Mirrors `Enrollment` (`enrollment.types.ts`) exactly. `academyId` is
/// denormalized from `course.academy_id` at creation time — same "no join
/// needed on the student-facing path" reasoning as `CourseLesson.courseId`
/// (P5) — never updated afterward, never a real FK relation object (matches
/// that precedent's plain-column shape).
model Enrollment {
  id          String           @id @default(uuid())
  studentId   String           @map("student_id")
  student     User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId    String           @map("course_id")
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academyId   String           @map("academy_id")
  status      EnrollmentStatus
  enrolledAt  DateTime?        @map("enrolled_at")
  completedAt DateTime?        @map("completed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  progress       CourseProgress?
  LessonProgress LessonProgress[]

  @@unique([studentId, courseId])
  @@index([studentId, status])
  @@map("enrollments")
}

enum EnrollmentStatus {
  available
  pending
  enrolled
  completed
  unavailable

  @@map("enrollment_status")
}

/// Mirrors `CourseProgress` (`progress.types.ts`) — a materialized summary
/// row per enrollment, updated transactionally within the same request that
/// changes it (lesson completed), never lazily derived on read (master plan
/// §5.3's explicit instruction for this table).
model CourseProgress {
  enrollmentId      String                @id @map("enrollment_id")
  enrollment        Enrollment            @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  totalLessons      Int                   @map("total_lessons")
  completedLessons  Int                   @default(0) @map("completed_lessons")
  percentage        Decimal               @default(0) @db.Decimal(5, 2)
  currentLessonId   String?               @map("current_lesson_id")
  completionState   CourseCompletionState @default(incomplete) @map("completion_state")
  certificateStatus CertificateStatus     @default(unavailable) @map("certificate_status")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@map("course_progress")
}

enum CourseCompletionState {
  incomplete
  in_progress
  completed

  @@map("course_completion_state")
}

enum CertificateStatus {
  unavailable
  eligible

  @@map("certificate_status")
}

/// Mirrors `LessonProgress` (`progress.types.ts`), one row per (enrollment,
/// lesson) — materialized at enrollment time for every published lesson in
/// the course, not created lazily on first access, so the curriculum
/// sidebar (`CurriculumNav.tsx`) always has a complete status list to
/// render, including locked lessons the student hasn't reached yet.
model LessonProgress {
  id           String               @id @default(uuid())
  enrollmentId String               @map("enrollment_id")
  enrollment   Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String               @map("lesson_id")
  lesson       CourseLesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sectionId    String               @map("section_id")
  courseId     String               @map("course_id")
  status       LessonProgressStatus @default(locked)
  completedAt  DateTime?            @map("completed_at")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId, status])
  @@map("lesson_progress")
}

enum LessonProgressStatus {
  locked
  available
  in_progress
  completed

  @@map("lesson_progress_status")
}

/// Mirrors `Quiz` (`quiz.types.ts`). No write endpoint in P6 — see this
/// section's header comment. `sectionId` is an optional plain categorization
/// column (not a `@relation`), matching how `Course.instructors` etc. keep
/// denormalized/optional pointers plain rather than adding a reverse
/// relation array to `CourseSection` for a field nothing cascades on.
model Quiz {
  id           String     @id @default(uuid())
  courseId     String     @map("course_id")
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sectionId    String?    @map("section_id")
  title        String
  description  String?
  status       QuizStatus @default(draft)
  passingScore Int?       @map("passing_score")
  maxAttempts  Int?       @map("max_attempts")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([courseId, status])
  @@map("quizzes")
}

enum QuizStatus {
  draft
  published

  @@map("quiz_status")
}

/// Mirrors `QuizQuestion` (`quiz.types.ts`). No write endpoint in P6.
model QuizQuestion {
  id        String           @id @default(uuid())
  quizId    String           @map("quiz_id")
  quiz      Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  prompt    String
  type      QuizQuestionType
  order     Int
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  options QuizQuestionOption[]

  @@index([quizId, order])
  @@map("quiz_questions")
}

enum QuizQuestionType {
  single_choice
  multiple_choice
  true_false

  @@map("quiz_question_type")
}

/// Mirrors `QuizQuestionOption` (`quiz.types.ts`) **plus** `isCorrect` — the
/// one field the frontend structurally never receives. Security-critical:
/// any response returned to a student before they submit an attempt MUST
/// be projected through a dedicated response DTO that omits this column —
/// enforced in `quiz-question.contract.ts`, never a field-level "just don't
/// render it" convention (master plan §5.4/§16/§18 scenario 7, the
/// mandatory quiz-correctness projection test).
model QuizQuestionOption {
  id         String       @id @default(uuid())
  questionId String       @map("question_id")
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  isCorrect  Boolean      @default(false) @map("is_correct")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@map("quiz_question_options")
}

/// Mirrors `QuizAttempt` (`quiz.types.ts`). `answers` is kept as JSONB
/// (master plan §5.4: "write-once-then-read-only per attempt, never queried
/// by individual answer") rather than a normalized table — matches
/// `SubmitQuizAttemptPayload`'s own "no per-answer autosave contract"
/// shape exactly: one mutation fires on final submit.
model QuizAttempt {
  id            String            @id @default(uuid())
  quizId        String            @map("quiz_id")
  quiz          Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId     String            @map("student_id")
  student       User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status        QuizAttemptStatus
  answers       Json              @default("[]")
  score         Decimal?          @db.Decimal(5, 2)
  passed        Boolean?
  submittedAt   DateTime?         @map("submitted_at")
  attemptNumber Int               @map("attempt_number")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@index([studentId, quizId, attemptNumber])
  @@map("quiz_attempts")
}

enum QuizAttemptStatus {
  not_started
  in_progress
  submitted
  passed
  failed

  @@map("quiz_attempt_status")
}

/// Mirrors `Assignment` (`assignment.types.ts`). No write endpoint in P6.
/// `sectionId`/`lessonId` are optional plain categorization columns, same
/// "no reverse relation array for a field nothing cascades on" reasoning as
/// `Quiz.sectionId`.
model Assignment {
  id                String           @id @default(uuid())
  courseId          String           @map("course_id")
  course            Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sectionId         String?          @map("section_id")
  lessonId          String?          @map("lesson_id")
  title             String
  description       String?
  instructions      String?
  status            AssignmentStatus @default(draft)
  dueAt             DateTime?        @map("due_at")
  allowResubmission Boolean          @default(false) @map("allow_resubmission")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  submissions AssignmentSubmission[]

  @@index([courseId, status])
  @@map("assignments")
}

enum AssignmentStatus {
  draft
  published

  @@map("assignment_status")
}

/// Mirrors `AssignmentSubmission` (`assignment.types.ts`) + the grading
/// columns master plan §5.4 specifies (`Grade`, kept as one entity from the
/// instructor's view — `AssignmentSubmissionReview`, P7 scope; none of the
/// grading fields are part of P6's own response contract, since the
/// student-facing `AssignmentSubmission` type has no score/feedback field).
/// `(assignment_id, student_id)` stays unconditionally unique — see this
/// section's header comment for why no history table exists.
model AssignmentSubmission {
  id            String                     @id @default(uuid())
  assignmentId  String                     @map("assignment_id")
  assignment    Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId     String                     @map("student_id")
  student       User                       @relation("SubmissionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  status        AssignmentSubmissionStatus
  response      String?
  attachmentUrl String?                    @map("attachment_url")
  submittedAt   DateTime?                  @map("submitted_at")
  gradingStatus SubmissionGradingStatus    @default(ungraded) @map("grading_status")
  score         Decimal?                   @db.Decimal(5, 2)
  feedback      String?
  gradedAt      DateTime?                  @map("graded_at")
  gradedBy      String?                    @map("graded_by")
  grader        User?                      @relation("SubmissionGrader", fields: [gradedBy], references: [id], onDelete: SetNull)
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

enum AssignmentSubmissionStatus {
  draft
  submitting
  submitted
  failed

  @@map("assignment_submission_status")
}

enum SubmissionGradingStatus {
  ungraded
  graded

  @@map("submission_grading_status")
}

// ---------------------------------------------------------------------------
// Phase P7 — Instructor Operations & Community (master plan §5.5, §21
// Phase P7).
//
// "Instructor Operations" itself adds NO new table — `InstructorService`
// (roster/grading/submission-review) resolves teaching scope from the
// existing `course_instructors` (P5) and reads/writes the existing
// `enrollments`/`course_progress`/`quiz_attempts`/`assignment_submissions`
// (P6) tables; `assignment_submissions.grading_status`/`score`/`feedback`/
// `graded_at`/`graded_by` already exist (P6 schema, unused by any P6
// endpoint) — P7 is the first phase to write them, through a narrow
// `POST .../submissions/:id/grade` endpoint. See this migration's RLS
// block for the additive, `course_instructors`-keyed SELECT/UPDATE
// policies this requires on every one of those pre-existing tables — never
// writing to `course_instructors` itself, matching master plan §24's
// explicit, audited "resolves teaching scope from it, never writes it"
// rule.
//
// "Community" (`announcements`, `blog_posts`, `forums`/`forum_threads`/
// `forum_replies`) is the real new schema surface, per §5.5. All four are
// User-scoped like P6 (`TenancyContextService.runInUserContext`,
// `app.current_user_id`), NEVER `app.current_organization_id` — every one
// of these resources is reached through a flat (`blog-posts`) or
// course-nested (`announcements`, `forum`) route with no `:academyId`/
// `:organizationId` URL segment for an `AcademyScopeGuard`-style bootstrap
// to resolve org membership from (confirmed against the real frontend
// `AnnouncementService`/`BlogService`/`ForumService` — none of their
// methods takes an organization or academy id), and because a course's
// forum/announcements must be reachable by an enrolled STUDENT too, who is
// structurally never an `organization_memberships` row (the exact P6
// reasoning, reapplied). RLS below resolves every real ownership/
// visibility fact — academy staff membership, course-teaching scope, active
// enrollment, post authorship — via `EXISTS` subqueries keyed on
// `current_setting('app.current_user_id')`, never a second session
// variable.
// ---------------------------------------------------------------------------

/// Matches `AnnouncementAudience` (`announcement.types.ts`) exactly.
enum AnnouncementAudience {
  platform
  academy
  course

  @@map("announcement_audience")
}

/// Matches `AnnouncementStatus` (`announcement.types.ts`) exactly.
enum AnnouncementStatus {
  draft
  scheduled
  published
  archived

  @@map("announcement_status")
}

/// Mirrors `Announcement` (`announcement.types.ts`) field-for-field.
/// `academyId` is set for BOTH `audience: 'academy'` AND `audience:
/// 'course'` (denormalized from `course.academy_id` at creation time for
/// course-scoped rows — same "no join needed, no session-context
/// ambiguity" convention as `Enrollment.academyId`/`CourseLesson.courseId`)
/// — confirmed against the frontend `Announcement.academyId` field's own
/// doc comment ("Present only when audience is 'academy' or 'course'"),
/// which is the literal ground truth this schema matches, not master plan
/// §5.5's own shorthand ("exactly one of the two, or neither"). `courseId`
/// is set only for `audience: 'course'`. Both null only for `audience:
/// 'platform'`.
///
/// Authoring is course-scoped only in P7 — matches `AnnouncementService`'s
/// real frontend contract exactly (no academy- or platform-level create/
/// update endpoint exists there at all). The `academy`/`platform` audience
/// values and their columns are real, RLS-protected, and readable (a
/// platform-wide or academy-wide announcement could exist), but nothing in
/// this phase inserts one — mirrors the exact `course_categories`/
/// `course_instructors` "table real, write capability is a later phase's
/// job" precedent from P5.
model Announcement {
  id          String               @id @default(uuid())
  audience    AnnouncementAudience
  academyId   String?              @map("academy_id")
  academy     Academy?             @relation(fields: [academyId], references: [id], onDelete: Cascade)
  courseId    String?              @map("course_id")
  course      Course?              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId    String               @map("author_id")
  author      User                 @relation(fields: [authorId], references: [id])
  title       String
  body        String
  status      AnnouncementStatus   @default(draft)
  scheduledAt DateTime?            @map("scheduled_at")
  publishedAt DateTime?            @map("published_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@index([courseId, status])
  @@index([academyId, status])
  @@map("announcements")
}

/// Matches `BlogPostStatus` (`blog.types.ts`) exactly.
enum BlogPostStatus {
  draft
  published
  archived

  @@map("blog_post_status")
}

/// Mirrors `BlogPost` (`blog.types.ts`) field-for-field — the dynamic,
/// permission-gated Knowledge Blog (`@features/blog`), distinct from the
/// pre-existing static, prerendered marketing blog (master plan §5.5's own
/// naming note). `academyId` absent = platform-level, matching the
/// frontend field's own doc comment. `CreateBlogPostPayload` carries no
/// `academyId` field at all — the owning academy is resolved server-side
/// from the author's own single staff `academy_members` row (`AuthorId`'s
/// own doc comment on `BlogService`: "Ownership... resolved server-side
/// from the authenticated session"); see `BlogPostsService` for the exact,
/// narrow rule this schema does not itself encode.
model BlogPost {
  id            String         @id @default(uuid())
  academyId     String?        @map("academy_id")
  academy       Academy?       @relation(fields: [academyId], references: [id], onDelete: Cascade)
  authorId      String         @map("author_id")
  author        User           @relation(fields: [authorId], references: [id])
  title         String
  slug          String
  excerpt       String?
  content       String
  featuredImage String?        @map("featured_image_url")
  category      String?
  tags          String[]       @default([])
  status        BlogPostStatus @default(draft)
  publishedAt   DateTime?      @map("published_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@unique([academyId, slug])
  @@map("blog_posts")
}

/// Matches `Forum['status']` (`forum.types.ts`) exactly.
enum ForumStatus {
  open
  locked
  archived

  @@map("forum_status")
}

/// Mirrors `Forum` (`forum.types.ts`) — one per course (`courseId` unique).
/// `academyId` is denormalized from `course.academy_id` at creation time —
/// same convention as `Announcement.academyId`/`Enrollment.academyId` —
/// used only to satisfy the frontend `Forum.academyId` field, never queried
/// for RLS (forum visibility resolves through `courseId` alone). No create
/// endpoint exists in `ForumService` — a course's forum row is created
/// lazily (get-or-create) the first time anyone with real course access
/// requests it, mirroring how `course_progress`/`lesson_progress` (P6) are
/// materialized on first legitimate access rather than pre-seeded.
model Forum {
  id          String      @id @default(uuid())
  courseId    String      @unique @map("course_id")
  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academyId   String      @map("academy_id")
  title       String
  description String?
  status      ForumStatus @default(open)
  createdAt   DateTime    @default(now()) @map("created_at")

  threads ForumThread[]

  @@map("forums")
}

/// Mirrors `ForumThread` (`forum.types.ts`) field-for-field. `courseId` is
/// denormalized from `forum.course_id` — same "no extra join on the hot
/// read path" convention as every other course-nested table in this schema.
model ForumThread {
  id        String   @id @default(uuid())
  forumId   String   @map("forum_id")
  forum     Forum    @relation(fields: [forumId], references: [id], onDelete: Cascade)
  courseId  String   @map("course_id")
  authorId  String   @map("author_id")
  author    User     @relation(fields: [authorId], references: [id])
  title     String
  body      String
  pinned    Boolean  @default(false)
  locked    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  replies ForumReply[]

  @@index([forumId, pinned, createdAt])
  @@map("forum_threads")
}

/// Mirrors `ForumReply` (`forum.types.ts`) field-for-field.
model ForumReply {
  id        String      @id @default(uuid())
  threadId  String      @map("thread_id")
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String      @map("author_id")
  author    User        @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([threadId, createdAt])
  @@map("forum_replies")
}

// ---------------------------------------------------------------------------
// Phase P8 — Media Library & Object Storage (master plan §5.9, §13, §21
// Phase P8, ADR-005).
//
// Academy-scoped, org-context RLS — the exact same shape as `courses`
// (P5): `media_assets.academy_id → academies.organization_id`, resolved
// under `app.current_organization_id` via `AcademyScopeGuard`
// (`AcademyModule`, reused verbatim — `academies/:id/media*` is the same
// `:id`-is-the-academy-id route shape `CoursesController` already
// established). No new guard, no new session variable, no new tenancy
// model. Unlike P6/P7, nothing here needs to be reachable by a student or
// under `app.current_user_id` — the Media Library (per the real frontend
// contract, `MediaLibraryDialog`) is an academy-staff-only surface,
// embedded only inside website-builder form fields today.
//
// PostgreSQL stores metadata + `storage_key`/`url` only, never binary
// content (master plan §13's explicit justification). `storage_key`
// always looks like `academies/{academyId}/{uuid}.{ext}` — backend-
// generated only (`MediaService`), never a client-supplied path, so a
// leaked/guessed key from one academy is structurally unreachable for
// another even before RLS/auth is checked (§13's "Authorization" row).
// ---------------------------------------------------------------------------

/// Matches `MediaAssetType` (`media.types.ts`) exactly. `video` is a real,
/// representable value (the frontend type needs it to exist), but P8's
/// own upload path never produces one — no video upload pipeline exists
/// yet (master plan §13 V2, `SPECIFICATION-UNDEFINED`, §24) and the V1
/// MIME allowlist (`file-validation.util.ts`) deliberately excludes every
/// video MIME type. `other` is likewise representable but never produced
/// by this phase's classifier — reserved for a future upload path this
/// phase does not build.
enum MediaAssetType {
  image
  video
  document
  other

  @@map("media_asset_type")
}

/// Matches `MediaAssetStatus` (`media.types.ts`) exactly. Archive-only
/// lifecycle — no hard delete, matching `Course`/`Academy`'s own
/// precedent (master plan §13: "no hard delete, matching the frontend's
/// CMS rule extended to media").
enum MediaAssetStatus {
  active
  archived

  @@map("media_asset_status")
}

/// Mirrors `MediaAssetSummary`/`MediaAssetDetail` (`media.types.ts`)
/// field-for-field — the frontend has no separate detail shape (`type
/// MediaAssetDetail = MediaAssetSummary`), so this one model backs both
/// `GET .../media` and `GET .../media/:id`. `width`/`height` are
/// deliberately nullable, populated asynchronously by `media-worker`
/// after upload (master plan §13: "Image handling: dimension/thumbnail
/// extraction async, never inline in the upload request") — never
/// guessed or computed synchronously in the request/response cycle.
model MediaAsset {
  id         String           @id @default(uuid())
  academyId  String           @map("academy_id")
  academy    Academy          @relation(fields: [academyId], references: [id], onDelete: Cascade)
  type       MediaAssetType
  status     MediaAssetStatus @default(active)
  fileName   String           @map("file_name")
  /// The object-storage key (`academies/{academyId}/{uuid}.{ext}`) — kept
  /// separate from `url` so the CDN/domain can change without a data
  /// migration (master plan §5.9's own explicit reasoning).
  storageKey String           @map("storage_key")
  url        String
  altText    String?          @map("alt_text")
  mimeType   String           @map("mime_type")
  /// `bigint` at rest (master plan §5.9) — a real file size, never
  /// meaningfully bounded by a 32-bit int.
  sizeBytes  BigInt           @map("size_bytes")
  width      Int?
  height     Int?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  @@index([academyId, status, type])
  @@map("media_assets")
}

// ---------------------------------------------------------------------------
// P9 — Website Builder & Theme Engine (master plan §5.10, §21 Phase P9).
//
// `website_configurations` (PK: `academy_id`, 1:1 with `Academy` — matches
// `WebsiteConfiguration.academyId`, `academy.types.ts`'s "one Academy = one
// website" design). `theme_key`/`theme_version` are plain config fields, not
// a theme catalog table — the frontend's five built-in themes
// (`WEBSITE_THEME_KEYS`, `website-theme.types.ts`) are a client-side,
// code-registered catalog (`WebsiteThemeRegistry`); the backend never
// re-derives or serves theme *definitions*, only records which one this
// Academy picked (master plan §21 P9: "only implement what the frontend
// already defines").
//
// `website_pages` stores `sections` as validated JSONB
// (`SectionInstance[]`), never normalized into per-section-type tables —
// sections are read/written atomically as one page save (`updatePage`
// PATCHes the whole array), matching §5.10's explicit "kept as validated
// JSONB, not normalized" instruction. Every write is validated server-side
// against the exact discriminated-union shape
// (`SectionType` → `SectionConfigMap[type]`) the frontend's own
// `website-section.schemas.ts` enforces — see
// `src/website/validation/section-config.schemas.ts`, a field-for-field
// backend reproduction of that file, never a looser reinterpretation.
//
// Six core page types (`WEBSITE_CORE_PAGE_TYPES`, `website.types.ts`) exist
// per Academy, auto-provisioned the first time either the configuration or
// the page list is read for an Academy that has none yet (no dedicated
// "create website" endpoint exists anywhere in the real
// `WebsiteConfigurationService` contract) — see `WebsiteBootstrapService`.
// `courseDetails` is the one core type with no `visible` toggle in the real
// UI (`WebsitePagesPage.tsx` renders a lock icon, not a `Switch`, for it) —
// enforced here by simply never accepting a visibility change for it at the
// service layer, not a separate schema constraint.
//
// Custom pages support a REAL hard delete (`DELETE
// academies/:id/website/pages/:pageId`, `useDeleteWebsitePage.ts`) — this is
// a deliberate, discovery-driven departure from the Course/Media
// "archive-only, no DELETE policy" convention: direct inspection of the
// actual frontend service proves a genuine hard-delete capability exists
// for custom pages (core pages are rejected at the service layer, matching
// the UI's own "no delete button for a core page" rule). The DELETE RLS
// policy below exists for exactly this reason.
// ---------------------------------------------------------------------------

/// Matches `WebsitePublishStatus` (`website.types.ts`) exactly.
enum WebsitePublishStatus {
  draft
  published
  publishing
  failed

  @@map("website_publish_status")
}

/// Matches `WebsitePageType` (`website.types.ts`) exactly.
enum WebsitePageType {
  core
  custom

  @@map("website_page_type")
}

/// Matches `WEBSITE_CORE_PAGE_TYPES` (`website.types.ts`) exactly — the six
/// core page contracts every theme supports.
enum WebsiteCorePageType {
  home
  about
  courses
  faqs
  contact
  courseDetails

  @@map("website_core_page_type")
}

/// Mirrors `WebsiteConfiguration` (`website.types.ts`) field-for-field —
/// always the current DRAFT working copy (never what is published).
/// `brand`/`seo`/`navigation`/`header`/`footer` are validated JSONB
/// (`WebsiteBrandConfig`/`WebsiteSeoConfig`/`WebsiteNavigationItem[]`/
/// `WebsiteHeaderConfig`/`WebsiteFooterConfig`), validated server-side
/// against the same Zod shapes the frontend's `website.schemas.ts` already
/// enforces before being persisted.
model WebsiteConfiguration {
  academyId        String               @id @map("academy_id")
  academy          Academy              @relation(fields: [academyId], references: [id], onDelete: Cascade)
  themeKey         String               @map("theme_key")
  themeVersion     Int                  @map("theme_version")
  configVersion    Int                  @default(1) @map("config_version")
  brand            Json
  seo              Json
  navigation       Json
  header           Json
  footer           Json
  status           WebsitePublishStatus @default(draft)
  publishedAt      DateTime?            @map("published_at")
  /// Mirrors `WebsitePublishError` (`{messageKey, detail?}`) — only ever
  /// set when `status = 'failed'`.
  lastPublishError Json?                @map("last_publish_error")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@map("website_configurations")
}

/// Mirrors `WebsitePage` (`website.types.ts`) field-for-field. `sections`
/// is the full `SectionInstance[]` array, validated server-side (see this
/// file's own doc comment above) before every write.
model WebsitePage {
  id        String               @id @default(uuid())
  academyId String               @map("academy_id")
  academy   Academy              @relation(fields: [academyId], references: [id], onDelete: Cascade)
  pageType  WebsitePageType      @map("page_type")
  /// Present only when `pageType = 'core'` — matches `WebsitePage.coreType`
  /// (`readonly coreType?: WebsiteCorePageType`) exactly.
  coreType  WebsiteCorePageType? @map("core_type")
  title     String
  slug      String
  visible   Boolean              @default(true)
  seo       Json
  sections  Json
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@unique([academyId, slug])
  @@index([academyId, pageType])
  @@map("website_pages")
}

// ---------------------------------------------------------------------------
// P10 — CMS Content Library & SEO (master plan §5.10, §21 Phase P10).
//
// `website_faq_entries`/`website_testimonial_entries` are Academy-scoped
// reusable CMS library content — distinct from a `WebsitePage`'s own
// inline `FaqItem`/`TestimonialItem` section content (P9, unchanged),
// which stays single-locale and page-authored. A library entry is
// authored once, independently localized in English and Arabic
// (`LocalizedText { en, ar }`, matching `website-content.types.ts`
// exactly), and referenced by id from any number of `faq`/`testimonials`
// sections across a website via `libraryEntryIds`
// (`FaqSectionConfig`/`TestimonialsSectionConfig`, §5.10) — resolved live
// at render time, never duplicated into the section's own stored data.
//
// SEO resolution (Page/Entity Override → Global → System Fallback) and
// structured-data (JSON-LD) builders are deliberately NOT new database
// structures — direct inspection of the real frontend confirms
// `resolvePageSeo`/`resolveCourseSeo`/`buildOrganizationJsonLd`/
// `buildCourseJsonLd`/`buildBreadcrumbJsonLd` are pure, client-side
// functions operating entirely on data the P9 endpoints already return
// (`website_configurations.seo`, `website_pages.seo`, the existing
// `Course`/`Academy` domains) — there is no backend "resolve SEO" or
// "structured data" HTTP endpoint anywhere in the real contract. P10's
// backend equivalent (`src/website/seo/`) is therefore a pure,
// dependency-free utility library only, ready for P11's public runtime to
// import — never persisted, never exposed through a new controller.
// ---------------------------------------------------------------------------

/// Matches `WebsiteContentStatus` (`website-content.types.ts`) exactly.
/// `archived` is terminal and non-destructive — there is no hard-delete
/// endpoint anywhere in the real `WebsiteContentService` contract.
enum WebsiteContentStatus {
  draft
  published
  archived

  @@map("website_content_status")
}

/// Mirrors `WebsiteFaqEntry` (`website-content.types.ts`) field-for-field.
/// `order` has no uniqueness constraint — it is a plain sort key, resorted
/// by the real UI via pairwise swaps (`WebsiteFaqContentTab.moveItem`),
/// never a bulk-reorder endpoint (unlike `WebsitePage.sections`, P9).
model WebsiteFaqEntry {
  id        String               @id @default(uuid())
  academyId String               @map("academy_id")
  academy   Academy              @relation(fields: [academyId], references: [id], onDelete: Cascade)
  /// `LocalizedText { en, ar }` — both languages always present.
  question  Json
  answer    Json
  order     Int                  @default(0)
  visible   Boolean              @default(true)
  status    WebsiteContentStatus @default(draft)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@index([academyId, status])
  @@index([academyId, order])
  @@map("website_faq_entries")
}

/// Mirrors `WebsiteTestimonialEntry` (`website-content.types.ts`)
/// field-for-field. `authorName` is a plain string (NOT localized — the
/// frontend type itself declares it `readonly authorName: string`, not
/// `LocalizedText`, unlike every other content field here); `authorRole`
/// and `avatar` are optional, matching the frontend type's own `?`.
model WebsiteTestimonialEntry {
  id         String               @id @default(uuid())
  academyId  String               @map("academy_id")
  academy    Academy              @relation(fields: [academyId], references: [id], onDelete: Cascade)
  quote      Json
  authorName String               @map("author_name")
  /// `LocalizedText { en, ar }`, nullable — only when omitted entirely.
  authorRole Json?                @map("author_role")
  /// Reuses the existing website image-asset convention (base64/`MediaAsset.url`) — never a second upload pipeline.
  avatar     String?
  order      Int                  @default(0)
  visible    Boolean              @default(true)
  status     WebsiteContentStatus @default(draft)
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  @@index([academyId, status])
  @@index([academyId, order])
  @@map("website_testimonial_entries")
}

// ---------------------------------------------------------------------------
// P11 — Public Website Runtime, Domains & Edge (master plan §5.11, §7,
// §21 Phase P11).
//
// `subdomain_allocations`/`domain_connections` reuse the exact vocabulary
// the real frontend already defines (`domain.types.ts`, reusing
// `DomainStatus`/`DomainVerificationRecord`/`DomainConnection`/
// `SubdomainAllocation` from `provisioning.types.ts` verbatim — this
// schema does the same: one status enum, not a parallel one). Subdomain
// ALLOCATION (writing a `subdomain_allocations` row) is P14's job
// (Provisioning Orchestration) — confirmed by direct inspection: the real
// `DomainService` (frontend) has no "allocate subdomain" method at all,
// only `getDomainConfiguration`/`addCustomDomain`/`removeCustomDomain`/
// `verifyDomain`. P11 only reads whatever a future P14 populates here
// (honestly nothing, in every environment today) — the table exists now
// because the master plan's schema requires it and
// `AcademyDomainConfiguration.subdomain` already has a real, live
// frontend consumer expecting to read it.
//
// `domain_connections` IS written by P11 — `addCustomDomain`/
// `removeCustomDomain`/`verifyDomain` are real, shipped frontend methods.
// "Remove" resets the row to its `not_configured` state rather than a
// hard delete (no DELETE RLS policy exists on this table, consistent
// with the archive-only convention P8/P10 already established, and the
// row's `academy_id` uniqueness makes an actual delete pointless — the
// Academy will only ever have zero-or-one domain_connections row for its
// entire lifetime).
// ---------------------------------------------------------------------------

/// Matches `SubdomainStatus` (`provisioning.types.ts`) exactly.
enum SubdomainStatus {
  suggested
  available
  unavailable
  reserved
  assigned

  @@map("subdomain_status")
}

/// Matches `DomainStatus` (`provisioning.types.ts`) exactly — the real
/// 7-value enum, reused verbatim, never redeclared.
enum DomainStatus {
  not_configured
  pending
  verification_required
  verifying
  connected
  failed
  disconnected

  @@map("domain_status")
}

/// Matches `SslStatus` (`domain.types.ts`) exactly. `not_configured` is
/// the only honest value while no real Cloudflare/CA integration is
/// connected — nothing in this phase can move a domain past it without a
/// genuine provider check.
enum SslStatus {
  not_configured
  pending
  provisioning
  active
  failed
  expired

  @@map("ssl_status")
}

/// Matches `CdnStatus` (`domain.types.ts`) exactly.
enum CdnStatus {
  not_configured
  active
  degraded
  error

  @@map("cdn_status")
}

/// Matches `InfrastructureProviderName` (`domain.types.ts`) exactly — a
/// single-entry union today, extensible without touching existing rows.
enum InfrastructureProviderName {
  cloudflare

  @@map("infrastructure_provider_name")
}

/// Mirrors `SubdomainAllocation` (`provisioning.types.ts`) field-for-field.
/// Written by a future P14, read by P11's `DomainService.
/// getDomainConfiguration` — see this section's doc comment above.
model SubdomainAllocation {
  id        String          @id @default(uuid())
  academyId String          @unique @map("academy_id")
  academy   Academy         @relation(fields: [academyId], references: [id], onDelete: Cascade)
  subdomain String          @unique
  status    SubdomainStatus
  /// Full backend-resolved host (e.g. `harvard.atlas.dev`) — never
  /// constructed on the frontend from a guessed root domain.
  fullHost  String?         @map("full_host")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@map("subdomain_allocations")
}

/// Mirrors `DomainConnection` (`provisioning.types.ts`) plus the SSL/CDN
/// fields `AcademyDomainConfiguration` (`domain.types.ts`) layers on top
/// — the master plan's own §5.11 schema keeps these on the same row
/// (`ssl_status`, `cdn_status`, `cdn_provider`), never a separate table.
model DomainConnection {
  id                  String                      @id @default(uuid())
  academyId           String                      @unique @map("academy_id")
  academy             Academy                     @relation(fields: [academyId], references: [id], onDelete: Cascade)
  hostname            String?                     @unique
  status              DomainStatus                @default(not_configured)
  /// `DomainVerificationRecord[]` (`{type, name, value}`) — display data
  /// only, generated from the real Cloudflare custom-hostname response,
  /// never fabricated locally.
  verificationRecords Json?                       @map("verification_records")
  sslStatus           SslStatus                   @default(not_configured) @map("ssl_status")
  cdnStatus           CdnStatus                   @default(not_configured) @map("cdn_status")
  cdnProvider         InfrastructureProviderName? @map("cdn_provider")
  connectedAt         DateTime?                   @map("connected_at")
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  @@map("domain_connections")
}

/// Platform-owned singleton — mirrors `TrialPolicy` (P4) exactly: a fixed,
/// well-known id read/written via `upsert`, never a find-then-create race.
/// Not tenant-scoped, no RLS — matches `TrialPolicy`/`SchemaMeta`'s own
/// identical "platform-infrastructure metadata, not tenant data" rule.
model PlatformDomainConfiguration {
  id         String   @id @default(uuid())
  baseDomain String?  @map("base_domain")
  configured Boolean  @default(false)
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("platform_domain_configuration")
}
