// Atlas Backend — Prisma schema.
//
// Phase P0 (Foundation) scope only. Per Reports/ATLAS_BACKEND_MASTER_PLAN.md
// §21's Phase P0 entry: "Database changes: none domain-specific — migration
// tooling proven with one trivial migration (e.g. a `schema_meta` table) to
// confirm the pipeline works."
//
// No business/domain tables (users, organizations, academies, courses, ...)
// are defined here. They begin in Phase P1 onward, each phase extending this
// file with its own models — see the master plan's §5 for the full,
// eventual schema this file grows into. Do not add a table here that a
// later phase owns; this file's only job right now is to prove the
// migration pipeline is real, not to anticipate future schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Proves the migration pipeline end-to-end (create, apply, and read back a
/// real table) without modeling any business domain. Intentionally the only
/// model in this phase. Not tenant-scoped — this is platform-infrastructure
/// metadata (e.g. a schema version marker), not tenant data, so it
/// deliberately carries no `organization_id`/`academy_id` and needs no RLS
/// policy (see the master plan §7's tenant-scoping rule, which applies to
/// domain tables, not this one).
model SchemaMeta {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("schema_meta")
}

// ---------------------------------------------------------------------------
// Phase P1 — Identity, Auth & Sessions (master plan §5.1, §21 Phase P1).
//
// Platform-scoped, not tenant-scoped: a user is not owned by one
// organization (that relationship — `organization_memberships` — is Phase
// P2's job). No RLS policy applies here for the same reason §7 exempts
// `schema_meta`: these tables carry no `organization_id`/`academy_id`.
// ---------------------------------------------------------------------------

/// Matches `PlatformUserAccountStatus`/`CurrentUser` exactly. Deliberately
/// only these three values — do not add `locked`/`pending_verification`
/// states; both email verification and account lockout are explicitly
/// `SPECIFICATION-UNDEFINED` per master plan §8/§24 and must not be built
/// into the schema ahead of a product decision.
enum UserAccountStatus {
  active
  invited
  suspended
  /// Phase 10.6 — self-deleted. Irreversible, and distinct from
  /// `suspended` (which is administrator-driven and can be undone).
  deleted

  @@map("user_account_status")
}

/// One account per human — mirrors `CurrentUser` (master plan §5.1).
///
/// Email case-insensitivity note: the master plan suggests Postgres
/// `citext`, but Prisma has no first-class `citext` column type (it can
/// only be modeled via `Unsupported("citext")`, which the Prisma Client
/// cannot use in ordinary `where`/`create` calls — every lookup would need
/// hand-written raw SQL, which is inconsistent with every other table in
/// this codebase using the Client normally). Case-insensitivity is instead
/// enforced at the application layer: every write and lookup normalizes
/// email via `.trim().toLowerCase()` before it ever reaches Prisma
/// (`identity/utils/email.util.ts`), so the plain `@unique` constraint below
/// still guarantees one account per email regardless of the case a user
/// types it in.
model User {
  id               String                   @id @default(uuid())
  email            String                   @unique
  name             String
  avatarUrl        String?                  @map("avatar_url")
  isPlatformOwner  Boolean                  @default(false) @map("is_platform_owner")
  /// Mirrors `UserPreferences` (`theme?`, `language?`, `notifications?`).
  /// Validated server-side (not schema-enforced) — see `PreferencesService`.
  preferences      Json                     @default("{}")
  status           UserAccountStatus        @default(active)
  /// Phase 10.1 — when this address was proven able to receive mail.
  /// Null means unverified. Nullable rather than a boolean with a default
  /// so pre-existing accounts stay honestly "not yet proven" instead of
  /// being retroactively claimed as verified, and so the moment of
  /// verification is itself auditable.
  emailVerifiedAt  DateTime?                @map("email_verified_at")
  /// Phase 10.6 — when the user deleted their own account. Null while live.
  deletedAt        DateTime?                @map("deleted_at")
  /// Optional closed-vocabulary reason, and optional free text. Neither is ever required to delete.
  deletionReason   String?                  @map("deletion_reason")
  deletionFeedback String?                  @map("deletion_feedback")
  lastSignInAt     DateTime?                @map("last_sign_in_at")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  /// Full-text search vector — a STORED GENERATED column maintained by
  /// PostgreSQL (name weight A, email weight B). Modelled here as `Unsupported` so that
  /// `prisma migrate diff` knows the column and its GIN index exist and
  /// never proposes dropping them again (migration p44 did exactly that,
  /// which broke `GET /search` in production). Never read through the
  /// Prisma Client; `SearchRepository` queries it by raw SQL.
  searchVector     Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, COALESCE(name, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(email, ''::text)), 'B'::\"char\"))")) @map("search_vector")

  refreshTokens                                 RefreshToken[]
  passwordResetTokens                           PasswordResetToken[]
  emailVerificationTokens                       EmailVerificationToken[]
  /// Production-readiness pass — the password credential lives in its own
  /// strictly self-scoped table, never on the directory row. No row = the
  /// account has no password (Google-only, invited, deleted).
  credential                                    UserCredential?
  /// Phone number — its own strictly self-scoped table (like the
  /// credential), never on the directory row. No row = no phone.
  phone                                         UserPhone?
  twoFactor                                     UserTwoFactor?
  twoFactorRecoveryCodes                        TwoFactorRecoveryCode[]
  ownedOrganizations                            Organization[]                           @relation("OrganizationOwner")
  organizationMemberships                       OrganizationMembership[]
  academyMemberships                            AcademyMember[]
  /// Phase 1 (Extended Scope, Decision 11, dependency D) — a student's real,
  /// validated home Academy, structurally parallel to `AcademyMember` (the
  /// staff equivalent). Populated at registration time (or backfilled from
  /// pre-existing enrollments) — see the migration's own doc comment.
  academyStudentships                           AcademyStudent[]
  courseInstructorships                         CourseInstructor[]
  enrollments                                   Enrollment[]
  courseReviews                                 CourseReview[]                           @relation("CourseReviewAuthor")
  quizAttempts                                  QuizAttempt[]                            @relation("QuizAttemptStudent")
  quizAttemptsGraded                            QuizAttempt[]                            @relation("QuizAttemptGrader")
  quizAttemptsInvalidated                       QuizAttempt[]                            @relation("QuizAttemptInvalidator")
  quizResults                                   QuizResult[]
  quizOverrides                                 QuizStudentOverride[]                    @relation("QuizOverrideStudent")
  quizOverridesCreated                          QuizStudentOverride[]                    @relation("QuizOverrideCreator")
  certificates                                  Certificate[]                            @relation("CertificateStudent")
  certificatesIssued                            Certificate[]                            @relation("CertificateIssuer")
  certificatesRevoked                           Certificate[]                            @relation("CertificateRevoker")
  assignmentSubmissions                         AssignmentSubmission[]                   @relation("SubmissionStudent")
  gradedSubmissions                             AssignmentSubmission[]                   @relation("SubmissionGrader")
  /// P60 — courses this user created. `SetNull` on the course side, so
  /// deleting the user leaves the courses standing with no recorded creator.
  createdCourses                                Course[]                                 @relation("CourseCreator")
  announcements                                 Announcement[]
  blogPosts                                     BlogPost[]
  forumThreads                                  ForumThread[]
  forumReplies                                  ForumReply[]
  paymentReviews                                PaymentReview[]                          @relation("PaymentReviewer")
  organizationCommissionSettingsUpdates         OrganizationCommissionSettings[]         @relation("OrganizationCommissionSettingsUpdatedBy")
  atlasCommissionConfigUpdates                  AtlasCommissionConfig[]                  @relation("AtlasCommissionConfigUpdatedBy")
  atlasSubscriptionPaymentProviderConfigUpdates AtlasSubscriptionPaymentProviderConfig[] @relation("AtlasSubscriptionPaymentProviderConfigUpdatedBy")
  /// Phase P13 — Course Commerce (master plan §23).
  courseOrders                                  CourseOrder[]
  courseOrderPayments                           Payment[]                                @relation("PaymentPayer")
  courseOrderRefundRequests                     CourseOrderRefund[]
  planCommissionSettingsUpdates                 PlanCommissionSettings[]                 @relation("PlanCommissionSettingsUpdatedBy")
  /// Phase P14 — Provisioning Orchestration (master plan §5.11/§21).
  provisioningRequestsCreated                   ProvisioningRequest[]
  /// Phase P15 — Platform Owner Control Plane (master plan §5.12/§21).
  auditLogEntriesActedBy                        AuditLogEntry[]
  supportCasesRequested                         SupportCase[]
  /// Customer Requests — filed by this person / assigned to this Platform Owner.
  customerRequestsFiled                         CustomerRequest[]                        @relation("CustomerRequestRequester")
  customerRequestsAssigned                      CustomerRequest[]                        @relation("CustomerRequestAssignee")
  /// Phase P17 — Notifications, Email & Search (master plan §5/§21).
  notifications                                 Notification[]
  /// Phase 10.1 — Free-Trial anti-abuse. SetNull, never Cascade: deleting
  /// the user must not erase the fact that a trial was consumed.
  trialRedemptions                              TrialRedemption[]                        @relation("TrialRedeemer")
  /// W8 — gifted-setup-day redemptions this user (as organization owner) received. SetNull on delete.
  paidGiftRedemptions                           PaidGiftRedemption[]                     @relation("PaidGiftRedeemer")
  /// Phase 10.2 — cancellations this user performed.
  subscriptionCancellations                     SubscriptionCancellation[]               @relation("SubscriptionCanceller")
  websitePagesLastEdited                        WebsitePage[]                            @relation("WebsitePageUpdatedBy")

  /// Phase 12 — Live Sessions add-on.
  liveProviderConnections AcademyLiveProviderConnection[] @relation("LiveProviderConnector")
  liveProviderOAuthStates LiveProviderOAuthState[]        @relation("LiveProviderOAuthInitiator")
  hostedLiveSessions      LiveSession[]                   @relation("LiveSessionHost")
  liveSessionParticipants LiveSessionParticipant[]        @relation("LiveSessionParticipant")

  /// P64 Phase 2 — the learner's registered devices and their own
  /// content-access history.
  studentDevices            StudentDevice[]
  contentAccessLog          ContentAccessLog[]
  /// P64 Communications.
  communicationOutbox       CommunicationOutbox[]
  communicationDigests      CommunicationDigest[]
  /// W3-compose — campaigns this person authored, and the ones they received.
  communicationCampaigns    CommunicationCampaign[]
  campaignRecipients        CampaignRecipient[]
  authEmailChallenges       AuthEmailChallenge[]
  accountDeletionChallenges AccountDeletionChallenge[]
  trustedDevices            TrustedDevice[]
  /// Google Identity — the external sign-in identities bound to this account.
  authIdentities            UserAuthIdentity[]
  authOAuthFlowsToLink      AuthOAuthFlow[]            @relation("AuthOAuthFlowLinkUser")

  @@index([status])
  @@index([searchVector], type: Gin)
  @@map("users")
}

/// Rotating session tokens backing `TokenMetadata.refreshToken`. Only the
/// SHA-256 hash of the raw token is ever persisted — a database leak alone
/// never yields a usable token (master plan §5.1, §8, §16).
model RefreshToken {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String         @unique @map("token_hash")
  deviceLabel     String?        @map("device_label")
  /// Phase 10 — the stable identity of one DEVICE SESSION, constant across
  /// every rotation of that session's refresh token.
  ///
  /// This exists because `RefreshTokensRepository.rotate` deliberately
  /// revokes the presented row and INSERTS a new one on every refresh, so
  /// a row id identifies one link in a chain, not the device. Listing rows
  /// directly would show a user dozens of "sessions" for a single browser.
  /// A new value is minted at sign-in; every rotation copies it forward.
  ///
  /// Backfilled to each existing row's OWN `id`, which is what makes the
  /// change non-breaking: an access token already in circulation carries
  /// `sid` = its row id, and that value is now exactly the `sessionId` of
  /// the same session, so previously-issued tokens keep resolving.
  sessionId       String         @map("session_id")
  /// Real client IP at the moment this token was issued, resolved from the
  /// production reverse proxy's forwarding header (never client-supplied
  /// body data). Null for rows created before Phase 10 — honestly unknown
  /// rather than backfilled with a fabricated address.
  ipAddress       String?        @map("ip_address")
  /// Raw `User-Agent` header, stored verbatim and parsed for display only.
  userAgent       String?        @map("user_agent")
  /// ISO 3166-1 alpha-2 country, resolved from Cloudflare's `CF-IPCountry`
  /// edge header. Null when Cloudflare did not supply a usable country
  /// (local development, or its `XX`/`T1` sentinels) — honestly unknown
  /// rather than guessed. Deliberately country-only: Atlas has no
  /// trustworthy city source, and inventing one is worse than saying
  /// nothing.
  locationCountry String?        @map("location_country") @db.VarChar(2)
  /// Real last activity for this session: set at sign-in, on every
  /// refresh, and — since Phase 11.10 — coalesced from ordinary
  /// authenticated request activity. Never a frontend-supplied or
  /// render-time value.
  lastUsedAt      DateTime?      @map("last_used_at")
  expiresAt       DateTime       @map("expires_at")
  revokedAt       DateTime?      @map("revoked_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  /// P64 Phase 1 (AD-5) — the surface this session was minted on and,
  /// for the academy surface, which academy. Copied forward on every
  /// rotation; a learner never holds a `management` session.
  surface         SessionSurface @default(management)
  academyId       String?        @map("academy_id")
  /// P64 Phase 2 (AD-10, D4) — the `student_devices` row this session was
  /// minted on, when the sign-in carried an `atlas_device` cookie.
  ///
  /// Null for every management session and for every row minted before
  /// this column existed: the device registry governs LEARNING, and
  /// retro-fitting a device identity onto a session that never had one
  /// would be an invention. Copied forward on rotation exactly like
  /// `sessionId`, so a device's session survives refreshes.
  deviceId        String?        @map("device_id")
  device          StudentDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  /// Google Identity — the FIRST factor this session was established with
  /// (`password` | `google`). The emailed code, TOTP and a trusted device are
  /// additional factors and never change it. Copied forward on rotation.
  /// Null for every session minted before this column existed: honestly
  /// unknown, never backfilled with a guess.
  authMethod      AuthMethod?    @map("auth_method")
  /// ATO review F10 — when the session (the `sessionId` family) began:
  /// set at sign-in, copied forward by every rotation. A rotation never
  /// extends a session past this + the surface's absolute maximum
  /// (`IdentityConfig.sessionAbsoluteMaxDays`). Null only on rows that
  /// predate the column and were no longer live when it was backfilled.
  sessionStartedAt DateTime?     @map("session_started_at")

  @@index([userId, revokedAt])
  @@index([sessionId])
  @@index([deviceId])
  @@map("refresh_tokens")
}

/// Google Identity — how a person proved who they are at sign-in (the first
/// factor). Second factors are deliberately not in this list.
enum AuthMethod {
  password
  google

  @@map("auth_method")
}

/// P64 Phase 1 — where a session was created (AD-5).
enum SessionSurface {
  management
  academy

  @@map("session_surface")
}

/// Backs `PasswordResetRequest`/`PasswordResetConfirmation`. Single-use,
/// short-lived, hashed at rest — same rationale as `RefreshToken`.
/// Phase 10.3 — a user's TOTP second factor.
///
/// ENFORCEMENT HANGS ON `confirmedAt`, NOT ON THE ROW EXISTING. Setup
/// creates the row with a secret but leaves `confirmedAt` null, and 2FA
/// is NOT enforced in that state. Until the user has proved they can
/// generate a correct code, requiring one at sign-in would lock them out
/// of their own account over a mis-scanned QR code.
///
/// THE SECRET IS ENCRYPTED AT REST with AES-256-GCM under a key derived
/// specifically for this purpose — see `TotpSecretCipher`. It is never
/// stored, logged, or returned in plaintext after the one-time setup
/// response that the user needs in order to enrol.
/// Production-readiness pass — the account's password credential.
///
/// Split out of `users` so that the identity DIRECTORY (joined by rosters,
/// reviews, certificates, audit, search, the platform console…) never carries
/// a credential: no `select`, `include` or serialiser anywhere in the product
/// can put a hash on the wire or in a log, because the directory row does not
/// have one. FORCE ROW LEVEL SECURITY admits a row only in its owner's own
/// `app.current_user_id` context, and only `CredentialsRepository` reads or
/// writes it.
model UserCredential {
  userId       String   @id @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Argon2id PHC string. Never logged, never returned.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("user_credentials")
}

/// The account's own phone number (sign-up / profile). Off the `users`
/// directory row on purpose: rosters, reviews, search and the platform
/// console read that row inside any established context, while this table
/// is FORCE-RLS'd to the account's own `app.current_user_id` for every
/// command — nobody else (staff, organization owner, Platform Owner) can
/// read it. See migration `20261110000200_user_phone`.
model UserPhone {
  userId      String    @id @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// E.164, normalised server-side by libphonenumber (`+201001234567`).
  /// Unique: one account per number (20261110000400_user_phone_unique_staff_read).
  phoneE164   String    @unique(map: "user_phones_phone_e164_key") @map("phone_e164") @db.VarChar(16)
  /// ISO 3166-1 alpha-2 country the person chose (`EG`). Kept alongside the
  /// number because one calling code can serve several countries (+1, +7).
  countryCode String    @map("country_code") @db.VarChar(2)
  /// When this exact number was proven reachable. Null = unverified. A DB
  /// trigger clears it whenever `phone_e164` changes.
  verifiedAt  DateTime? @map("verified_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("user_phones")
}

model UserTwoFactor {
  userId          String    @id @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// AES-256-GCM ciphertext of the base32 TOTP secret. Never plaintext.
  encryptedSecret String    @map("encrypted_secret")
  /// Null until the user proves they can produce a valid code. 2FA is enforced only once this is set.
  confirmedAt     DateTime? @map("confirmed_at")
  /// Phase 10.3 — REPLAY PROTECTION. The TOTP time step of the last
  /// accepted code. A code is rejected unless its time step is strictly
  /// greater, so the same six digits can never be used twice even inside
  /// their own 30-second validity window.
  lastTimeStep    Int?      @map("last_time_step")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("user_two_factor")
}

/// Phase 10.3 — single-use recovery codes.
///
/// Stored HASHED, exactly like a password: a database disclosure must not
/// hand over a working second factor. The plaintext codes are shown to
/// the user exactly once, at generation, and are unrecoverable afterwards
/// — regenerating is the only remedy for losing them.
model TwoFactorRecoveryCode {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the normalised code. Unique so the same code can never exist twice.
  codeHash  String    @unique @map("code_hash")
  /// Set on first use. Single-use is enforced by a conditional UPDATE, not by deletion, so the audit trail survives.
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, usedAt])
  @@map("two_factor_recovery_codes")
}

/// Phase 10.1 — proof that the address on an account can actually receive
/// mail. Structurally identical to `PasswordResetToken` on purpose: same
/// hashed-token-at-rest discipline, same single-use `usedAt` marker, same
/// expiry semantics. Reusing a proven shape rather than inventing a
/// second one.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Only the SHA-256 of the emailed token is stored — a database
  /// disclosure never yields a usable verification link.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  /// Set on first successful use. A second attempt with the same token
  /// finds it already used and is refused — this is what makes replay
  /// impossible.
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Phase P2 — Organizations, Membership & Multi-Tenancy Core (master plan
// §5.2, §7, §21 Phase P2).
//
// `organizations` is the tenant root. Every tenant-scoped table from this
// phase forward carries `organization_id` as a real FK column (§5's
// universal convention) and gets an RLS policy created in the SAME
// migration that creates it (§17) — see migration.sql for the
// `ENABLE ROW LEVEL SECURITY` / `FORCE ROW LEVEL SECURITY` / `CREATE
// POLICY` statements; Prisma's schema language has no RLS syntax, so those
// are appended by hand to the generated migration, not expressed here.
// ---------------------------------------------------------------------------

/// Matches `Organization`'s status union (mirrored from
/// `PlatformOrganizationSummary`/`Detail` — there is no standalone bare
/// `Organization` type in the frontend today; this enum's values are taken
/// directly from the master plan §5.2 definition, which all
/// organization-shaped frontend types agree with).
enum OrganizationStatus {
  active
  suspended
  archived

  @@map("organization_status")
}

/// The SaaS tenant boundary — the root of the tenant hierarchy (master plan
/// §7). Soft-delete only: no delete endpoint exists or is planned for this
/// table; `status` is the only lifecycle mechanism.
model Organization {
  id                    String                   @id @default(uuid())
  name                  String
  slug                  String                   @unique
  status                OrganizationStatus       @default(active)
  /// New Customer Onboarding — the ONLY persisted onboarding state (see
  /// docs/NEW_CUSTOMER_ONBOARDING.md §5). NULL = the owner has not yet
  /// finished or deferred the onboarding wizard. Defaults to now() so every
  /// pre-existing organization and every legacy creation path counts as
  /// onboarded; only the new signup path writes NULL explicitly.
  onboardingCompletedAt DateTime?                @default(now()) @map("onboarding_completed_at")
  ownerUserId           String                   @map("owner_user_id")
  owner                 User                     @relation("OrganizationOwner", fields: [ownerUserId], references: [id])
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  /// Full-text search vector — a STORED GENERATED column maintained by
  /// PostgreSQL (name weight A, slug weight B). Modelled here as `Unsupported` so that
  /// `prisma migrate diff` knows the column and its GIN index exist and
  /// never proposes dropping them again (migration p44 did exactly that,
  /// which broke `GET /search` in production). Never read through the
  /// Prisma Client; `SearchRepository` queries it by raw SQL.
  searchVector          Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('english'::regconfig, COALESCE(name, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(slug, ''::text)), 'B'::\"char\"))")) @map("search_vector")
  /// W4 — the uniqueness key of `name` (`atlas_name_key(name)`: NFKD, Latin
  /// accents / Arabic harakat / tatweel / invisibles stripped, ICU lowercase,
  /// NFKC, whitespace collapsed). A STORED GENERATED column, modelled with its
  /// generation expression as a `dbgenerated` default — like `searchVector` —
  /// so a schema diff knows it exists and never proposes dropping it (`text`
  /// is a supported type, so `String?` is its exact shape). NEVER write it:
  /// PostgreSQL rejects writes to a generated column. Unique platform-wide
  /// across every status (`organizations_name_key_key`). Checked through the
  /// boolean definer check `organization_name_taken`.
  nameKey               String?                  @default(dbgenerated("atlas_name_key(name)")) @map("name_key")

  memberships            OrganizationMembership[]
  academies              Academy[]
  subscription           TenantSubscription?
  addOns                 TenantAddOn[]
  usage                  TenantUsage?
  checkouts              Checkout[]
  payments               Payment[]
  invoices               TenantInvoice[]
  webhookEvents          PaymentWebhookEvent[]
  paymentSettings        OrganizationPaymentSettings?
  gatewayCredential      OrganizationGatewayCredential?
  connectedAccount       OrganizationConnectedAccount?
  commissionSettings     OrganizationCommissionSettings?
  CourseOrder            CourseOrder[]
  academyPaymentMethods  AcademyPaymentMethod[]
  /// Phase P14 — Provisioning Orchestration (master plan §5.11/§21).
  provisioningRequests   ProvisioningRequest[]
  /// Phase 10.1 — Free-Trial anti-abuse. SetNull, never Cascade: deleting
  /// the organization must not erase the redemption it consumed.
  trialRedemptions       TrialRedemption[]
  /// W8 — gifted-setup-day redemptions recorded against this organization. SetNull on delete.
  paidGiftRedemptions    PaidGiftRedemption[]
  /// Phase 10.2 — trial/subscription cancellations for this organization.
  cancellations          SubscriptionCancellation[]
  /// Phase P15 — Platform Owner Control Plane (master plan §5.12/§21).
  auditLogEntries        AuditLogEntry[]
  supportCases           SupportCase[]
  /// Customer Requests — custom services an academy asked Atlas for.
  customerRequests       CustomerRequest[]
  /// P64 Communications C5/C6.
  lifecycleState         TenantLifecycleState?
  /// W3-compose — academy campaigns and the monthly email quota.
  communicationCampaigns CommunicationCampaign[]
  emailUsagePeriods      TenantEmailUsagePeriod[]
  emailUsageLedger       TenantEmailUsageLedger[]

  @@unique([nameKey])
  @@index([status])
  @@index([searchVector], type: Gin)
  @@map("organizations")
}

/// Join table between `users` and `organizations` — mirrors
/// `OrganizationMembership` (`identity.types.ts`) field-for-field. `role`
/// stays a flat string and `permissions` a flat string array by deliberate
/// design (master plan §9): there is no Role/Permission catalog table, and
/// P2 must not introduce one.
model OrganizationMembership {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  permissions    String[]     @default([])
  isPrimary      Boolean      @default(false) @map("is_primary")
  joinedAt       DateTime     @default(now()) @map("joined_at")

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_memberships")
}

// ---------------------------------------------------------------------------
// Phase P3 — Academy Management (master plan §5.2, §21 Phase P3).
//
// Academy is the second-level tenant scope, belonging to exactly one
// Organization. RLS resolves tenant ownership transitively through
// `organization_id`/`academy_id` — no new session variable, no parallel
// tenant mechanism; the same `app.current_organization_id`/
// `app.current_user_id` variables P2 established are reused. See
// migration.sql for the policies (Prisma's schema language has no RLS
// syntax).
// ---------------------------------------------------------------------------

/// Matches `AcademyStatus` (`academy.types.ts`) exactly.
enum AcademyStatus {
  draft
  active
  suspended
  archived

  @@map("academy_status")
}

/// Matches `AcademyMemberRole` (`academy.types.ts`) exactly — flat string
/// values, not a catalog table (master plan §9: no Role/Permission catalog).
enum AcademyMemberRole {
  owner
  administrator
  manager
  instructor
  staff

  @@map("academy_member_role")
}

/// Matches `AcademyMemberStatus` (`academy.types.ts`) exactly.
enum AcademyMemberStatus {
  active
  inactive
  pending

  @@map("academy_member_status")
}

/// Mirrors `Academy` (`academy.types.ts`) field-for-field. Soft-delete
/// only, matching `Organization`'s own precedent and master plan §5's
/// "no hard delete" convention for this domain — `DELETE
/// /academies/:id` (the frontend's real, defined contract) is implemented
/// as a status transition to `archived`, never a SQL `DELETE`; there is no
/// DELETE RLS policy on this table at all (see migration.sql).
model Academy {
  id             String                   @id @default(uuid())
  organizationId String                   @map("organization_id")
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String                   @unique
  description    String?
  logoUrl        String?                  @map("logo_url")
  faviconUrl     String?                  @map("favicon_url")
  status         AcademyStatus            @default(draft)
  timezone       String                   @default("Africa/Cairo")
  language       String                   @default("en")
  currency       String                   @default("EGP")
  contactEmail   String?                  @map("contact_email")
  contactPhone   String?                  @map("contact_phone")
  websiteUrl     String?                  @map("website_url")
  /// Mirrors `AcademyAddress` (`street?`, `city?`, `state?`, `postalCode?`,
  /// `country`). Validated server-side (DTO), not schema-enforced —
  /// consistent with `users.preferences`' existing precedent in this file.
  address        Json?
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  /// Full-text search vector — a STORED GENERATED column maintained by
  /// PostgreSQL (name A, slug B, description C). Modelled here as `Unsupported` so that
  /// `prisma migrate diff` knows the column and its GIN index exist and
  /// never proposes dropping them again (migration p44 did exactly that,
  /// which broke `GET /search` in production). Never read through the
  /// Prisma Client; `SearchRepository` queries it by raw SQL.
  searchVector   Unsupported("tsvector")? @default(dbgenerated("((setweight(to_tsvector('english'::regconfig, COALESCE(name, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(slug, ''::text)), 'B'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(description, ''::text)), 'C'::\"char\"))")) @map("search_vector")
  /// W4 — `atlas_name_key(name)`, STORED GENERATED (see `Organization.nameKey`).
  /// Unique platform-wide across every status, archived included, like the
  /// slug (`academies_name_key_key`). Checked through `academy_name_taken`.
  nameKey        String?                  @default(dbgenerated("atlas_name_key(name)")) @map("name_key")

  /// Phase 10.6 — why the owner deleted this Academy. Atlas's delete IS
  /// archival (there is deliberately no DELETE RLS policy on this table),
  /// so the reason lives on the row rather than in a separate tombstone.
  /// Null for an Academy that is not archived, and for one archived
  /// before this was recorded.
  archivedAt         DateTime?                 @map("archived_at")
  /// Closed vocabulary, validated by the DTO. Never free text.
  archiveReason      String?                   @map("archive_reason")
  /// Optional free text the owner chose to leave. Never required.
  archiveFeedback    String?                   @map("archive_feedback")
  /// P64 Phase 1 (D3) — existing academies default to `open`; new academies
  /// choose at creation; changeable later by the Client Owner only (D8).
  registrationPolicy AcademyRegistrationPolicy @default(open) @map("registration_policy")
  /// P64 Phase 2 (D8) — the Client Owner's content-protection choices for
  /// this academy. Mirrors `AcademyContentProtection`: `{ watermark: bool,
  /// watermarkText: string|null, disableDownload: bool, disablePip: bool,
  /// disableContextMenu: bool }`. Validated by the DTO, not the schema,
  /// following `address`'s existing precedent in this file. Null means
  /// "platform defaults", which is what every academy gets until an owner
  /// changes something — never a silently weaker setting.
  contentProtection  Json?                     @map("content_protection")
  /// P64 Phase 2 (D10, D11) — the tier NEW uploads land on.
  ///
  /// A default for future uploads, never a statement about existing ones:
  /// `media_assets.security_tier` is the record of what each asset
  /// actually is. Bounded at write time by what the organization's plan
  /// family entitles, so an academy cannot select a tier it is not paying
  /// for. Null means "whatever the plan entitles", which is the correct
  /// behaviour for every academy that has never chosen.
  videoSecurityTier  VideoSecurityTier?        @map("video_security_tier")

  members                AcademyMember[]
  students               AcademyStudent[]
  invites                AcademyInvite[]
  courseCategories       CourseCategory[]
  courses                Course[]
  courseReviews          CourseReview[]
  announcements          Announcement[]
  blogPosts              BlogPost[]
  mediaAssets            MediaAsset[]
  websiteConfiguration   WebsiteConfiguration?
  websitePages           WebsitePage[]
  websiteFaqEntries      WebsiteFaqEntry[]
  websiteTestimonials    WebsiteTestimonialEntry[]
  subdomainAllocation    SubdomainAllocation?
  domainConnection       DomainConnection?
  domainProviderReleases DomainProviderRelease[]
  /// Phase P13 — Course Commerce (master plan §23/§5.8).
  courseOrderPayments    Payment[]
  paymentMethods         AcademyPaymentMethod[]
  courseOrders           CourseOrder[]
  revenueLedgerEntries   RevenueLedgerEntry[]
  payouts                AcademyPayout[]
  /// Phase P14 — Provisioning Orchestration (master plan §5.11/§21).
  provisioningRequest    ProvisioningRequest?
  /// Phase 6 — real, persisted public Contact-form submissions.
  contactSubmissions     ContactSubmission[]
  /// Phase 8 — Support, Audit & Dashboards.
  auditLogEntries        AuditLogEntry[]
  supportCases           SupportCase[]
  /// Customer Requests — custom services this academy asked Atlas for.
  customerRequests       CustomerRequest[]

  /// Phase 12 — Live Sessions add-on.
  liveProviderConnection  AcademyLiveProviderConnection?
  liveProviderOAuthStates LiveProviderOAuthState[]
  liveSessions            LiveSession[]

  /// P64 Phase 2 — protected content, its access log, and the device
  /// policy that governs who may play it where.
  lessonContents            LessonContent[]
  lessonResources           LessonResource[]
  contentAccessLog          ContentAccessLog[]
  studentDevices            StudentDevice[]
  certificateTemplates      CertificateTemplate[]
  certificates              Certificate[]
  certificateSerialCounters CertificateSerialCounter[]
  accessPolicy              AccessPolicy?

  /// W3-compose — academy Messages and the monthly email quota.
  communicationCampaigns CommunicationCampaign[]
  emailUsagePeriods      TenantEmailUsagePeriod[]
  emailUsageLedger       TenantEmailUsageLedger[]

  /// Notification context isolation — academy-context feed rows.
  notifications Notification[]

  @@unique([nameKey])
  @@index([organizationId, status])
  @@index([searchVector], type: Gin)
  @@map("academies")
}

/// Mirrors `AcademyMember` (`academy.types.ts`) — `name`/`email` are not
/// stored here (the frontend type's own fields for those are resolved via
/// a join to `users` at query time, never duplicated).
model AcademyMember {
  id        String              @id @default(uuid())
  academyId String              @map("academy_id")
  academy   Academy             @relation(fields: [academyId], references: [id], onDelete: Cascade)
  userId    String              @map("user_id")
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AcademyMemberRole
  status    AcademyMemberStatus @default(active)
  joinedAt  DateTime            @default(now()) @map("joined_at")

  @@unique([academyId, userId])
  @@index([academyId])
  @@index([userId])
  @@map("academy_members")
}

/// Phase 1 (Extended Scope, Decision 11, dependency D) — a Student's real
/// Academy membership, structurally parallel to `AcademyMember` above but
/// deliberately a SEPARATE table/enum-less role, not a reuse of
/// `AcademyMember`/`AcademyMemberRole` (which has no `student` role and is
/// reserved for staff — see `AcademyStudentResponse`'s pre-existing doc
/// comment: "a student is never an `academy_members` row"). Populated
/// either by self-registration through a specific Academy's public
/// website (`AuthService.register`) or by a Manager/Owner explicitly
/// creating a student account for their Academy (`AcademiesService.
/// createStudent`) — see the migration's own doc comment for the RLS
/// shape both paths rely on, and `is_academy_student` (mirrors
/// `is_academy_member`) for how downstream RLS (`enrollments`) uses it.
model AcademyStudent {
  id                String               @id @default(uuid())
  academyId         String               @map("academy_id")
  academy           Academy              @relation(fields: [academyId], references: [id], onDelete: Cascade)
  userId            String               @map("user_id")
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            AcademyMemberStatus  @default(active)
  joinedAt          DateTime             @default(now()) @map("joined_at")
  /// P64 Phase 1 — provenance and roster facts. `source` records how the
  /// membership came to exist; `blocked_at` is the staff-side kill switch
  /// (`is_academy_student()` and `assertActiveEnrollment` both refuse a
  /// blocked student); `last_activity_at` feeds the roster sort.
  source            AcademyStudentSource @default(self_signup)
  registeredViaHost String?              @map("registered_via_host")
  blockedAt         DateTime?            @map("blocked_at")
  blockedReason     String?              @map("blocked_reason")
  invitedBy         String?              @map("invited_by")
  lastActivityAt    DateTime?            @map("last_activity_at")
  /// W4 — `atlas_name_key(users.name)`, copied from the account and kept in
  /// step by SECURITY DEFINER triggers (`academy_students_name_key_biu` on
  /// insert, `users_learner_name_key_au` on a rename). Never written by the
  /// application: the trigger overwrites whatever is sent.
  nameKey           String               @default("") @map("name_key")
  /// W4 — true for a row allowed to share its key with another learner of
  /// this academy: automatic admissions (sign-in auto-join, purchase) that
  /// clashed, and legacy duplicates. Learners are never renamed.
  nameUniqueExempt  Boolean              @default(false) @map("name_unique_exempt")

  /// W4 — one NON-EXEMPT learner per name key per academy: the partial unique
  /// index `academy_students_academy_id_name_key_key ON (academy_id, name_key)
  /// WHERE NOT name_unique_exempt` lives in the migration SQL; Prisma cannot
  /// express partial indexes.
  @@unique([academyId, userId])
  @@index([academyId])
  @@index([userId])
  @@index([academyId, lastActivityAt])
  @@map("academy_students")
}

/// P64 Phase 1 — how an `academy_students` row came to exist.
enum AcademyStudentSource {
  self_signup
  sign_in_join
  staff_created
  purchase
  invite
  backfill

  @@map("academy_student_source")
}

/// P64 Phase 1 — who may become a student of an Academy (D3).
enum AcademyRegistrationPolicy {
  open
  invite
  approval

  @@map("academy_registration_policy")
}

/// P64 Phase 1 — a single-use (by default) invitation token for an
/// Academy whose registration policy is `invite`. Only the hash is stored.
model AcademyInvite {
  id        String    @id @default(uuid())
  academyId String    @map("academy_id")
  academy   Academy   @relation(fields: [academyId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  createdBy String    @map("created_by")
  email     String?
  maxUses   Int       @default(1) @map("max_uses")
  usedCount Int       @default(0) @map("used_count")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([academyId, expiresAt])
  @@map("academy_invites")
}

// ---------------------------------------------------------------------------
// Phase P4 — Plans, Subscription & Entitlements (master plan §5.6, §21
// Phase P4).
//
// `plans`/`add_ons`/`trial_policy` are PLATFORM-owned catalog/config —
// exactly like `schema_meta` (§0) and `users` (§P1), they carry no
// `organization_id`/`academy_id` and get NO RLS policy: every authenticated
// caller reads the same catalog, matching `PlanService`'s own doc comment
// ("unlike `TenantService` nothing here takes an `organizationId`").
//
// `tenant_subscriptions`/`tenant_add_ons`/`tenant_usage` ARE organization-
// scoped and get RLS in the same migration that creates them, reusing the
// exact P2/P3 `app.current_organization_id` mechanism — no new session
// variable, no second tenant mechanism. See migration.sql for the policies.
// ---------------------------------------------------------------------------

/// Matches `PlanStatus` (`plan.types.ts`) exactly.
enum PlanStatus {
  active
  archived

  @@map("plan_status")
}

/// Matches `TenantSubscriptionStatus` (`tenant.types.ts`) exactly — 7 states.
/// Phase 11 — the lifecycle now distinguishes three states that were
/// previously all collapsed into `expired`, which is why a brand-new
/// Organization was being told its subscription had ended.
///
///   `no_plan`       — created, never chose a plan, never had a trial.
///                     A NEW CUSTOMER, not a lapsed one. The only state
///                     from which a Free Trial may be started.
///   `trial_expired` — a Free Trial ran its course. Distinct from
///                     `expired` because the recovery action differs:
///                     "continue with the plan you were trialing", not
///                     "your subscription has ended".
///   `expired`       — a PAID subscription genuinely lapsed.
///
/// Collapsing these was not a labelling problem. `no_plan` and `expired`
/// were the same row shape (`status='expired'`, `trial_ends_at IS NULL`),
/// so no amount of frontend copy could tell them apart — and
/// `markExpired` nulled `trial_ends_at`, making a finished trial
/// indistinguishable from an Organization created five seconds ago.
enum TenantSubscriptionStatus {
  no_plan
  trialing
  trial_expired
  active
  past_due
  paused
  grace_period
  cancelled
  expired

  @@map("tenant_subscription_status")
}

/// Matches `SubscriptionBillingCycle` (`money.types.ts`) exactly.
enum SubscriptionBillingCycle {
  monthly
  yearly

  @@map("subscription_billing_cycle")
}

/// Platform-owned catalog entity — mirrors `Plan` (`plan.types.ts`)
/// field-for-field. Not tenant-scoped (see this section's header comment).
model Plan {
  id                   String     @id @default(uuid())
  key                  String     @unique
  name                 String
  description          String?
  /// P54 — the bilingual catalog text, in the SAME `{ en, ar }`
  /// `LocalizedText` shape every other piece of bilingual business content
  /// in this schema already uses (website CMS entries, inline section
  /// content, SEO fields). Nullable on purpose: `name`/`description` above
  /// remain authoritative for English and for every non-UI reader, and the
  /// frontend's existing `resolveLocalizedText` already falls back to a
  /// plain string, so a plan inserted without translations still renders.
  /// Validated server-side (DTO), not schema-enforced — matching
  /// `limits`/`features`/`pricing`'s own established precedent above.
  nameLocalized        Json?      @map("name_localized")
  descriptionLocalized Json?      @map("description_localized")
  status               PlanStatus @default(active)
  displayOrder         Int        @default(0) @map("display_order")
  /// P64 Phase 2 (D10) — the two commercial axes.
  ///
  /// Existing rows are backfilled to `normal` and to the tier their own
  /// key already implies, so nothing about an existing subscription
  /// changes. `key` stays the unique identity (subscriptions reference
  /// it); these two columns describe it rather than replacing it, which is
  /// what lets the catalog answer "what does a PREMIUM_GROWTH plan
  /// entitle?" without six copies of the same logic.
  family               PlanFamily @default(normal)
  tier                 PlanTier   @default(basic)
  /// Mirrors `PlanResourceLimits` — validated server-side (DTO), not
  /// schema-enforced, matching `users.preferences`'s established precedent
  /// in this file. Each of the 7 `PlanLimitKey` fields is either an `int`
  /// or the literal string `"unlimited"` (`LimitValue`).
  limits               Json
  /// Mirrors `PlanFeatures` — 11 booleans, one per `PlanFeatureKey`.
  features             Json
  /// Mirrors `PlanPricingMetadata`. Display-only — never read by a
  /// checkout/payment flow in this phase (`PlanPricingMetadata`'s own doc
  /// comment: "Prompt 7... owns the real pricing strategy").
  pricing              Json?
  /// Phase 11 — whether THIS plan may be taken as a Free Trial.
  ///
  /// The business rule ("Starter and Growth yes, Enterprise no") lives
  /// HERE, as catalog data, and nowhere else. It is deliberately not a
  /// list of plan keys in application code: adding a fourth plan and
  /// deciding it is trialable must be a configuration change, not a code
  /// change across the frontend and backend. Defaults to `false` so a
  /// newly inserted plan is never accidentally trialable — the safe
  /// direction to fail for a revenue rule.
  trialEligible        Boolean    @default(false) @map("trial_eligible")
  /// Optional per-plan override of `TrialPolicy.durationDays`. Null means
  /// "use the platform default", which is the normal case — the column
  /// exists so a future plan can offer a different-length trial without
  /// another migration or a second policy mechanism.
  trialDurationDays    Int?       @map("trial_duration_days")
  /// W8 — gifted setup days granted in front of the FIRST paid period of a
  /// customer's first-ever paid subscription, per billing cycle. NULL or 0
  /// means no gift; otherwise 5..15 (DB CHECK `plans_gifted_days_*_range_chk`
  /// and the plan-admin DTO). Catalog data edited by Platform Owners — the
  /// 7/14 defaults are seeded by a separate migration, never hard-coded.
  giftedDaysMonthly    Int?       @map("gifted_days_monthly")
  giftedDaysYearly     Int?       @map("gifted_days_yearly")
  /// P57 — optimistic-concurrency token for Platform-Owner plan edits.
  /// Same column, same 409 `stale_resource_version` contract `website_pages`
  /// established and `add_ons` adopted in P51 — never a second mechanism.
  version              Int        @default(0)
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  subscriptions      TenantSubscription[]
  /// Phase P13 — Course Commerce (master plan §4.2's user-directed
  /// plan-tier commission extension). Optional 1:1 — see
  /// `PlanCommissionSettings`'s own doc comment.
  commissionSettings PlanCommissionSettings?

  @@index([status, displayOrder])
  /// P64 Phase 2 (D10) — the catalog is read by family and tier, not by key,
  /// once six variants exist.
  @@index([family, tier])
  @@map("plans")
}

/// Platform-owned catalog entity — mirrors `AddOn` (`plan.types.ts`).
/// Platform-Owner-controlled publication state of an add-on in the customer
/// Add-ons Store. DISTINCT from `TenantAddOnStatus`, which is a single
/// Academy/Organization's installation lifecycle — this is the central
/// catalog visibility/availability, one value per add-on for all tenants.
enum AddOnCatalogStatus {
  /// Not listed in the customer store; not installable.
  draft
  /// Listed and marked "Coming Soon"; not installable.
  coming_soon
  /// Listed and installable, subject to the usual entitlement/access rules.
  published

  @@map("add_on_catalog_status")
}

model AddOn {
  id                 String             @id @default(uuid())
  key                String             @unique
  name               String
  description        String?
  /// Mirrors the `AddOnLimitEffect`/`AddOnFeatureEffect` discriminated
  /// union (`{type: 'limit', limitKey, amount}` or `{type: 'feature',
  /// featureKey}`) — validated server-side, not schema-enforced.
  effect             Json
  compatiblePlanKeys String[]           @default([]) @map("compatible_plan_keys")
  pricing            Json?
  /// Customer-store publication state, controlled by Platform Owners via the
  /// Add-ons Management page. New add-ons default to `draft` (not exposed
  /// until a Platform Owner publishes them).
  catalogStatus      AddOnCatalogStatus @default(draft) @map("catalog_status")
  /// Optimistic-concurrency token for catalog-status changes, following the
  /// repo's `version` + `stale_resource_version` convention.
  version            Int                @default(0)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenantAddOns TenantAddOn[]

  @@map("add_ons")
}

/// Organization-scoped, one subscription per organization (PK = FK) —
/// mirrors `TenantSubscription` (`tenant.types.ts`). No creation endpoint
/// exists in P4 (matches `organizations` itself — real creation is Phase
/// P14 provisioning); test fixtures seed this table via the admin
/// superuser connection, exactly like `organizations`/`academies`.
model TenantSubscription {
  organizationId     String                    @id @map("organization_id")
  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId             String                    @map("plan_id")
  plan               Plan                      @relation(fields: [planId], references: [id])
  /// P61 — the limits this subscription was actually GRANTED, captured at
  /// the moment the entitlement was granted (paid activation or trial
  /// start). A `PlanResourceLimits` object, the same shape and keys as
  /// `Plan.limits`.
  ///
  /// `planId` says which plan; this says what that plan gave. They are
  /// different facts, and only separating them stops a catalog edit from
  /// retroactively rewriting a purchase — the money is already frozen on
  /// the Payment row, and this is its entitlement counterpart.
  ///
  /// NULL means "no grant recorded — follow the live catalog", which is
  /// exactly how every row behaved before P61. Deliberately not backfilled:
  /// nothing in this database records what the catalog said when an older
  /// subscription was bought, and a guessed value would be a fabricated
  /// commercial fact. Resolved through `resolveSubscriptionLimits`, never
  /// read raw.
  grantedLimits      Json?                     @map("granted_limits")
  status             TenantSubscriptionStatus  @default(trialing)
  /// Present only while `status` is `'trialing'` — not schema-enforced
  /// (mirrors the frontend type's own comment), validated at the service
  /// layer where meaningful.
  trialEndsAt        DateTime?                 @map("trial_ends_at")
  /// Present only while `status` is `'grace_period'`.
  graceEndsAt        DateTime?                 @map("grace_ends_at")
  currentPeriodStart DateTime?                 @map("current_period_start")
  currentPeriodEnd   DateTime?                 @map("current_period_end")
  cancelAtPeriodEnd  Boolean                   @default(false) @map("cancel_at_period_end")
  /// Nullable — "a subscription can exist before any real Checkout ever
  /// set one" (`TenantSubscription.billingCycle`'s own doc comment).
  billingCycle       SubscriptionBillingCycle? @map("billing_cycle")
  /// W8 — the gifted setup-day segment `[giftedStartsAt, giftedEndsAt)` granted
  /// on this organization's first-ever paid subscription. The paid period
  /// starts at `giftedEndsAt` (== `currentPeriodStart` of that purchase).
  /// Written only by the gift-granting approval, never cleared by renewals,
  /// plan changes or cancellation. All-or-nothing (DB CHECK
  /// `tenant_subscriptions_gift_shape_chk`). `giftedPaymentId` is a plain id.
  giftedDays         Int?                      @map("gifted_days")
  giftedStartsAt     DateTime?                 @map("gifted_starts_at")
  giftedEndsAt       DateTime?                 @map("gifted_ends_at")
  giftedPaymentId    String?                   @map("gifted_payment_id")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")

  @@index([planId])
  // P64 C5 — the lifecycle sweep filters by `status` plus ONE of these
  // dates on every tick (trial steps by `trial_ends_at`, renewal and
  // grace by `current_period_end`, expiry and the post-expiry follow-ups
  // by `grace_ends_at`). Without these it is a seq scan per tick; the
  // table is small today, which is exactly when an index is free to add.
  @@index([status, trialEndsAt])
  @@index([status, currentPeriodEnd])
  @@index([status, graceEndsAt])
  @@map("tenant_subscriptions")
}

/// Organization-scoped — mirrors `TenantAddOn` (`tenant.types.ts`). No
/// activation endpoint exists in P4 (no payment provider) — same
/// no-creation-endpoint precedent as `TenantSubscription` above.
/// Phase 12 — the add-on lifecycle.
///
/// INSTALLED IS NOT ENABLED, and neither is ENTITLED. A tenant may install
/// an add-on, disable it temporarily without losing its configuration, and
/// re-enable it later; separately, the PLAN decides whether they are
/// entitled to it at all. Collapsing these into one boolean is what makes
/// "why can't I use this?" unanswerable — see `AddOnAccessService`, which
/// reports which of the conditions actually failed.
///
/// `installing`/`uninstalling` exist because provisioning an add-on can do
/// real work (creating provider records, importing state) that may fail
/// partway; `failed` is terminal-but-retryable and keeps `failureReason`
/// so the UI can say what went wrong rather than showing a dead toggle.
enum TenantAddOnStatus {
  installing
  installed
  enabled
  disabled
  uninstalling
  uninstalled
  failed

  @@map("tenant_add_on_status")
}

model TenantAddOn {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  addOnId        String            @map("add_on_id")
  addOn          AddOn             @relation(fields: [addOnId], references: [id])
  /// Defaults to `enabled` so every row that existed before the lifecycle
  /// was introduced keeps behaving exactly as it did — those rows WERE
  /// active by definition, since activation was all the table could
  /// express. Only ENABLED rows contribute their effect to entitlements.
  status         TenantAddOnStatus @default(enabled)
  /// Why an `installing`/`uninstalling` transition failed. Provider-agnostic
  /// summary only — never a raw provider payload or credential.
  failureReason  String?           @map("failure_reason")
  activatedAt    DateTime          @default(now()) @map("activated_at")
  installedAt    DateTime?         @map("installed_at")
  enabledAt      DateTime?         @map("enabled_at")
  disabledAt     DateTime?         @map("disabled_at")
  uninstalledAt  DateTime?         @map("uninstalled_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@unique([organizationId, addOnId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@map("tenant_add_ons")
}

/// Organization-scoped, one row per organization (PK = FK) — a computed/
/// cached representation, refreshed by the `tenant-usage-recompute` worker
/// (§12), never computed live on a dashboard read (master plan §5.6).
/// Stores only raw `used` counts per `UsageMetric` — the paired `limit`
/// each `UsageMetric` also carries in the API response is derived at read
/// time from the organization's effective entitlements
/// (`EntitlementService`), never persisted here (it would immediately go
/// stale the moment a plan/add-on changed).
model TenantUsage {
  organizationId      String       @id @map("organization_id")
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academies           Int          @default(0)
  students            Int          @default(0)
  instructors         Int          @default(0)
  staff               Int          @default(0)
  courses             Int          @default(0)
  /// GB.
  generalStorageGb    Int          @default(0) @map("general_storage_gb")
  /// GB — tracked separately from general storage.
  videoStorageGb      Int          @default(0) @map("video_storage_gb")
  /// P64 Phase 2 (D5/AD-14) — MINUTES of provider-hosted video, which is a
  /// different resource from `videoStorageGb` (bytes of video sitting in
  /// Atlas's own R2) and therefore a different column rather than a
  /// reinterpretation of an existing one. Ready videos plus active upload
  /// reservations. Atlas's own entitlement number; no provider price is
  /// derived from it anywhere.
  videoStorageMinutes Int          @default(0) @map("video_storage_minutes")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  @@map("tenant_usage")
}

/// Phase 4.6 (scalability fix) — persists `SubscriptionSweepService`'s
/// stale-usage scan cursor ACROSS ticks, closing the bug where a fresh
/// `cursor: string | undefined` local was created on every `run()` call:
/// each tick re-scanned from `id > null` (the very beginning of the
/// `organizations` table) regardless of how far a previous tick had
/// gotten, so the backlog past the per-tick ceiling was never actually
/// reached at scale — every tick just re-did the same first page of work.
///
/// Platform-owned singleton, no RLS — same shape and same reasoning as
/// `TrialPolicy` below: a fixed, well-known id + `upsert` (enforced in
/// `TenantUsageSweepCursorRepository`, not here) closes the concurrent-
/// first-read race atomically, which matters here specifically because
/// this row may be read/written by more than one backend instance's
/// sweep worker under BullMQ horizontal scaling.
///
/// `lastOrganizationId` is `null` in two distinct situations that share
/// one representation on purpose: "no tick has ever run yet" and "the
/// most recent tick scanned all the way to the real end of the
/// `organizations` table and wrapped around" — both mean the next tick
/// should start from the beginning of the id space, which is exactly
/// what `findStaleUsageOrganizationIds(tx, olderThan, undefined, limit)`
/// already does, so no extra "has wrapped" flag is needed.
model TenantUsageSweepCursor {
  id                 String   @id @default(uuid())
  lastOrganizationId String?  @map("last_organization_id")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("tenant_usage_sweep_cursor")
}

/// Platform-owned singleton — mirrors `TrialPolicy` (`plan.types.ts`).
/// Exactly one logical row ever exists; enforced at the service layer
/// (there is no natural single-row DB constraint for a Prisma model with a
/// generated `id`, so `TrialPolicyRepository` always reads/writes the one
/// earliest-created row rather than trusting a hardcoded id).
/// Durable record that a Free Trial has been consumed by one subject.
///
/// THE ENFORCEMENT MECHANISM IS THE UNIQUE INDEX on `subject_hash`, not
/// application code. Two concurrent organization-creation requests for
/// the same subject both attempt the INSERT; Postgres serialises them and
/// exactly one wins, so a race cannot produce two trials no matter how
/// the callers interleave. Application code only has to interpret the
/// unique-violation error, never to hold a lock.
///
/// WHY IT SURVIVES DELETION. `organization_id` and `redeemed_by_user_id`
/// are nullable with ON DELETE SET NULL rather than CASCADE. Deleting the
/// organization or the user erases the link but never the redemption, so
/// "delete everything and sign up again" cannot reset eligibility. This
/// row is the one piece of state that must outlive the entities it
/// references.
///
/// PRIVACY. `subject_hash` is a salted SHA-256 digest of the canonical
/// email — see `trial-subject.util.ts`. The address itself is never
/// stored. `ip_address`/`user_agent` are retained as forensic risk
/// signals ONLY; nothing in the eligibility decision reads them, because
/// blocking on a shared address would lock out everyone behind one
/// company NAT or mobile carrier.
model TrialRedemption {
  id               String        @id @default(uuid())
  /// Salted digest of the canonical email. UNIQUE — this is the constraint that makes trial farming fail.
  subjectHash      String        @unique @map("subject_hash")
  /// The organization that consumed the trial. Null once that organization is deleted; the redemption itself remains.
  organizationId   String?       @map("organization_id")
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  /// The user who redeemed it. Null once that user is deleted.
  redeemedByUserId String?       @map("redeemed_by_user_id")
  redeemedByUser   User?         @relation("TrialRedeemer", fields: [redeemedByUserId], references: [id], onDelete: SetNull)
  redeemedAt       DateTime      @default(now()) @map("redeemed_at")
  trialEndsAt      DateTime?     @map("trial_ends_at")
  /// Forensic signals only — never consulted by the eligibility decision.
  /// Cleared after 180 days by the retention job (W8,
  /// `scrub_trial_redemption_forensics`).
  ipAddress        String?       @map("ip_address")
  userAgent        String?       @map("user_agent")
  /// W8 — 1 = legacy constant-salt SHA-256 (frozen, still checked);
  /// 2 = HMAC-SHA256 under the server key (every new claim).
  hashVersion      Int           @default(1) @map("hash_version") @db.SmallInt
  /// W8 — provenance: 'claim' | 'backfill' | 'v1_upgrade' (DB CHECK).
  source           String        @default("claim")

  @@index([organizationId])
  @@index([redeemedByUserId])
  @@index([redeemedAt])
  @@map("trial_redemptions")
}

/// W8A — durable, append-only record that a customer identity has received
/// its one-time gifted setup days (first-ever paid subscription).
///
/// `subjectHash` is the keyed HMAC (v2) of the organization OWNER's
/// canonical email — the same canonicalization and key as the trial ledger.
/// UNIQUE: the claim is INSERT ... ON CONFLICT DO NOTHING in the approval
/// transaction, so concurrent first payments for one identity yield exactly
/// one gift. FKs SetNull so account/org deletion never restores eligibility;
/// `atlas_app` has no UPDATE/DELETE (refunds do not restore it). No RLS:
/// platform-owned, reachable only via `PaidGiftEligibilityService`.
model PaidGiftRedemption {
  id               String                    @id @default(uuid())
  subjectHash      String                    @unique @map("subject_hash")
  hashVersion      Int                       @default(2) @map("hash_version") @db.SmallInt
  organizationId   String?                   @map("organization_id")
  organization     Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  redeemedByUserId String?                   @map("redeemed_by_user_id")
  redeemedByUser   User?                     @relation("PaidGiftRedeemer", fields: [redeemedByUserId], references: [id], onDelete: SetNull)
  /// Plain id (no FK) — see the migration header.
  paymentId        String?                   @map("payment_id")
  planKey          String?                   @map("plan_key")
  billingCycle     SubscriptionBillingCycle? @map("billing_cycle")
  /// 5..15 for a real gift; 0/NULL for a backfilled "already a paying customer" row.
  giftedDays       Int?                      @map("gifted_days")
  giftedStartsAt   DateTime?                 @map("gifted_starts_at")
  giftedEndsAt     DateTime?                 @map("gifted_ends_at")
  /// 'approval' | 'gateway' | 'backfill' (DB CHECK).
  source           String                    @default("approval")
  redeemedAt       DateTime                  @default(now()) @map("redeemed_at")

  @@index([organizationId])
  @@index([redeemedByUserId])
  @@map("paid_gift_redemptions")
}

/// What was cancelled — a trial or a paid subscription. Recorded
/// explicitly rather than inferred later from subscription status, which
/// changes over time and would make historical rows ambiguous.
enum SubscriptionCancellationKind {
  trial
  paid

  @@map("subscription_cancellation_kind")
}

/// Phase 10.2 — a record of one cancellation, with the reason the user
/// gave.
///
/// IDEMPOTENCY IS ENFORCED BY THE DATABASE. `organization_id` is UNIQUE
/// per kind, so a double-click, a retried request, or two concurrent
/// cancellations produce exactly one row: the second INSERT conflicts and
/// the service treats that as "already cancelled" rather than erroring.
/// No application-level lock is involved.
///
/// CANCELLING NEVER RESTORES TRIAL ELIGIBILITY. This table is entirely
/// separate from `trial_redemptions`, and nothing here deletes or
/// modifies a redemption — a cancelled trial stays redeemed forever.
model SubscriptionCancellation {
  id                String                       @id @default(uuid())
  organizationId    String                       @map("organization_id")
  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind              SubscriptionCancellationKind
  /// A short, closed-vocabulary reason code chosen by the user (validated
  /// server-side against a fixed list) — not free text, so it can be
  /// aggregated on the admin dashboard.
  reason            String
  /// Optional free-text elaboration. NEVER required to cancel: making
  /// feedback mandatory turns a cancellation into a hostage negotiation.
  feedback          String?
  /// Who performed it. Retained for admin visibility and audit
  /// correlation; SetNull so deleting the user does not erase the record.
  cancelledByUserId String?                      @map("cancelled_by_user_id")
  cancelledByUser   User?                        @relation("SubscriptionCanceller", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  cancelledAt       DateTime                     @default(now()) @map("cancelled_at")
  /// When access actually ends. For a trial this is immediate; for a paid
  /// subscription it is the end of the paid period already purchased —
  /// cancelling must never silently forfeit time the customer paid for.
  effectiveAt       DateTime                     @map("effective_at")

  /// W8 D1 — idempotency is enforced by two PARTIAL unique indexes in the
  /// migration SQL (Prisma cannot express them): a trial at most once per
  /// organization, a paid cancellation at most once per (organization,
  /// effective_at) — i.e. once per paid period, so a renewed subscription
  /// can be cancelled again.
  @@index([organizationId, kind])
  @@index([cancelledAt(sort: Desc)])
  @@map("subscription_cancellations")
}

model TrialPolicy {
  id           String   @id @default(uuid())
  enabled      Boolean  @default(true)
  /// Phase 2 (Decision 6, locked): exactly 3 days, no credit card — the
  /// 7-day figure this default previously carried is an explicitly
  /// superseded historical value (see the P22 migration's own doc
  /// comment for the one-time data correction this default change is
  /// paired with).
  durationDays Int      @default(3) @map("duration_days")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("trial_policy")
}

// ---------------------------------------------------------------------------
// Phase P5 — Course Management (master plan §5.3, §21 Phase P5).
//
// Course is Academy-scoped — tenant ownership resolves transitively
// (`course → academy_id → academies.organization_id`), reusing the exact
// P3 mechanism (`academies_org_member_select`-style bootstrap +
// `runInTenantContext`). No `app.current_academy_id`, no second tenant
// mechanism. See migration.sql for the RLS policies.
//
// Scope boundary confirmed against the actual frontend contract before
// writing this schema (Backend Prompt 6 §1's "inspect first" rule):
// `CourseService` (atlas frontend) has NO write method for either course
// categories or course instructors — `getCourseCategories`/
// `getCourseCategory` are its only category methods, and
// `Course.instructors` (`CourseInstructorSummary[]`) is a read-only
// projection with no assignment/removal endpoint anywhere in the
// frontend (confirmed by a full repo-wide grep, not assumed). Both tables
// below exist (master plan §5.3 requires them, and `Course.instructors`
// needs a real source), but carry NO write endpoint in P5 — mirrors the
// exact precedent already established twice in this codebase
// (`organizations` in P2, `tenant_subscriptions` in P4: table exists, RLS
// is real, but creation happens outside the request/response cycle until
// a later phase adds the real capability). Product-confirmed 2026-08-24.
// `discoverCourses`/`discoverCourse` (the flat, cross-academy, session-
// scoped course catalog) are also out of P5's scope — `course.types.ts`'s
// own doc comment ("student consumption... [is a] separate, future
// module") and the frontend's own separate `courseDiscoveryKeys` query-key
// tree both confirm this is Student Learning (P6) scope, not authoring.
// ---------------------------------------------------------------------------

/// Matches `CourseStatus` (`course.types.ts`) exactly. `archived` is the
/// soft-delete terminal state — `DELETE /academies/:id/courses/:id`
/// (the frontend's real, defined contract) is implemented as a status
/// transition, never a SQL `DELETE`, matching `Academy`'s own precedent;
/// there is no DELETE RLS policy on `courses` at all.
enum CourseStatus {
  draft
  published
  archived

  @@map("course_status")
}

/// Matches `CourseVisibility` (`course.types.ts`) exactly.
enum CourseVisibility {
  public
  private

  @@map("course_visibility")
}

/// Matches `CoursePricingType` (`course.types.ts`) exactly.
enum CoursePricingType {
  free
  paid

  @@map("course_pricing_type")
}

/// P64 Phase 4 — catalog difficulty level shown on the course card/details
/// and offered as a catalog filter. Nullable on `Course` (unset = unlabelled).
enum CourseLevel {
  beginner
  intermediate
  advanced
  all_levels

  @@map("course_level")
}

/// P64 Phase 4 — moderation state of a learner's course review. A review is
/// public only when `approved` (and the course is published+public); the
/// learner always sees their own review; owner/manager moderate.
enum CourseReviewStatus {
  pending
  approved
  rejected

  @@map("course_review_status")
}

/// Matches `CourseLessonContentType` (`course.types.ts`) exactly.
enum CourseLessonContentType {
  text
  video
  file

  @@map("course_lesson_content_type")
}

/// Matches `CourseLessonStatus` (`course.types.ts`) exactly — deliberately
/// only `draft`/`published`, no `archived` (the frontend type has none):
/// unlike `Course`, a lesson has no soft-delete state machine, so
/// `DELETE .../lessons/:id` is a real SQL DELETE (see migration.sql).
/// Same reasoning applies to `CourseSection`, which carries no `status`
/// column at all.
enum CourseLessonStatus {
  draft
  published

  @@map("course_lesson_status")
}

/// Mirrors `CourseCategory` (`course.types.ts`) field-for-field.
/// Academy-scoped (master plan §5.3's explicit FK). Read-only in P5 — see
/// this section's header comment.
model CourseCategory {
  id          String   @id @default(uuid())
  academyId   String   @map("academy_id")
  academy     Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  courses Course[]

  @@unique([academyId, slug])
  @@index([academyId])
  @@map("course_categories")
}

/// Mirrors `Course` (`course.types.ts`) field-for-field.
///
/// Pricing bridge: the frontend's `CoursePricing.amount` is a plain
/// decimal number (e.g. `29.99`, matching what the create/edit form
/// collects via `pricingAmount: z.coerce.number()`) — NOT the `Money`/
/// `amountMinorUnits` shape `money.types.ts` defines for the real
/// Checkout/Payment/Invoice commercial contract (Prompt 7/P12-13).
/// Master plan §5.3 still specifies `pricing_amount_minor_units bigint`
/// for this table — the established "money is always a minor-unit
/// integer at rest, never a float" convention — so the DB column stores
/// integer cents and the response/request DTOs (`course.contract.ts`)
/// convert to/from the frontend's plain decimal number. This avoids
/// floating-point money bugs at rest while exposing exactly the shape
/// `CoursePricing` already defines; no new field or endpoint invented.
model Course {
  id                      String                   @id @default(uuid())
  academyId               String                   @map("academy_id")
  academy                 Academy                  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  categoryId              String?                  @map("category_id")
  category                CourseCategory?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// P60 — who created this course.
  ///
  /// A property of the course, so it lives on the course. Nullable because
  /// it genuinely is unknown for rows created before this existed: the P60
  /// backfill fills it ONLY where a `course.created` audit entry proves the
  /// actor, and leaves the rest NULL rather than guessing at the academy
  /// owner. `SetNull` matches every other "who did this" relation here —
  /// deleting a user never deletes their academy's courses.
  createdById             String?                  @map("created_by_id")
  createdBy               User?                    @relation("CourseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  title                   String
  slug                    String
  description             String?
  shortDescription        String?                  @map("short_description")
  thumbnailUrl            String?                  @map("thumbnail_url")
  status                  CourseStatus             @default(draft)
  visibility              CourseVisibility         @default(private)
  pricingType             CoursePricingType        @default(free) @map("pricing_type")
  pricingAmountMinorUnits BigInt?                  @map("pricing_amount_minor_units")
  pricingCurrency         String?                  @map("pricing_currency")
  /// P64 Phase 4 — catalog metadata surfaced on the public course card and
  /// details page (search/filter/sort). All additive and nullable/empty by
  /// default, so existing courses are unaffected. `outcomes`/`requirements`
  /// are ordered lists ("what you will learn" / prerequisites). Course
  /// duration is NOT stored — it is aggregated from lesson `durationSeconds`
  /// at read time to avoid a denormalised field going stale.
  level                   CourseLevel?             @map("level")
  language                String?
  outcomes                String[]                 @default([]) @map("outcomes")
  requirements            String[]                 @default([]) @map("requirements")
  introVideoAssetId       String?                  @map("intro_video_asset_id")
  introVideoAsset         MediaAsset?              @relation("CourseIntroVideo", fields: [introVideoAssetId], references: [id], onDelete: SetNull)
  /// P64 Phase 3 (AD-11) — the completion rule. The default is exactly
  /// today's rule: every published lesson completed, plus whichever quizzes
  /// and assignments are individually marked `required_for_completion`
  /// (none by default), with no minimum overall score.
  completionRule          Json                     @default("{\"lessons\":\"all\",\"requiredQuizzes\":true,\"requiredAssignments\":true,\"minOverallScore\":null}") @map("completion_rule")
  certificatesEnabled     Boolean                  @default(false) @map("certificates_enabled")
  certificateTemplateId   String?                  @map("certificate_template_id")
  certificateTemplate     CertificateTemplate?     @relation(fields: [certificateTemplateId], references: [id], onDelete: SetNull)
  certificateMinScore     Int?                     @map("certificate_min_score")
  publishedAt             DateTime?                @map("published_at")
  /// W6 — the optional client key a create was sent with (`CreateCourseDto.idempotencyKey`). A repeat create with the same key returns this course instead of making another. Unique per academy; NULL for every course created without one (Postgres unique indexes admit many NULLs). Never returned by the API.
  creationIdempotencyKey  String?                  @map("creation_idempotency_key")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  /// Full-text search vector — a STORED GENERATED column maintained by
  /// PostgreSQL (title A, short_description B, description C). Modelled here as `Unsupported` so that
  /// `prisma migrate diff` knows the column and its GIN index exist and
  /// never proposes dropping them again (migration p44 did exactly that,
  /// which broke `GET /search` in production). Never read through the
  /// Prisma Client; `SearchRepository` queries it by raw SQL.
  searchVector            Unsupported("tsvector")? @default(dbgenerated("((setweight(to_tsvector('english'::regconfig, COALESCE(title, ''::text)), 'A'::\"char\") || setweight(to_tsvector('english'::regconfig, COALESCE(short_description, ''::text)), 'B'::\"char\")) || setweight(to_tsvector('english'::regconfig, COALESCE(description, ''::text)), 'C'::\"char\"))")) @map("search_vector")

  sections      CourseSection[]
  instructors   CourseInstructor[]
  enrollments   Enrollment[]
  quizzes       Quiz[]
  assignments   Assignment[]
  announcements Announcement[]
  forum         Forum?
  /// Phase P13 — Course Commerce (master plan §23).
  orders        CourseOrder[]

  /// Phase 12 — Live Sessions as a first-class course activity.
  liveSessions LiveSession[]

  /// P64 Phase 2 — protected lesson payloads belonging to this course, and
  /// the media uploaded for it (the prefix a protected object key is built
  /// from).
  lessonContents  LessonContent[]
  lessonResources LessonResource[]
  mediaAssets     MediaAsset[]
  certificates    Certificate[]
  reviews         CourseReview[]

  @@unique([academyId, slug])
  @@unique([academyId, creationIdempotencyKey])
  @@index([academyId, status, visibility])
  @@index([status, visibility])
  @@index([createdById])
  /// P60 — the platform-wide course list sorts by recency across every
  /// academy; neither existing index serves that.
  @@index([createdAt(sort: Desc)])
  @@index([searchVector], type: Gin)
  @@map("courses")
}

/// P64 Phase 4 — a learner's review of a course they are enrolled in. One
/// review per (course, student) — a rating (1–5) and an optional body — with
/// a moderation `status`. FORCE RLS: public read only when `approved` and the
/// course is published+public; the learner reads/writes their own; owner /
/// manager moderate. `academyId` is denormalised for academy-scoped reads and
/// RLS without a course join.
model CourseReview {
  id        String             @id @default(uuid())
  courseId  String             @map("course_id")
  course    Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academyId String             @map("academy_id")
  academy   Academy            @relation(fields: [academyId], references: [id], onDelete: Cascade)
  studentId String             @map("student_id")
  student   User               @relation("CourseReviewAuthor", fields: [studentId], references: [id], onDelete: Cascade)
  rating    Int
  body      String?
  status    CourseReviewStatus @default(pending)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  @@unique([courseId, studentId])
  @@index([courseId, status])
  @@index([academyId])
  @@map("course_reviews")
}

/// Join table — mirrors master plan §5.3's `course_instructors` exactly
/// ("the server-side source of truth for 'which courses can this
/// instructor teach,' resolved fresh on every request, never client-
/// trusted"). Read-only through P5-P22 (projected into `Course.instructors`,
/// consumed by `is_course_instructor()` (P7) and the Teaching Dashboard/
/// "My Courses" reads it was always designed for). Phase 3 (P23, master
/// plan §22/§23) adds the real write path
/// (`CoursesService.assignInstructor`/`removeInstructor`): explicit,
/// per-course grant/revoke by an Academy owner/administrator/manager,
/// distinct from — and never implied by — Academy-wide instructor roster
/// membership (`AcademyMember` role `instructor`). No ordering/rank
/// column: every assigned instructor has identical standing, by design.
model CourseInstructor {
  courseId   String   @map("course_id")
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([courseId, userId])
  @@index([userId])
  @@map("course_instructors")
}

/// Mirrors `CourseSection` (`course.types.ts`) — `lessons` are returned
/// nested (the frontend type embeds them directly), never paginated
/// separately. No `status` column — sections have no soft-delete state
/// machine, so `DELETE .../sections/:id` is a real SQL DELETE, cascading
/// to its lessons (matches `CourseService.deleteCourseSection`'s own doc
/// comment: "Deletes a course section and its lessons").
model CourseSection {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  order       Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lessons CourseLesson[]

  /// Phase 12 — Live Sessions placed in this unit.
  liveSessions LiveSession[]

  /// P52 — Quizzes/Assignments placed in this unit (SetNull on unit delete).
  quizzes     Quiz[]
  assignments Assignment[]

  @@index([courseId, order])
  @@map("course_sections")
}

/// Mirrors `CourseLesson` (`course.types.ts`). `courseId` is denormalized
/// (master plan §5.3: "for direct scoping without a join") — kept in sync
/// with the parent section's `courseId` at creation time, never updated
/// afterward (a lesson never moves to a different course). No `archived`
/// status (see `CourseLessonStatus`'s doc comment) — `DELETE
/// .../lessons/:id` is a real SQL DELETE.
model CourseLesson {
  id          String                  @id @default(uuid())
  sectionId   String                  @map("section_id")
  section     CourseSection           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  courseId    String                  @map("course_id")
  title       String
  description String?
  order       Int
  contentType CourseLessonContentType @map("content_type")
  contentUrl  String?                 @map("content_url")
  status      CourseLessonStatus      @default(draft)
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")

  /// P64 Phase 2. A preview lesson is deliberately readable WITHOUT an
  /// enrollment — it is the sample a prospective student watches before
  /// buying — so it is the one place the entitlement chain is allowed to
  /// short-circuit, and it is opt-in per lesson by the author.
  isPreview       Boolean              @default(false) @map("is_preview")
  /// Drip date. Null means "available as soon as the course is". A future
  /// value locks the lesson with reason `scheduled`, for enrolled students
  /// too.
  availableAt     DateTime?            @map("available_at")
  /// Authoritative length used for the curriculum's duration labels and as
  /// the denominator of the watched-ratio rule. Copied from the video asset
  /// when one is attached; author-set for text lessons.
  durationSeconds Int?                 @map("duration_seconds")
  completionRule  LessonCompletionRule @default(manual) @map("completion_rule")
  /// The protected video this lesson plays, when it plays one. Separate
  /// from `lesson_contents` because the body and the video are edited
  /// independently and a lesson may have a body AND a video.
  videoAssetId    String?              @map("video_asset_id")
  videoAsset      MediaAsset?          @relation(fields: [videoAssetId], references: [id], onDelete: SetNull)

  lessonProgress LessonProgress[]
  /// P64 Phase 2 — the protected body/file/external payload (AD-3).
  content        LessonContent?
  resources      LessonResource[]

  @@index([sectionId, order])
  @@index([videoAssetId])
  @@map("course_lessons")
}

// ---------------------------------------------------------------------------
// Phase P6 — Student Learning & Assessment (master plan §5.3/§5.4, §21
// Phase P6).
//
// Every table here is USER-owned, not organization/academy-owned (master
// plan §7's resource-ownership table: "Owned by User: ... own Enrollments,
// own Quiz Attempts/Submissions"). Tenant resolution reuses
// `TenancyContextService.runInUserContext` verbatim — the exact
// `app.current_user_id` session variable P2 already introduced for
// `CurrentUser.organizations`, extended here to a second legitimate
// use: a student is never an `organization_memberships`/`academy_members`
// row, so the existing `app.current_organization_id` mechanism structurally
// cannot express "this row belongs to the signed-in student." No new
// session variable, no new tenancy model — see migration.sql for the RLS
// policies built on this.
//
// `quizzes`/`quiz_questions`/`quiz_question_options`/`assignments` carry NO
// write endpoint in P6 — confirmed against the actual frontend contract
// before writing this schema: `QuizService`/`AssignmentService` (atlas
// frontend) are read-only for these four, by their own file-header comments
// ("Quiz authoring is out of scope" / "Assignment authoring and grading
// workflows are out of scope"). Mirrors the exact precedent already
// established for `course_categories`/`course_instructors` in P5: table +
// RLS real, populated only via seed/admin-only inserts, no write endpoint
// until a later phase defines one (Instructor Operations, P7, for grading;
// no phase yet owns authoring).
//
// `discoverCourses`/`discoverCourse` (the flat, cross-academy, published-
// only course catalog) is P6 scope — see this file's own P5 section header,
// which already deferred it here. Reading a published+public `courses` row
// (plus its `course_categories`/`course_instructors` projections) does not
// fit the existing academy-membership-scoped `courses_tenant_select`
// policy — a student is never an organization member of the academy that
// owns the course. Migration.sql adds narrow, ADDITIVE SELECT policies
// (`courses.status = 'published' AND courses.visibility = 'public'`, no
// session-context dependency) alongside the existing academy-staff
// policies — Postgres OR's multiple SELECT policies together, so this
// never weakens or replaces P5's own tenant-scoped policy, it only adds a
// second, legitimate, narrow read path. The `(status, visibility)` index on
// `courses` (P5) was already declared "for the flat cross-academy
// discoverCourses endpoint" — this is that endpoint, arriving on schedule.
//
// Enrollment is free-course-only in P6, by explicit master plan instruction
// ("no payment gate on enrollment yet ... free-course behavior is fully
// buildable now, paid-course gating lands in P13"). `EnrollmentsService`
// rejects a paid course's enrollment attempt outright (403) rather than
// granting free access to paid content or inventing a partial payment gate
// — no course-purchase flow exists to gate on yet.
//
// `assignment_submissions` deliberately has NO `assignment_submission_
// history` table — master plan §5.4 itself says this table is only added
// "when Phase 6 discovers resubmission history is actually needed for
// grading UX; not built speculatively now." It wasn't discovered to be
// needed: `AssignmentSubmission` (frontend) carries no history field, and
// the one write endpoint (`submitAssignment`) is a single create-or-replace
// call. `(assignment_id, student_id)` stays unconditionally unique; a
// resubmission updates that same row in place when
// `assignments.allow_resubmission` is true, and is rejected with 409 when
// it is false — "keep the latest row" exactly as instructed, no history
// table invented.
// ---------------------------------------------------------------------------

/// Mirrors `Enrollment` (`enrollment.types.ts`) exactly. `academyId` is
/// denormalized from `course.academy_id` at creation time — same "no join
/// needed on the student-facing path" reasoning as `CourseLesson.courseId`
/// (P5) — never updated afterward, never a real FK relation object (matches
/// that precedent's plain-column shape).
model Enrollment {
  id            String                  @id @default(uuid())
  studentId     String                  @map("student_id")
  student       User                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId      String                  @map("course_id")
  course        Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academyId     String                  @map("academy_id")
  status        EnrollmentStatus
  enrolledAt    DateTime?               @map("enrolled_at")
  completedAt   DateTime?               @map("completed_at")
  /// P64 Phase 1 — access lifecycle. `status` alone could not express
  /// "expired", "revoked for a reason" or "how was access obtained";
  /// `assertActiveEnrollment` now checks all three, so a refund, a manual
  /// revocation or an expiry refuses new content access immediately.
  expiresAt     DateTime?               @map("expires_at")
  revokedAt     DateTime?               @map("revoked_at")
  revokeReason  EnrollmentRevokeReason? @map("revoke_reason")
  accessSource  EnrollmentAccessSource  @default(free) @map("access_source")
  courseOrderId String?                 @map("course_order_id")
  courseOrder   CourseOrder?            @relation(fields: [courseOrderId], references: [id], onDelete: SetNull)
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  progress       CourseProgress?
  LessonProgress LessonProgress[]
  certificate    Certificate?

  @@unique([studentId, courseId])
  @@index([courseOrderId])
  @@index([studentId, status])
  /// Phase 4.5.1 (scalability). `courseId` is an FK with no backing index —
  /// Postgres does not auto-index FK columns — so every course-scoped
  /// enrollment read fell back to a full-table-order scan of
  /// `enrollments_student_id_course_id_key` (leading column `studentId`,
  /// useless for a `courseId`-only lookup) or a Seq Scan. Verified live via
  /// `EXPLAIN ANALYZE` against the real dev database (see
  /// `ATLAS_SCALABILITY_PHASE_4_5_1_REPORT.md`): cost dropped from 168 to 22
  /// (buffers 33→2) for `InstructorRepository.countActiveEnrollmentsForCourse`,
  /// and the `TenantUsageRecomputeService`/RLS `can_access_quiz` course-join
  /// path went from a full-order index scan (cost 27.86) to a real indexed
  /// nested loop (cost 14.38) — both now cost-proportional to the matching
  /// course's own rows, not total platform enrollments. `status` is the
  /// second column because every real caller (`countActiveEnrollmentsForCourse`,
  /// `findEnrolledStudents`, the instructor distinct-student-count query,
  /// `TenantUsageRecomputeService.computeLiveCounts`) filters `courseId`
  /// together with `status` in the same query — never `courseId` alone. An
  /// `academyId` index was considered and rejected this phase: empirically
  /// verified (temporary index, rolled back) to provide zero measured
  /// benefit for the only theoretical consumer (`enrollments_tenant_select`
  /// RLS policy evaluated with no other predicate) because that policy is
  /// OR'd with `enrollments_instructor_select`'s non-indexable
  /// `is_course_instructor(course_id, ...)` function call, which forces a
  /// Seq Scan regardless of any index on `academyId` — a distinct,
  /// deferred, RLS-compounding finding (same class as the already-fixed
  /// P7/P24c pattern), not something a new index alone can address.
  @@index([courseId, status])
  @@map("enrollments")
}

enum EnrollmentStatus {
  available
  pending
  enrolled
  completed
  unavailable

  @@map("enrollment_status")
}

/// P64 Phase 1 — why an enrollment stopped granting access.
enum EnrollmentRevokeReason {
  refund
  manual
  membership_ended
  expired
  suspended

  @@map("enrollment_revoke_reason")
}

/// P64 Phase 1 — how the enrollment was obtained.
enum EnrollmentAccessSource {
  free
  order
  manual
  seed

  @@map("enrollment_access_source")
}

/// Mirrors `CourseProgress` (`progress.types.ts`) — a materialized summary
/// row per enrollment, updated transactionally within the same request that
/// changes it (lesson completed), never lazily derived on read (master plan
/// §5.3's explicit instruction for this table).
model CourseProgress {
  enrollmentId      String                @id @map("enrollment_id")
  enrollment        Enrollment            @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  totalLessons      Int                   @map("total_lessons")
  completedLessons  Int                   @default(0) @map("completed_lessons")
  percentage        Decimal               @default(0) @db.Decimal(5, 2)
  currentLessonId   String?               @map("current_lesson_id")
  completionState   CourseCompletionState @default(incomplete) @map("completion_state")
  certificateStatus CertificateStatus     @default(unavailable) @map("certificate_status")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  /// P64 Phase 2 — real time on task, accumulated from the same bounded
  /// heartbeat deltas that feed `lesson_progress.watchedSeconds`, and the
  /// timestamp the learner dashboard's "continue learning" ordering uses.
  /// `updatedAt` cannot serve that purpose: it also moves when a
  /// recompute rewrites percentages for every enrollment at once.
  timeSpentSeconds Int       @default(0) @map("time_spent_seconds")
  lastActivityAt   DateTime? @map("last_activity_at")

  /// P64 Phase 3 (AD-11) — when the completion rule was last satisfied and
  /// the overall score the evaluator computed (null when no scored item
  /// takes part in the rule).
  completedAt  DateTime? @map("completed_at")
  overallScore Decimal?  @map("overall_score") @db.Decimal(5, 2)

  /// The whole sequence the learner works through — published lessons,
  /// quizzes and assignments — and how many are finished (a completed
  /// lesson, a passed or awaiting-grade quiz, a submitted assignment). What
  /// `percentage` is computed from; lesson counts alone say "0 of 0" for a
  /// quiz-only course.
  totalItems     Int @default(0) @map("total_items")
  completedItems Int @default(0) @map("completed_items")

  @@map("course_progress")
}

enum CourseCompletionState {
  incomplete
  in_progress
  completed

  @@map("course_completion_state")
}

enum CertificateStatus {
  unavailable
  eligible
  issued
  revoked

  @@map("certificate_status")
}

/// Mirrors `LessonProgress` (`progress.types.ts`), one row per (enrollment,
/// lesson) — materialized at enrollment time for every published lesson in
/// the course, not created lazily on first access, so the curriculum
/// sidebar (`CurriculumNav.tsx`) always has a complete status list to
/// render, including locked lessons the student hasn't reached yet.
model LessonProgress {
  id           String               @id @default(uuid())
  enrollmentId String               @map("enrollment_id")
  enrollment   Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String               @map("lesson_id")
  lesson       CourseLesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sectionId    String               @map("section_id")
  courseId     String               @map("course_id")
  status       LessonProgressStatus @default(locked)
  completedAt  DateTime?            @map("completed_at")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  /// P64 Phase 2 — server-recorded playback EVIDENCE (Phase 2 §D.6).
  ///
  /// Every one of these is written from bounded heartbeat deltas computed
  /// on the server, never from a number the client simply asserts: a
  /// client that claims it watched an hour in ten seconds moves these by
  /// the wall-clock gap, not by its claim. That is what makes
  /// `maxWatchedRatio` usable as a completion GATE rather than a
  /// decoration.
  ///
  /// `lastPositionSeconds` is where playback resumes (the learner's last
  /// known position, which may move backwards when they rewind).
  /// `watchedSeconds` only ever increases and is the sum of credited
  /// deltas. `maxWatchedRatio` is the furthest credited fraction of the
  /// lesson's duration, kept as a high-water mark so a rewind can never
  /// take a completion away.
  lastPositionSeconds Int       @default(0) @map("last_position_seconds")
  watchedSeconds      Int       @default(0) @map("watched_seconds")
  maxWatchedRatio     Decimal   @default(0) @map("max_watched_ratio") @db.Decimal(5, 4)
  lastActivityAt      DateTime? @map("last_activity_at")

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId, status])
  @@map("lesson_progress")
}

/// P64 Phase 2 (AD-3) — the lesson payload itself, moved OUT of
/// `course_lessons.content_url`.
///
/// This table exists because the old shape could not be secured. A
/// `content_url` on the lesson row is a durable, guessable, permanently
/// valid address: once a curriculum response had handed it over, an
/// enrollment could be revoked, refunded or expired and the URL kept
/// working forever, for anyone it had been forwarded to. Worse, the
/// lesson row is legitimately readable by anyone browsing a published,
/// public course — so the payload inherited a public audience from its
/// container.
///
/// Separating them lets the two have DIFFERENT audiences: the lesson row
/// stays publicly listable (title, order, duration, preview flag) while
/// its content has NO public RLS policy at all and is reachable only
/// through `LessonContentService.getContent()`, which re-decides
/// entitlement at the moment the bytes are asked for (AD-2).
model LessonContent {
  id           String            @id @default(uuid())
  lessonId     String            @unique @map("lesson_id")
  lesson       CourseLesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  /// Denormalised from the lesson's own section/course. Present so every
  /// RLS policy and every protected object key can be decided from THIS
  /// row without a join — a policy that has to join to find its tenant is
  /// a policy that evaluates the joined table's policies too, which is
  /// exactly the class of mistake Phase 1 spent two corrective migrations
  /// removing.
  courseId     String            @map("course_id")
  course       Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academyId    String            @map("academy_id")
  academy      Academy           @relation(fields: [academyId], references: [id], onDelete: Cascade)
  kind         LessonContentKind
  /// Sanitised rich text for `kind: text`. Server-sanitised on write.
  bodyHtml     String?           @map("body_html")
  /// The protected object for `kind: file` (and the poster/source for a
  /// video lesson whose asset is not provider-hosted).
  mediaAssetId String?           @map("media_asset_id")
  mediaAsset   MediaAsset?       @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  /// `kind: external` only — a third-party embed Atlas does not host.
  /// Surfaced to the learner as explicitly NOT protected, because
  /// pretending otherwise would be the dishonest option.
  externalUrl  String?           @map("external_url")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@index([academyId, courseId])
  @@index([mediaAssetId])
  @@map("lesson_contents")
}

/// Downloadable attachments for one lesson. Same audience rules as
/// `lesson_contents` — no public policy, one signed URL per request.
model LessonResource {
  id           String       @id @default(uuid())
  lessonId     String       @map("lesson_id")
  lesson       CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  courseId     String       @map("course_id")
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academyId    String       @map("academy_id")
  academy      Academy      @relation(fields: [academyId], references: [id], onDelete: Cascade)
  title        String
  mediaAssetId String?      @map("media_asset_id")
  mediaAsset   MediaAsset?  @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  externalUrl  String?      @map("external_url")
  order        Int          @default(0)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([lessonId, order])
  @@index([academyId, courseId])
  @@index([mediaAssetId])
  @@map("lesson_resources")
}

/// Every content-access DECISION, granted or refused (Phase 2 §D.2).
///
/// Refusals alone would be the obvious thing to log and the wrong one:
/// the abuse this table has to make visible is a legitimate account
/// pulling grants at a rate no human watches at (Phase 2 §U's "p99 > 40
/// per 10 minutes"), and every one of those is a GRANT. Retention is 90
/// days — long enough to investigate a sharing report, short enough that
/// the table is not a permanent record of what every learner read.
model ContentAccessLog {
  id           String              @id @default(uuid())
  userId       String?             @map("user_id")
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  academyId    String              @map("academy_id")
  academy      Academy             @relation(fields: [academyId], references: [id], onDelete: Cascade)
  courseId     String              @map("course_id")
  lessonId     String              @map("lesson_id")
  result       ContentAccessResult
  /// The machine-readable refusal reason (`notEnrolled`, `locked`,
  /// `deviceLimit`, …) or, for a grant, the kind that was signed. Closed
  /// vocabulary from `ContentAccessReason`, never free text.
  reason       String?
  /// The device and session the decision was made for. Null when the
  /// request carried no device cookie, which is itself worth seeing.
  deviceId     String?             @map("device_id")
  sessionId    String?             @map("session_id")
  /// P64 Phase 2 (D10) — WHICH TIER AND PROVIDER served this decision.
  ///
  /// Required because Normal and Premium assets coexist inside one academy
  /// (D11), so "was this lesson delivered under the protection we sold
  /// them?" is a question the log has to be able to answer. Null for a
  /// refusal that never reached an asset, and for text lessons, which have
  /// no provider.
  securityTier VideoSecurityTier?  @map("security_tier")
  provider     MediaAssetProvider? @map("provider")
  createdAt    DateTime            @default(now()) @map("created_at")

  @@index([academyId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("content_access_log")
}

/// One browser (or app) a learner has registered with an academy (AD-10).
///
/// Identified by a SERVER-ISSUED opaque cookie, never by a fingerprint.
/// That is a deliberate privacy choice as well as a correctness one:
/// fingerprints are both unreliable and collected without consent,
/// whereas a cookie Atlas minted is something the learner can see listed,
/// name, and remove — which is precisely the Devices page this phase
/// ships.
///
/// Scoped per academy, because the device allowance is the academy's
/// policy to set (D8) and a learner studying at two academies must not
/// have one academy's limit consume the other's.
model StudentDevice {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  academyId  String    @map("academy_id")
  academy    Academy   @relation(fields: [academyId], references: [id], onDelete: Cascade)
  /// SHA-256 of the opaque cookie value. Hashed at rest for the same
  /// reason `refresh_tokens.token_hash` is: a database read must not yield
  /// a credential that can be replayed.
  cookieHash String    @unique @map("cookie_hash")
  /// What the learner sees in the list. Derived from the User-Agent
  /// ("Chrome on macOS"), renameable by the learner.
  label      String
  userAgent  String?   @map("user_agent")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  /// Set when the learner removes the device, or an owner resets the
  /// registry. Rows are never hard-deleted: a removed device that comes
  /// back must register again and count against the cap again, and the
  /// audit trail of what was removed when has to survive.
  revokedAt  DateTime? @map("revoked_at")

  refreshTokens RefreshToken[]

  @@index([userId, academyId, revokedAt])
  @@index([academyId, revokedAt])
  @@map("student_devices")
}

/// How many devices and concurrent sessions a learner may use (D4/D8).
///
/// Resolved most-specific-first — academy, then plan, then platform — and
/// an academy row may never exceed the platform row's values. Enforcing
/// the ceiling in the resolver rather than in a check constraint is
/// deliberate: the platform maximum is itself a row that can change, and
/// a constraint would have to be rewritten every time it did.
model AccessPolicy {
  id                    String            @id @default(uuid())
  scope                 AccessPolicyScope
  /// Set only when `scope` is `academy`. One policy row per academy.
  academyId             String?           @unique @map("academy_id")
  academy               Academy?          @relation(fields: [academyId], references: [id], onDelete: Cascade)
  /// Set only when `scope` is `plan` — reserved (Phase 2 §D.7); no plan
  /// row is seeded, and the resolver simply finds none.
  planKey               String?           @map("plan_key")
  maxDevices            Int               @map("max_devices")
  maxConcurrentSessions Int               @map("max_concurrent_sessions")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  @@index([scope])
  @@map("access_policies")
}

enum LessonProgressStatus {
  locked
  available
  in_progress
  completed

  @@map("lesson_progress_status")
}

/// Mirrors `Quiz` (`quiz.types.ts`). Read-only through P6-P23; Phase 4 (P24,
/// master plan §22/§24) adds the real write path
/// (`QuizzesService.createQuiz`/`updateQuiz`/`deleteQuiz`), gated by the new
/// `can_author_course_content()` RLS function — the course's assigned
/// instructor(s), or the owning academy's owner/administrator/manager.
/// `sectionId` is an optional plain categorization column (not a
/// `@relation`), matching how `Course.instructors` etc. keep denormalized/
/// optional pointers plain rather than adding a reverse relation array to
/// `CourseSection` for a field nothing cascades on.
model Quiz {
  id           String         @id @default(uuid())
  courseId     String         @map("course_id")
  course       Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sectionId    String?        @map("section_id")
  /// Optional unit placement. Deleting a unit SetNulls this (the quiz
  /// survives as a course-level quiz), never destroys the quiz.
  section      CourseSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  status       QuizStatus     @default(draft)
  passingScore Int?           @map("passing_score")
  maxAttempts  Int?           @map("max_attempts")
  /// Shared unit-curriculum ordinal (P52): one order space per unit across
  /// lessons/quizzes/assignments/live-sessions. Meaningless when sectionId
  /// is null (course-level, not placed in any unit).
  order        Int            @default(0)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  /// P64 Phase 3 (§D.1) — the quiz settings model. Every default
  /// reproduces the pre-Phase-3 behaviour: no timer, no window, no
  /// shuffle, every question, score shown at once, correct answers never
  /// shown, integrity off, nothing required for progression or completion.
  mode                  QuizMode             @default(practice)
  timeLimitSeconds      Int?                 @map("time_limit_seconds")
  availableFrom         DateTime?            @map("available_from")
  availableUntil        DateTime?            @map("available_until")
  dueAt                 DateTime?            @map("due_at")
  latePolicy            AssessmentLatePolicy @default(accept_flagged) @map("late_policy")
  gradingPolicy         QuizGradingPolicy    @default(highest) @map("grading_policy")
  shuffleQuestions      Boolean              @default(false) @map("shuffle_questions")
  shuffleOptions        Boolean              @default(false) @map("shuffle_options")
  questionsPerAttempt   Int?                 @map("questions_per_attempt")
  layout                QuizLayout           @default(all_questions)
  showScore             QuizDisclosure       @default(immediately) @map("show_score")
  showAnswers           QuizDisclosure       @default(never) @map("show_answers")
  showExplanations      Boolean              @default(false) @map("show_explanations")
  integrityMode         QuizIntegrityMode    @default(off) @map("integrity_mode")
  maxViolations         Int                  @default(3) @map("max_violations")
  requireFullscreen     Boolean              @default(false) @map("require_fullscreen")
  requiredToProgress    Boolean              @default(false) @map("required_to_progress")
  requiredForCompletion Boolean              @default(false) @map("required_for_completion")
  hideTimer             Boolean              @default(false) @map("hide_timer")

  questions QuizQuestion[]
  attempts  QuizAttempt[]
  results   QuizResult[]
  overrides QuizStudentOverride[]

  @@index([courseId, status])
  @@index([sectionId, order])
  @@map("quizzes")
}

enum QuizStatus {
  draft
  published

  @@map("quiz_status")
}

/// P64 Phase 3 — quiz settings vocabularies (§D.1).
enum QuizMode {
  practice
  exam

  @@map("quiz_mode")
}

enum QuizLayout {
  all_questions
  one_per_page

  @@map("quiz_layout")
}

/// Which attempt counts as THE result of a quiz (AD-8 grading policies).
enum QuizGradingPolicy {
  highest
  latest
  first
  average

  @@map("quiz_grading_policy")
}

/// When a score / the correct answers may be disclosed to the learner.
enum QuizDisclosure {
  immediately
  after_due
  after_attempts_exhausted
  never

  @@map("quiz_disclosure")
}

/// AD-9 integrity tiers. `off` records nothing; `monitor` records;
/// `warn` records and warns; `strict` auto-submits at the threshold.
enum QuizIntegrityMode {
  off
  monitor
  warn
  strict

  @@map("quiz_integrity_mode")
}

/// Shared by quizzes and assignments: what happens after `due_at`.
enum AssessmentLatePolicy {
  block
  accept_flagged

  @@map("assessment_late_policy")
}

/// Mirrors `QuizQuestion` (`quiz.types.ts`). Real write path as of Phase 4
/// (P24) — see `Quiz`'s own doc comment.
model QuizQuestion {
  id        String           @id @default(uuid())
  quizId    String           @map("quiz_id")
  quiz      Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  prompt    String
  type      QuizQuestionType
  order     Int
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  /// P64 Phase 3 — points per question (default 1 reproduces "each
  /// question counts once"), an explanation disclosed by policy, the
  /// lesson a wrong answer points back to, and the accepted answers of a
  /// `short_answer` question (JSON string array, matched normalised).
  points          Int     @default(1)
  explanation     String?
  relatedLessonId String? @map("related_lesson_id")
  acceptedAnswers Json?   @map("accepted_answers")

  options QuizQuestionOption[]

  @@index([quizId, order])
  @@map("quiz_questions")
}

enum QuizQuestionType {
  single_choice
  multiple_choice
  true_false
  short_answer
  essay

  @@map("quiz_question_type")
}

/// Mirrors `QuizQuestionOption` (`quiz.types.ts`) **plus** `isCorrect` — the
/// one field the frontend structurally never receives. Security-critical:
/// any response returned to a student before they submit an attempt MUST
/// be projected through a dedicated response DTO that omits this column —
/// enforced in `quiz-question.contract.ts`, never a field-level "just don't
/// render it" convention (master plan §5.4/§16/§18 scenario 7, the
/// mandatory quiz-correctness projection test).
model QuizQuestionOption {
  id         String       @id @default(uuid())
  questionId String       @map("question_id")
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  isCorrect  Boolean      @default(false) @map("is_correct")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@map("quiz_question_options")
}

/// Mirrors `QuizAttempt` (`quiz.types.ts`). `answers` is kept as JSONB
/// (master plan §5.4: "write-once-then-read-only per attempt, never queried
/// by individual answer") rather than a normalized table — matches
/// `SubmitQuizAttemptPayload`'s own "no per-answer autosave contract"
/// shape exactly: one mutation fires on final submit.
model QuizAttempt {
  id            String            @id @default(uuid())
  quizId        String            @map("quiz_id")
  quiz          Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId     String            @map("student_id")
  student       User              @relation("QuizAttemptStudent", fields: [studentId], references: [id], onDelete: Cascade)
  status        QuizAttemptStatus
  answers       Json              @default("[]")
  score         Decimal?          @db.Decimal(5, 2)
  passed        Boolean?
  submittedAt   DateTime?         @map("submitted_at")
  attemptNumber Int               @map("attempt_number")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  /// P64 Phase 3 (AD-8) — the server-authoritative attempt. `startedAt`
  /// and `deadlineAt` come from the server clock; `questionIds` is the
  /// ordered set this attempt was seeded with; `settingsSnapshot` freezes
  /// the quiz settings at start so a mid-attempt edit never moves the
  /// goalposts; `answersRevision` is the monotonic autosave counter.
  startedAt           DateTime?            @map("started_at")
  deadlineAt          DateTime?            @map("deadline_at")
  seed                Int                  @default(0)
  settingsSnapshot    Json?                @map("settings_snapshot")
  questionIds         Json?                @map("question_ids")
  answersRevision     Int                  @default(0) @map("answers_revision")
  lastSavedAt         DateTime?            @map("last_saved_at")
  autoSubmitted       Boolean              @default(false) @map("auto_submitted")
  autoSubmittedReason String?              @map("auto_submitted_reason")
  isLate              Boolean              @default(false) @map("is_late")
  violationCount      Int                  @default(0) @map("violation_count")
  integrityFlagged    Boolean              @default(false) @map("integrity_flagged")
  pointsEarned        Decimal?             @map("points_earned") @db.Decimal(8, 2)
  pointsTotal         Decimal?             @map("points_total") @db.Decimal(8, 2)
  gradingStatus       AttemptGradingStatus @default(not_required) @map("grading_status")
  /// Manual points per question id (essay questions), entered by a reviewer.
  manualGrades        Json?                @map("manual_grades")
  gradedById          String?              @map("graded_by")
  gradedBy            User?                @relation("QuizAttemptGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  gradedAt            DateTime?            @map("graded_at")
  invalidatedAt       DateTime?            @map("invalidated_at")
  invalidatedById     String?              @map("invalidated_by")
  invalidatedBy       User?                @relation("QuizAttemptInvalidator", fields: [invalidatedById], references: [id], onDelete: SetNull)
  invalidationReason  String?              @map("invalidation_reason")

  events QuizAttemptEvent[]

  /// P64 Phase 1 — the attempt-number race fix: two concurrent starts can
  /// no longer both insert attempt N+1. A partial unique index (one
  /// `in_progress` attempt per student per quiz) lives in the migration
  /// SQL; Prisma cannot express partial indexes.
  @@unique([quizId, studentId, attemptNumber])
  @@index([studentId, quizId, attemptNumber])
  @@index([status, deadlineAt])
  @@map("quiz_attempts")
}

enum QuizAttemptStatus {
  not_started
  in_progress
  submitted
  passed
  failed
  expired
  invalidated

  @@map("quiz_attempt_status")
}

/// Mirrors `Assignment` (`assignment.types.ts`). Real write path as of
/// Phase 4 (P24) — see `Quiz`'s own doc comment; identical authorization.
/// `sectionId`/`lessonId` are optional plain categorization columns, same
/// "no reverse relation array for a field nothing cascades on" reasoning as
/// `Quiz.sectionId`.
model Assignment {
  id                    String               @id @default(uuid())
  courseId              String               @map("course_id")
  course                Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sectionId             String?              @map("section_id")
  /// Optional unit placement. Deleting a unit SetNulls this (the assignment
  /// survives as a course-level assignment), never destroys the assignment.
  section               CourseSection?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  lessonId              String?              @map("lesson_id")
  title                 String
  description           String?
  instructions          String?
  status                AssignmentStatus     @default(draft)
  dueAt                 DateTime?            @map("due_at")
  allowResubmission     Boolean              @default(false) @map("allow_resubmission")
  /// P64 Phase 3 (§D.4, S12) — `due_at` is finally enforced. The default
  /// reproduces today's behaviour (late work accepted) but now flags it.
  latePolicy            AssessmentLatePolicy @default(accept_flagged) @map("late_policy")
  requiredForCompletion Boolean              @default(false) @map("required_for_completion")
  /// Shared unit-curriculum ordinal (P52) — see Quiz.order.
  order                 Int                  @default(0)
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  submissions AssignmentSubmission[]

  @@index([courseId, status])
  @@index([sectionId, order])
  @@map("assignments")
}

enum AssignmentStatus {
  draft
  published

  @@map("assignment_status")
}

/// Mirrors `AssignmentSubmission` (`assignment.types.ts`) + the grading
/// columns master plan §5.4 specifies (`Grade`, kept as one entity from the
/// instructor's view — `AssignmentSubmissionReview`, P7 scope; none of the
/// grading fields are part of P6's own response contract, since the
/// student-facing `AssignmentSubmission` type has no score/feedback field).
/// `(assignment_id, student_id)` stays unconditionally unique — see this
/// section's header comment for why no history table exists.
model AssignmentSubmission {
  id                String                     @id @default(uuid())
  assignmentId      String                     @map("assignment_id")
  assignment        Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId         String                     @map("student_id")
  student           User                       @relation("SubmissionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  status            AssignmentSubmissionStatus
  response          String?
  attachmentUrl     String?                    @map("attachment_url")
  /// P64 Phase 3 — the protected attachment (S12): a media asset the
  /// student uploaded themselves into the protected tier. `attachmentUrl`
  /// stays for submissions made before Phase 3.
  attachmentAssetId String?                    @map("attachment_asset_id")
  attachmentAsset   MediaAsset?                @relation("SubmissionAttachment", fields: [attachmentAssetId], references: [id], onDelete: SetNull)
  isLate            Boolean                    @default(false) @map("is_late")
  draftResponse     String?                    @map("draft_response")
  draftSavedAt      DateTime?                  @map("draft_saved_at")
  submittedRevision Int                        @default(0) @map("submitted_revision")
  submittedAt       DateTime?                  @map("submitted_at")
  gradingStatus     SubmissionGradingStatus    @default(ungraded) @map("grading_status")
  score             Decimal?                   @db.Decimal(5, 2)
  feedback          String?
  gradedAt          DateTime?                  @map("graded_at")
  gradedBy          String?                    @map("graded_by")
  grader            User?                      @relation("SubmissionGrader", fields: [gradedBy], references: [id], onDelete: SetNull)
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

enum AssignmentSubmissionStatus {
  draft
  submitting
  submitted
  failed

  @@map("assignment_submission_status")
}

enum SubmissionGradingStatus {
  ungraded
  graded

  @@map("submission_grading_status")
}

/// P64 Phase 3 — manual-grading state of a quiz attempt (essay questions).
enum AttemptGradingStatus {
  not_required
  pending
  graded

  @@map("attempt_grading_status")
}

/// P64 Phase 3 (AD-9) — browser integrity signals recorded with BOTH the
/// client's timestamp and the server's. Detection tier: advisory, never
/// changes a score by itself; escalation acts only at configured thresholds.
model QuizAttemptEvent {
  id        String               @id @default(uuid())
  attemptId String               @map("attempt_id")
  attempt   QuizAttempt          @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  type      QuizAttemptEventType
  /// Whether this event counted toward the violation threshold (after
  /// debounce, warm-up and the sub-second visibility filter).
  counted   Boolean              @default(false)
  clientAt  DateTime?            @map("client_at")
  serverAt  DateTime             @default(now()) @map("server_at")
  payload   Json?

  @@index([attemptId, serverAt])
  @@index([serverAt])
  @@map("quiz_attempt_events")
}

enum QuizAttemptEventType {
  visibility_hidden
  visibility_visible
  blur
  focus
  fullscreen_exit
  fullscreen_enter
  /// The browser could not go full screen (no API, or the request was
  /// refused). Context for the reviewer, never a violation.
  fullscreen_unavailable
  copy
  paste
  cut
  contextmenu
  print
  heartbeat
  second_session
  device_change
  warning_acknowledged

  @@map("quiz_attempt_event_type")
}

/// P64 Phase 3 (AD-8) — the materialised result of a quiz for a student,
/// aggregated over their finalised attempts by the quiz's grading policy.
/// This is what completion rules and certificates read (never a single
/// attempt), so a retake changes the row only as the policy allows.
model QuizResult {
  id                 String   @id @default(uuid())
  quizId             String   @map("quiz_id")
  quiz               Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId          String   @map("student_id")
  student            User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attemptsCount      Int      @default(0) @map("attempts_count")
  bestScore          Decimal? @map("best_score") @db.Decimal(5, 2)
  latestScore        Decimal? @map("latest_score") @db.Decimal(5, 2)
  effectiveScore     Decimal? @map("effective_score") @db.Decimal(5, 2)
  passed             Boolean  @default(false)
  effectiveAttemptId String?  @map("effective_attempt_id")
  pendingGrading     Boolean  @default(false) @map("pending_grading")
  computedAt         DateTime @default(now()) @map("computed_at")

  @@unique([quizId, studentId])
  @@index([studentId])
  @@map("quiz_results")
}

/// P64 Phase 3 — per-student accommodations set by reviewers.
model QuizStudentOverride {
  id             String    @id @default(uuid())
  quizId         String    @map("quiz_id")
  quiz           Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId      String    @map("student_id")
  student        User      @relation("QuizOverrideStudent", fields: [studentId], references: [id], onDelete: Cascade)
  timeMultiplier Decimal   @default(1) @map("time_multiplier") @db.Decimal(4, 2)
  extraAttempts  Int       @default(0) @map("extra_attempts")
  availableFrom  DateTime? @map("available_from")
  availableUntil DateTime? @map("available_until")
  reason         String?
  createdById    String    @map("created_by")
  createdBy      User      @relation("QuizOverrideCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([quizId, studentId])
  @@map("quiz_student_overrides")
}

/// P64 Phase 3 (D6) — the academy's certificate identity on top of the
/// platform-standard layout: logo, signature, signatory, wording per
/// locale. Versioned so an issued certificate can name the exact template
/// it was rendered from.
model CertificateTemplate {
  id              String   @id @default(uuid())
  academyId       String   @map("academy_id")
  academy         Academy  @relation(fields: [academyId], references: [id], onDelete: Cascade)
  name            String
  logoUrl         String?  @map("logo_url")
  signatureUrl    String?  @map("signature_url")
  signatoryName   String?  @map("signatory_name")
  signatoryTitle  String?  @map("signatory_title")
  /// `{ en: { title, body }, ar: { title, body } }`
  wording         Json     @default("{}")
  /// Constrained certificate palette (4 roles). Defaults reproduce the
  /// original Atlas design exactly, so existing templates render unchanged.
  /// Primary = dominant brand colour (title, course, seal, primary rules);
  /// Accent = metallic foil accent (fine rules, corner marks, seal ring);
  /// Text = body/heading ink; Background = paper. Softer tints (secondary
  /// text, rules) are DERIVED from these at render time, never stored, so the
  /// set stays small and always internally consistent.
  primaryColor    String   @default("#1F4E5F") @map("primary_color")
  accentColor     String   @default("#B08A3E") @map("accent_color")
  textColor       String   @default("#14303A") @map("text_color")
  backgroundColor String   @default("#FCFBF7") @map("background_color")
  version         Int      @default(1)
  isDefault       Boolean  @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  courses Course[]

  @@index([academyId, isDefault])
  @@map("certificate_templates")
}

enum CertificateState {
  issued
  revoked

  @@map("certificate_state")
}

enum CertificateRenderStatus {
  pending
  ready
  failed

  @@map("certificate_render_status")
}

/// P64 Phase 3 (D6, D7) — one certificate per enrollment. `snapshot` is
/// the immutable issuance record (learner, course, academy, instructors,
/// completion date, score summary, template version); a later retake
/// never touches it, and regeneration is an explicit action that bumps
/// `version` while keeping the serial and verification code.
model Certificate {
  id               String                  @id @default(uuid())
  academyId        String                  @map("academy_id")
  academy          Academy                 @relation(fields: [academyId], references: [id], onDelete: Cascade)
  courseId         String                  @map("course_id")
  course           Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollmentId     String                  @unique @map("enrollment_id")
  enrollment       Enrollment              @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  studentId        String                  @map("student_id")
  student          User                    @relation("CertificateStudent", fields: [studentId], references: [id], onDelete: Cascade)
  serial           String
  verificationCode String                  @unique @map("verification_code")
  status           CertificateState        @default(issued)
  snapshot         Json
  templateId       String?                 @map("template_id")
  templateVersion  Int                     @default(1) @map("template_version")
  version          Int                     @default(1)
  locale           String                  @default("en")
  issuedAt         DateTime                @default(now()) @map("issued_at")
  issuedById       String?                 @map("issued_by")
  issuedBy         User?                   @relation("CertificateIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  revokedAt        DateTime?               @map("revoked_at")
  revokedById      String?                 @map("revoked_by")
  revokedBy        User?                   @relation("CertificateRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  revokeReason     String?                 @map("revoke_reason")
  renderStatus     CertificateRenderStatus @default(pending) @map("render_status")
  storageKey       String?                 @map("storage_key")
  renderedAt       DateTime?               @map("rendered_at")
  renderError      String?                 @map("render_error")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  @@unique([academyId, serial])
  @@index([studentId])
  @@index([academyId, issuedAt(sort: Desc)])
  @@index([courseId])
  @@map("certificates")
}

/// P64 Phase 3 — per-academy, per-year serial allocator (`WDA-2026-000123`).
model CertificateSerialCounter {
  academyId String  @map("academy_id")
  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  year      Int
  nextValue Int     @default(1) @map("next_value")

  @@id([academyId, year])
  @@map("certificate_serial_counters")
}

// ---------------------------------------------------------------------------
// Phase P7 — Instructor Operations & Community (master plan §5.5, §21
// Phase P7).
//
// "Instructor Operations" itself adds NO new table — `InstructorService`
// (roster/grading/submission-review) resolves teaching scope from the
// existing `course_instructors` (P5) and reads/writes the existing
// `enrollments`/`course_progress`/`quiz_attempts`/`assignment_submissions`
// (P6) tables; `assignment_submissions.grading_status`/`score`/`feedback`/
// `graded_at`/`graded_by` already exist (P6 schema, unused by any P6
// endpoint) — P7 is the first phase to write them, through a narrow
// `POST .../submissions/:id/grade` endpoint. See this migration's RLS
// block for the additive, `course_instructors`-keyed SELECT/UPDATE
// policies this requires on every one of those pre-existing tables — never
// writing to `course_instructors` itself, matching master plan §24's
// explicit, audited "resolves teaching scope from it, never writes it"
// rule.
//
// "Community" (`announcements`, `blog_posts`, `forums`/`forum_threads`/
// `forum_replies`) is the real new schema surface, per §5.5. All four are
// User-scoped like P6 (`TenancyContextService.runInUserContext`,
// `app.current_user_id`), NEVER `app.current_organization_id` — every one
// of these resources is reached through a flat (`blog-posts`) or
// course-nested (`announcements`, `forum`) route with no `:academyId`/
// `:organizationId` URL segment for an `AcademyScopeGuard`-style bootstrap
// to resolve org membership from (confirmed against the real frontend
// `AnnouncementService`/`BlogService`/`ForumService` — none of their
// methods takes an organization or academy id), and because a course's
// forum/announcements must be reachable by an enrolled STUDENT too, who is
// structurally never an `organization_memberships` row (the exact P6
// reasoning, reapplied). RLS below resolves every real ownership/
// visibility fact — academy staff membership, course-teaching scope, active
// enrollment, post authorship — via `EXISTS` subqueries keyed on
// `current_setting('app.current_user_id')`, never a second session
// variable.
// ---------------------------------------------------------------------------

/// Matches `AnnouncementAudience` (`announcement.types.ts`) exactly.
enum AnnouncementAudience {
  platform
  academy
  course

  @@map("announcement_audience")
}

/// Matches `AnnouncementStatus` (`announcement.types.ts`) exactly.
enum AnnouncementStatus {
  draft
  scheduled
  published
  archived

  @@map("announcement_status")
}

/// Mirrors `Announcement` (`announcement.types.ts`) field-for-field.
/// `academyId` is set for BOTH `audience: 'academy'` AND `audience:
/// 'course'` (denormalized from `course.academy_id` at creation time for
/// course-scoped rows — same "no join needed, no session-context
/// ambiguity" convention as `Enrollment.academyId`/`CourseLesson.courseId`)
/// — confirmed against the frontend `Announcement.academyId` field's own
/// doc comment ("Present only when audience is 'academy' or 'course'"),
/// which is the literal ground truth this schema matches, not master plan
/// §5.5's own shorthand ("exactly one of the two, or neither"). `courseId`
/// is set only for `audience: 'course'`. Both null only for `audience:
/// 'platform'`.
///
/// Authoring is course-scoped only in P7 — matches `AnnouncementService`'s
/// real frontend contract exactly (no academy- or platform-level create/
/// update endpoint exists there at all). The `academy`/`platform` audience
/// values and their columns are real, RLS-protected, and readable (a
/// platform-wide or academy-wide announcement could exist), but nothing in
/// this phase inserts one — mirrors the exact `course_categories`/
/// `course_instructors` "table real, write capability is a later phase's
/// job" precedent from P5.
model Announcement {
  id          String               @id @default(uuid())
  audience    AnnouncementAudience
  academyId   String?              @map("academy_id")
  academy     Academy?             @relation(fields: [academyId], references: [id], onDelete: Cascade)
  courseId    String?              @map("course_id")
  course      Course?              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId    String               @map("author_id")
  author      User                 @relation(fields: [authorId], references: [id])
  title       String
  body        String
  status      AnnouncementStatus   @default(draft)
  scheduledAt DateTime?            @map("scheduled_at")
  publishedAt DateTime?            @map("published_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@index([courseId, status])
  @@index([academyId, status])
  @@map("announcements")
}

/// Matches `BlogPostStatus` (`blog.types.ts`) exactly.
enum BlogPostStatus {
  draft
  /// Phase 6 — a real `scheduledAt` is set; the Phase 2 subscription-sweep
  /// tick (the one scheduled-task mechanism this codebase has — never a
  /// second scheduler) transitions this to `published` once `scheduledAt`
  /// has passed, exactly mirroring `Announcement`'s own pre-existing
  /// `scheduled` status and its own `scheduledAt` field.
  scheduled
  published
  archived

  @@map("blog_post_status")
}

/// Mirrors `BlogPost` (`blog.types.ts`) field-for-field — the dynamic,
/// permission-gated Knowledge Blog (`@features/blog`), distinct from the
/// pre-existing static, prerendered marketing blog (master plan §5.5's own
/// naming note). `academyId` absent = platform-level, matching the
/// frontend field's own doc comment. `CreateBlogPostPayload` carries no
/// `academyId` field at all — the owning academy is resolved server-side
/// from the author's own single staff `academy_members` row (`AuthorId`'s
/// own doc comment on `BlogService`: "Ownership... resolved server-side
/// from the authenticated session"); see `BlogPostsService` for the exact,
/// narrow rule this schema does not itself encode.
model BlogPost {
  id              String         @id @default(uuid())
  academyId       String?        @map("academy_id")
  academy         Academy?       @relation(fields: [academyId], references: [id], onDelete: Cascade)
  authorId        String         @map("author_id")
  author          User           @relation(fields: [authorId], references: [id])
  title           String
  slug            String
  excerpt         String?
  content         String
  featuredImage   String?        @map("featured_image_url")
  category        String?
  tags            String[]       @default([])
  status          BlogPostStatus @default(draft)
  /// Phase 6 — set only when `status = 'scheduled'`. The Phase 2
  /// subscription-sweep tick publishes this post once real wall-clock
  /// time passes it, exactly as it already does for `Announcement`.
  scheduledAt     DateTime?      @map("scheduled_at")
  /// Phase 6 — real, persisted SEO metadata (never frontend-only state).
  /// Each falls back to `title`/`excerpt`/`featuredImage` respectively
  /// when unset, matching `WebsitePage`'s own established SEO-field
  /// fallback convention.
  metaTitle       String?        @map("meta_title")
  metaDescription String?        @map("meta_description")
  ogImage         String?        @map("og_image_url")
  publishedAt     DateTime?      @map("published_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@unique([academyId, slug])
  @@map("blog_posts")
}

/// Phase 6 — the real backend destination the public website's Contact
/// section form submits to (previously intentionally a no-op: "no fake
/// backend" — see `ContactSection.tsx`'s own doc comment). A visitor
/// submission, never an Academy's OWN contact info (that is
/// `Academy.contactEmail`/`contactPhone`/`address`, already real and
/// persisted since Phase P19 — reused, not duplicated, by this phase's
/// header/footer/contact-section identity work).
enum ContactSubmissionStatus {
  new
  read
  archived

  @@map("contact_submission_status")
}

model ContactSubmission {
  id        String                  @id @default(uuid())
  academyId String                  @map("academy_id")
  academy   Academy                 @relation(fields: [academyId], references: [id], onDelete: Cascade)
  name      String
  email     String
  message   String
  status    ContactSubmissionStatus @default(new)
  createdAt DateTime                @default(now()) @map("created_at")

  @@index([academyId, status])
  @@map("contact_submissions")
}

/// TASK 7 — what a visitor to the Atlas marketing homepage asked about.
enum PlatformContactTopic {
  sales
  support
  partnership
  other

  @@map("platform_contact_topic")
}

/// TASK 7 — triage state of one marketing-site enquiry. Same vocabulary as
/// `ContactSubmissionStatus`, deliberately a separate type: the two inboxes
/// belong to different owners (an Academy vs. Atlas itself) and must be free
/// to diverge.
enum PlatformContactSubmissionStatus {
  new
  read
  archived

  @@map("platform_contact_submission_status")
}

/// TASK 7 — one enquiry sent through the Atlas marketing homepage's contact
/// form (`POST public/contact`), read by Platform Owners only
/// (`platform/contact-submissions`). Not tenant data: no organization, no
/// academy. RLS (see the migration): anyone may INSERT a fresh `new` row;
/// SELECT/UPDATE/DELETE require `is_platform_owner(app.current_user_id)`.
///
/// `organizationName` is deliberately NOT called `company`: `company` is the
/// form's honeypot field name. `ipHash` is a keyed SHA-256 of the client
/// address — the raw IP is never stored.
model PlatformContactSubmission {
  id               String                          @id @default(uuid())
  name             String                          @db.VarChar(200)
  /// Normalized (trimmed, lower-cased) before it is written.
  email            String                          @db.VarChar(320)
  organizationName String?                         @map("organization_name") @db.VarChar(200)
  topic            PlatformContactTopic
  message          String                          @db.VarChar(5000)
  /// `en` | `ar` — the language the visitor wrote from.
  locale           String                          @db.VarChar(8)
  /// The marketing path the form was sent from (path only, no query).
  sourcePath       String?                         @map("source_path") @db.VarChar(512)
  status           PlatformContactSubmissionStatus @default(new)
  ipHash           String                          @map("ip_hash") @db.VarChar(64)
  userAgent        String?                         @map("user_agent") @db.VarChar(512)
  readAt           DateTime?                       @map("read_at")
  createdAt        DateTime                        @default(now()) @map("created_at")

  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("platform_contact_submissions")
}

/// Matches `Forum['status']` (`forum.types.ts`) exactly.
enum ForumStatus {
  open
  locked
  archived

  @@map("forum_status")
}

/// Mirrors `Forum` (`forum.types.ts`) — one per course (`courseId` unique).
/// `academyId` is denormalized from `course.academy_id` at creation time —
/// same convention as `Announcement.academyId`/`Enrollment.academyId` —
/// used only to satisfy the frontend `Forum.academyId` field, never queried
/// for RLS (forum visibility resolves through `courseId` alone). No create
/// endpoint exists in `ForumService` — a course's forum row is created
/// lazily (get-or-create) the first time anyone with real course access
/// requests it, mirroring how `course_progress`/`lesson_progress` (P6) are
/// materialized on first legitimate access rather than pre-seeded.
model Forum {
  id          String      @id @default(uuid())
  courseId    String      @unique @map("course_id")
  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  academyId   String      @map("academy_id")
  title       String
  description String?
  status      ForumStatus @default(open)
  createdAt   DateTime    @default(now()) @map("created_at")

  threads ForumThread[]

  @@map("forums")
}

/// Mirrors `ForumThread` (`forum.types.ts`) field-for-field. `courseId` is
/// denormalized from `forum.course_id` — same "no extra join on the hot
/// read path" convention as every other course-nested table in this schema.
model ForumThread {
  id        String   @id @default(uuid())
  forumId   String   @map("forum_id")
  forum     Forum    @relation(fields: [forumId], references: [id], onDelete: Cascade)
  courseId  String   @map("course_id")
  authorId  String   @map("author_id")
  author    User     @relation(fields: [authorId], references: [id])
  title     String
  body      String
  pinned    Boolean  @default(false)
  locked    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  replies ForumReply[]

  @@index([forumId, pinned, createdAt])
  @@map("forum_threads")
}

/// Mirrors `ForumReply` (`forum.types.ts`) field-for-field.
model ForumReply {
  id        String      @id @default(uuid())
  threadId  String      @map("thread_id")
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String      @map("author_id")
  author    User        @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([threadId, createdAt])
  @@map("forum_replies")
}

// ---------------------------------------------------------------------------
// Phase P8 — Media Library & Object Storage (master plan §5.9, §13, §21
// Phase P8, ADR-005).
//
// Academy-scoped, org-context RLS — the exact same shape as `courses`
// (P5): `media_assets.academy_id → academies.organization_id`, resolved
// under `app.current_organization_id` via `AcademyScopeGuard`
// (`AcademyModule`, reused verbatim — `academies/:id/media*` is the same
// `:id`-is-the-academy-id route shape `CoursesController` already
// established). No new guard, no new session variable, no new tenancy
// model. Unlike P6/P7, nothing here needs to be reachable by a student or
// under `app.current_user_id` — the Media Library (per the real frontend
// contract, `MediaLibraryDialog`) is an academy-staff-only surface,
// embedded only inside website-builder form fields today.
//
// PostgreSQL stores metadata + `storage_key`/`url` only, never binary
// content (master plan §13's explicit justification). `storage_key`
// always looks like `academies/{academyId}/{uuid}.{ext}` — backend-
// generated only (`MediaService`), never a client-supplied path, so a
// leaked/guessed key from one academy is structurally unreachable for
// another even before RLS/auth is checked (§13's "Authorization" row).
// ---------------------------------------------------------------------------

/// Matches `MediaAssetType` (`media.types.ts`) exactly. `video` is a real,
/// representable value (the frontend type needs it to exist), but P8's
/// own upload path never produces one — no video upload pipeline exists
/// yet (master plan §13 V2, `SPECIFICATION-UNDEFINED`, §24) and the V1
/// MIME allowlist (`file-validation.util.ts`) deliberately excludes every
/// video MIME type. `other` is likewise representable but never produced
/// by this phase's classifier — reserved for a future upload path this
/// phase does not build.
enum MediaAssetType {
  image
  video
  document
  other

  @@map("media_asset_type")
}

/// Matches `MediaAssetStatus` (`media.types.ts`) exactly. Archive-only
/// lifecycle — no hard delete, matching `Course`/`Academy`'s own
/// precedent (master plan §13: "no hard delete, matching the frontend's
/// CMS rule extended to media").
enum MediaAssetStatus {
  active
  archived
  /// P64 Communications C6 — hosted video bytes were deleted after the
  /// retention window. The row is a tombstone: lessons say "removed after
  /// inactivity" instead of showing a broken player, and quota recompute
  /// ignores it.
  deleted

  @@map("media_asset_status")
}

/// P64 Phase 2 (AD-1, AD-3) — whether an object may be fetched by anyone
/// holding its URL, or only through an Atlas-signed, short-lived grant.
/// `public` is the pre-P64 behaviour and stays valid for marketing images,
/// logos and course thumbnails; `protected` objects live in a separate
/// bucket with no public base URL at all, so a leaked key is not a
/// leaked file.
enum MediaAssetAccess {
  public
  protected

  @@map("media_asset_access")
}

/// P64 Phase 2 (D10) — the COMMERCIAL family a plan belongs to.
///
/// Atlas sells two families, each with the same three tiers, giving six
/// variants. The family decides the VIDEO SECURITY CAPABILITY CLASS; the
/// tier decides commercial limits and features. They are two independent
/// axes precisely so the catalog does not have to duplicate six sets of
/// business rules — one family value and one tier value describe any
/// variant.
enum PlanFamily {
  normal
  premium

  @@map("plan_family")
}

/// P64 Phase 2 (D10) — the commercial tier, independent of the family.
///
/// `basic` is the tier the repository's seeded plan key calls `starter`;
/// the seeded keys are deliberately NOT renamed (DL-17), because renaming
/// a plan key would break every subscription row that references it for
/// no product benefit.
enum PlanTier {
  basic
  growth
  enterprise

  @@map("plan_tier")
}

/// P64 Phase 2 (AD-15, D10) — WHAT ATLAS PROMISES for a video asset.
///
/// Deliberately NOT the same thing as `MediaAssetProvider`, which records
/// where the bytes physically live. Two reasons they must stay separate:
///
///   1. If Atlas later moves the Normal tier to a different provider,
///      every customer's promise is unchanged while every asset's provider
///      changes. Collapsing them would make that migration a
///      customer-facing event.
///   2. A learner asking "is this video protected?" must be told the truth
///      about THAT video. Deriving the answer from the academy's current
///      plan would lie about every asset created before a plan change
///      (D11: a plan change never rewrites history).
enum VideoSecurityTier {
  normal
  premium

  @@map("video_security_tier")
}

/// P64 Phase 2 (D5) — HOW a video's duration was established.
///
/// The quota is denominated in minutes, so duration is a billing-relevant
/// number and "who said so" matters. `measured` is the provider's own
/// figure; `parsed` is Atlas reading the container's metadata; `declared`
/// is the uploader's word, which is never silently trusted — it is
/// recorded so an operator can see the quota drifting toward
/// self-reported.
enum VideoDurationSource {
  measured
  parsed
  declared

  @@map("video_duration_source")
}

/// Where the bytes actually live. `r2` is Atlas's own object storage;
/// `cloudflare_stream` is the provider-hosted video path. The column
/// exists so the grant signer can pick a signer without inspecting the
/// storage key, and so a SECOND video provider is a new value here plus a
/// new adapter — never a change to the tables above it.
enum MediaAssetProvider {
  /// Atlas's own object storage, delivered by a presigned URL. Protected
  /// FILES (lesson attachments, documents) take this path.
  r2
  /// P64 Phase 2 (DL-19) — the NORMAL video tier: the same R2 object, but
  /// delivered through the Cloudflare CDN behind an Atlas-controlled
  /// Worker gate. A distinct value from `r2` because the delivery path and
  /// therefore the enforced capabilities genuinely differ: a presign is
  /// bound to time alone, while the Worker re-authorizes every request and
  /// can revoke before expiry.
  r2_worker
  /// The PREMIUM video tier — provider-hosted, provider-processed.
  cloudflare_stream

  @@map("media_asset_provider")
}

/// Lifecycle of a provider-hosted asset. `pending` covers the window
/// between Atlas reserving quota and the upload actually starting, which
/// is why quota counts it (AD-14).
enum MediaProcessingStatus {
  pending
  processing
  ready
  failed

  @@map("media_processing_status")
}

/// How a lesson is allowed to become `completed`. `manual` is the pre-P64
/// behaviour — the learner presses the button. `watched_ratio` additionally
/// requires server-recorded evidence that enough of the video was actually
/// watched; the button is still there, but it refuses below the minimum.
enum LessonCompletionRule {
  manual
  watched_ratio

  @@map("lesson_completion_rule")
}

/// What a lesson actually delivers. Deliberately WIDER than
/// `CourseLessonContentType` (text/video/file): `external` is a real,
/// distinct case — an embed Atlas does not host and therefore cannot
/// protect — and the learner is told so rather than being left to assume
/// the protection applies.
enum LessonContentKind {
  text
  video
  file
  external

  @@map("lesson_content_kind")
}

/// The outcome recorded for one content-access decision. Every decision is
/// logged, not just the refusals: a grant flood is only visible if the
/// grants are there to count.
enum ContentAccessResult {
  granted
  refused

  @@map("content_access_result")
}

/// Which population an `access_policies` row governs. Resolution is
/// most-specific-first (`academy` beats `plan` beats `platform`) and an
/// academy may never exceed the platform row's maximums (D4/D8).
/// `plan` exists as a reserved scope: the resolver already honours it, so
/// a future plan-tier policy is a data row rather than a code change.
enum AccessPolicyScope {
  platform
  plan
  academy

  @@map("access_policy_scope")
}

/// Mirrors `MediaAssetSummary`/`MediaAssetDetail` (`media.types.ts`)
/// field-for-field — the frontend has no separate detail shape (`type
/// MediaAssetDetail = MediaAssetSummary`), so this one model backs both
/// `GET .../media` and `GET .../media/:id`. `width`/`height` are
/// deliberately nullable, populated asynchronously by `media-worker`
/// after upload (master plan §13: "Image handling: dimension/thumbnail
/// extraction async, never inline in the upload request") — never
/// guessed or computed synchronously in the request/response cycle.
model MediaAsset {
  id         String           @id @default(uuid())
  academyId  String           @map("academy_id")
  academy    Academy          @relation(fields: [academyId], references: [id], onDelete: Cascade)
  type       MediaAssetType
  status     MediaAssetStatus @default(active)
  fileName   String           @map("file_name")
  /// The object-storage key (`academies/{academyId}/{uuid}.{ext}`) — kept
  /// separate from `url` so the CDN/domain can change without a data
  /// migration (master plan §5.9's own explicit reasoning).
  storageKey String           @map("storage_key")
  url        String
  altText    String?          @map("alt_text")
  mimeType   String           @map("mime_type")
  /// `bigint` at rest (master plan §5.9) — a real file size, never
  /// meaningfully bounded by a 32-bit int.
  sizeBytes  BigInt           @map("size_bytes")
  width      Int?
  height     Int?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  /// P64 Phase 2 (AD-1/AD-3). Everything that existed before this phase is
  /// `public` + `r2` + `ready`, which is exactly what the backfill sets and
  /// exactly what those rows already were — no behaviour changes for them.
  ///
  /// `access` decides WHICH bucket and WHICH signer; `provider` decides
  /// WHO stores the bytes. They are separate because a protected file and a
  /// protected video are both protected but are signed completely
  /// differently (R2 presign vs. provider token), and collapsing them into
  /// one column would force the signer to parse the storage key.
  access           MediaAssetAccess      @default(public)
  provider         MediaAssetProvider    @default(r2)
  /// The provider's own identifier — Cloudflare Stream's `uid`. Null for
  /// `r2`, whose identity is its `storageKey`.
  providerId       String?               @map("provider_id")
  processingStatus MediaProcessingStatus @default(ready) @map("processing_status")
  /// Video length in seconds.
  ///
  /// While `processingStatus` is `pending`/`processing` this holds the
  /// RESERVED maximum the uploader asked for, not a measured value — that
  /// is what makes "usage = ready minutes + active reservations" (AD-14) a
  /// single SUM over one column rather than two tables that can disagree.
  /// The provider webhook replaces it with the real duration, which is the
  /// reconciliation step D5 requires.
  durationSeconds  Int?                  @map("duration_seconds")
  /// Set when the asset was uploaded FOR a specific course, so a protected
  /// object key can be prefixed by academy AND course (H) and so quota
  /// reconciliation can attribute a video without walking lessons.
  courseId         String?               @map("course_id")
  /// P64 Phase 2 (AD-15) — WHAT ATLAS PROMISED for this asset, as distinct
  /// from `provider`, which records where its bytes are.
  ///
  /// Null for everything that is not hosted video (documents, images, the
  /// protected file tier), because a security TIER is a video product
  /// concept and claiming one for a PDF would be meaningless.
  ///
  /// Set once, at creation, from the academy's entitled tier — and never
  /// rewritten when the academy's plan changes (D11). That is the whole
  /// point: an academy that downgrades keeps its existing Premium videos
  /// on the Premium path, and a learner is told the truth about the video
  /// in front of them rather than about a subscription.
  securityTier     VideoSecurityTier?    @map("security_tier")
  /// P64 Phase 2 (D5) — how `durationSeconds` was established. See
  /// `VideoDurationSource`. Null while a reservation still holds a
  /// declared maximum rather than a real figure.
  durationSource   VideoDurationSource?  @map("duration_source")
  /// P64 Phase 3 (S12) — who uploaded this object (students' submission attachments); null for staff/library uploads made before Phase 3.
  uploadedByUserId String?               @map("uploaded_by_user_id")
  course           Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)
  /// P64 Communications C6 — retention tombstone facts. Set only after the
  /// provider confirmed the bytes are gone; a failed attempt records
  /// `deletionFailedAt` and leaves `status` untouched.
  deletedAt        DateTime?             @map("deleted_at")
  deletionReason   String?               @map("deletion_reason")
  deletionFailedAt DateTime?             @map("deletion_failed_at")
  bytesFreed       BigInt?               @map("bytes_freed")

  /// Phase 12 — set when this asset was imported from a session recording.
  liveSessionRecordingFiles LiveSessionRecordingFile[]

  /// P64 Phase 2 — the protected payloads that point at this asset.
  lessonContents        LessonContent[]
  lessonResources       LessonResource[]
  lessonVideoFor        CourseLesson[]
  introVideoForCourses  Course[]               @relation("CourseIntroVideo")
  submissionAttachments AssignmentSubmission[] @relation("SubmissionAttachment")

  @@index([academyId, status, type])
  /// P64 Phase 2 — the quota query: every ready-or-reserved video for one
  /// organization's academies, summed by duration. Without this it is a
  /// sequential scan of every asset the platform holds on every upload.
  @@index([academyId, provider, processingStatus])
  /// P64 Phase 2 — "which of this academy's videos are on which tier",
  /// the query a tier migration and the staff library both need.
  @@index([academyId, securityTier])
  @@index([uploadedByUserId])
  @@map("media_assets")
}

// ---------------------------------------------------------------------------
// P9 — Website Builder & Theme Engine (master plan §5.10, §21 Phase P9).
//
// `website_configurations` (PK: `academy_id`, 1:1 with `Academy` — matches
// `WebsiteConfiguration.academyId`, `academy.types.ts`'s "one Academy = one
// website" design). `theme_key`/`theme_version` are plain config fields, not
// a theme catalog table — the frontend's five built-in themes
// (`WEBSITE_THEME_KEYS`, `website-theme.types.ts`) are a client-side,
// code-registered catalog (`WebsiteThemeRegistry`); the backend never
// re-derives or serves theme *definitions*, only records which one this
// Academy picked (master plan §21 P9: "only implement what the frontend
// already defines").
//
// `website_pages` stores `sections` as validated JSONB
// (`SectionInstance[]`), never normalized into per-section-type tables —
// sections are read/written atomically as one page save (`updatePage`
// PATCHes the whole array), matching §5.10's explicit "kept as validated
// JSONB, not normalized" instruction. Every write is validated server-side
// against the exact discriminated-union shape
// (`SectionType` → `SectionConfigMap[type]`) the frontend's own
// `website-section.schemas.ts` enforces — see
// `src/website/validation/section-config.schemas.ts`, a field-for-field
// backend reproduction of that file, never a looser reinterpretation.
//
// Six core page types (`WEBSITE_CORE_PAGE_TYPES`, `website.types.ts`) exist
// per Academy, auto-provisioned the first time either the configuration or
// the page list is read for an Academy that has none yet (no dedicated
// "create website" endpoint exists anywhere in the real
// `WebsiteConfigurationService` contract) — see `WebsiteBootstrapService`.
// `courseDetails` is the one core type with no `visible` toggle in the real
// UI (`WebsitePagesPage.tsx` renders a lock icon, not a `Switch`, for it) —
// enforced here by simply never accepting a visibility change for it at the
// service layer, not a separate schema constraint.
//
// Custom pages support a REAL hard delete (`DELETE
// academies/:id/website/pages/:pageId`, `useDeleteWebsitePage.ts`) — this is
// a deliberate, discovery-driven departure from the Course/Media
// "archive-only, no DELETE policy" convention: direct inspection of the
// actual frontend service proves a genuine hard-delete capability exists
// for custom pages (core pages are rejected at the service layer, matching
// the UI's own "no delete button for a core page" rule). The DELETE RLS
// policy below exists for exactly this reason.
// ---------------------------------------------------------------------------

/// Matches `WebsitePublishStatus` (`website.types.ts`) exactly.
enum WebsitePublishStatus {
  draft
  published
  publishing
  failed

  @@map("website_publish_status")
}

/// Matches `WebsitePageType` (`website.types.ts`) exactly.
enum WebsitePageType {
  core
  custom

  @@map("website_page_type")
}

/// Matches `WEBSITE_CORE_PAGE_TYPES` (`website.types.ts`) exactly — the six
/// core page contracts every theme supports.
enum WebsiteCorePageType {
  home
  about
  courses
  faqs
  contact
  courseDetails

  @@map("website_core_page_type")
}

/// Mirrors `WebsiteConfiguration` (`website.types.ts`) field-for-field —
/// always the current DRAFT working copy (never what is published).
/// `brand`/`seo`/`navigation`/`header`/`footer` are validated JSONB
/// (`WebsiteBrandConfig`/`WebsiteSeoConfig`/`WebsiteNavigationItem[]`/
/// `WebsiteHeaderConfig`/`WebsiteFooterConfig`), validated server-side
/// against the same Zod shapes the frontend's `website.schemas.ts` already
/// enforces before being persisted.
model WebsiteConfiguration {
  academyId         String               @id @map("academy_id")
  academy           Academy              @relation(fields: [academyId], references: [id], onDelete: Cascade)
  themeKey          String               @map("theme_key")
  themeVersion      Int                  @map("theme_version")
  configVersion     Int                  @default(1) @map("config_version")
  /// Theme 1 plan §D.2 — which template (and version) first generated this
  /// website's starter pages. NULL = not recorded (created before this
  /// column, or never generated). Stamped once by `WebsiteGenerationService`.
  templateKey       String?              @map("template_key")
  templateVersion   Int?                 @map("template_version")
  brand             Json
  seo               Json
  navigation        Json
  header            Json
  footer            Json
  status            WebsitePublishStatus @default(draft)
  publishedAt       DateTime?            @map("published_at")
  /// Mirrors `WebsitePublishError` (`{messageKey, detail?}`) — only ever
  /// set when `status = 'failed'`.
  lastPublishError  Json?                @map("last_publish_error")
  /// What visitors see: `{themeKey, themeVersion, brand, seo, navigation,
  /// header, footer}` copied from the working copy above at the last
  /// publish. The public runtime reads ONLY this, so saving the working
  /// copy never changes the live site until the owner publishes.
  publishedSnapshot Json?                @map("published_snapshot")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@map("website_configurations")
}

/// Mirrors `WebsitePage` (`website.types.ts`) field-for-field. `sections`
/// is the full `SectionInstance[]` array, validated server-side (see this
/// file's own doc comment above) before every write.
model WebsitePage {
  id                String               @id @default(uuid())
  academyId         String               @map("academy_id")
  academy           Academy              @relation(fields: [academyId], references: [id], onDelete: Cascade)
  pageType          WebsitePageType      @map("page_type")
  /// Present only when `pageType = 'core'` — matches `WebsitePage.coreType`
  /// (`readonly coreType?: WebsiteCorePageType`) exactly.
  coreType          WebsiteCorePageType? @map("core_type")
  title             String
  slug              String
  visible           Boolean              @default(true)
  seo               Json
  sections          Json
  /// Optimistic-concurrency token. Incremented on every write and compared
  /// on every update — a save carrying a stale value is refused rather than
  /// silently overwriting whoever saved in between. Mirrors
  /// `website_configurations.config_version`, deliberately.
  version           Int                  @default(1)
  /// The published copy of this page (title, slug, visibility, SEO and
  /// sections at its last publish). Null = never published: the page is
  /// not on the public site. `publishedVersion` is the `version` that was
  /// published, so `publishedVersion != version` means unpublished edits.
  publishedTitle    String?              @map("published_title")
  publishedSlug     String?              @map("published_slug")
  publishedVisible  Boolean?             @map("published_visible")
  publishedSeo      Json?                @map("published_seo")
  publishedSections Json?                @map("published_sections")
  publishedVersion  Int?                 @map("published_version")
  publishedAt       DateTime?            @map("published_at")
  /// Who saved this page last — so a save conflict can name them instead of
  /// telling the loser of the race to go hunting. Nullable: rows that
  /// predate the column have no honest value, and NULL renders as the
  /// neutral wording rather than attributing the change to nobody.
  updatedById       String?              @map("updated_by_id")
  updatedBy         User?                @relation("WebsitePageUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@unique([academyId, slug])
  @@index([academyId, pageType])
  @@map("website_pages")
}

// ---------------------------------------------------------------------------
// P10 — CMS Content Library & SEO (master plan §5.10, §21 Phase P10).
//
// `website_faq_entries`/`website_testimonial_entries` are Academy-scoped
// reusable CMS library content — distinct from a `WebsitePage`'s own
// inline `FaqItem`/`TestimonialItem` section content (P9, unchanged),
// which stays single-locale and page-authored. A library entry is
// authored once, independently localized in English and Arabic
// (`LocalizedText { en, ar }`, matching `website-content.types.ts`
// exactly), and referenced by id from any number of `faq`/`testimonials`
// sections across a website via `libraryEntryIds`
// (`FaqSectionConfig`/`TestimonialsSectionConfig`, §5.10) — resolved live
// at render time, never duplicated into the section's own stored data.
//
// SEO resolution (Page/Entity Override → Global → System Fallback) and
// structured-data (JSON-LD) builders are deliberately NOT new database
// structures — direct inspection of the real frontend confirms
// `resolvePageSeo`/`resolveCourseSeo`/`buildOrganizationJsonLd`/
// `buildCourseJsonLd`/`buildBreadcrumbJsonLd` are pure, client-side
// functions operating entirely on data the P9 endpoints already return
// (`website_configurations.seo`, `website_pages.seo`, the existing
// `Course`/`Academy` domains) — there is no backend "resolve SEO" or
// "structured data" HTTP endpoint anywhere in the real contract. P10's
// backend equivalent (`src/website/seo/`) is therefore a pure,
// dependency-free utility library only, ready for P11's public runtime to
// import — never persisted, never exposed through a new controller.
// ---------------------------------------------------------------------------

/// Matches `WebsiteContentStatus` (`website-content.types.ts`) exactly.
/// `archived` is terminal and non-destructive — there is no hard-delete
/// endpoint anywhere in the real `WebsiteContentService` contract.
enum WebsiteContentStatus {
  draft
  published
  archived

  @@map("website_content_status")
}

/// Mirrors `WebsiteFaqEntry` (`website-content.types.ts`) field-for-field.
/// `order` has no uniqueness constraint — it is a plain sort key, resorted
/// by the real UI via pairwise swaps (`WebsiteFaqContentTab.moveItem`),
/// never a bulk-reorder endpoint (unlike `WebsitePage.sections`, P9).
model WebsiteFaqEntry {
  id        String               @id @default(uuid())
  academyId String               @map("academy_id")
  academy   Academy              @relation(fields: [academyId], references: [id], onDelete: Cascade)
  /// `LocalizedText { en, ar }` — both languages always present.
  question  Json
  answer    Json
  order     Int                  @default(0)
  visible   Boolean              @default(true)
  status    WebsiteContentStatus @default(draft)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@index([academyId, status])
  @@index([academyId, order])
  @@map("website_faq_entries")
}

/// Mirrors `WebsiteTestimonialEntry` (`website-content.types.ts`)
/// field-for-field. `authorName` is a plain string (NOT localized — the
/// frontend type itself declares it `readonly authorName: string`, not
/// `LocalizedText`, unlike every other content field here); `authorRole`
/// and `avatar` are optional, matching the frontend type's own `?`.
model WebsiteTestimonialEntry {
  id         String               @id @default(uuid())
  academyId  String               @map("academy_id")
  academy    Academy              @relation(fields: [academyId], references: [id], onDelete: Cascade)
  quote      Json
  authorName String               @map("author_name")
  /// `LocalizedText { en, ar }`, nullable — only when omitted entirely.
  authorRole Json?                @map("author_role")
  /// Reuses the existing website image-asset convention (base64/`MediaAsset.url`) — never a second upload pipeline.
  avatar     String?
  order      Int                  @default(0)
  visible    Boolean              @default(true)
  status     WebsiteContentStatus @default(draft)
  createdAt  DateTime             @default(now()) @map("created_at")
  updatedAt  DateTime             @updatedAt @map("updated_at")

  @@index([academyId, status])
  @@index([academyId, order])
  @@map("website_testimonial_entries")
}

// ---------------------------------------------------------------------------
// P11 — Public Website Runtime, Domains & Edge (master plan §5.11, §7,
// §21 Phase P11).
//
// `subdomain_allocations`/`domain_connections` reuse the exact vocabulary
// the real frontend already defines (`domain.types.ts`, reusing
// `DomainStatus`/`DomainVerificationRecord`/`DomainConnection`/
// `SubdomainAllocation` from `provisioning.types.ts` verbatim — this
// schema does the same: one status enum, not a parallel one). Subdomain
// ALLOCATION (writing a `subdomain_allocations` row) is P14's job
// (Provisioning Orchestration) — confirmed by direct inspection: the real
// `DomainService` (frontend) has no "allocate subdomain" method at all,
// only `getDomainConfiguration`/`addCustomDomain`/`removeCustomDomain`/
// `verifyDomain`. P11 only reads whatever a future P14 populates here
// (honestly nothing, in every environment today) — the table exists now
// because the master plan's schema requires it and
// `AcademyDomainConfiguration.subdomain` already has a real, live
// frontend consumer expecting to read it.
//
// `domain_connections` IS written by P11 — `addCustomDomain`/
// `removeCustomDomain`/`verifyDomain` are real, shipped frontend methods.
// "Remove" resets the row to its `not_configured` state rather than a
// hard delete (no DELETE RLS policy exists on this table, consistent
// with the archive-only convention P8/P10 already established, and the
// row's `academy_id` uniqueness makes an actual delete pointless — the
// Academy will only ever have zero-or-one domain_connections row for its
// entire lifetime).
// ---------------------------------------------------------------------------

/// Matches `SubdomainStatus` (`provisioning.types.ts`) exactly.
enum SubdomainStatus {
  suggested
  available
  unavailable
  reserved
  assigned

  @@map("subdomain_status")
}

/// Matches `DomainStatus` (`provisioning.types.ts`) exactly — the real
/// 7-value enum, reused verbatim, never redeclared.
enum DomainStatus {
  not_configured
  pending
  verification_required
  verifying
  connected
  failed
  disconnected

  @@map("domain_status")
}

/// Matches `SslStatus` (`domain.types.ts`) exactly. `not_configured` is
/// the only honest value while no real Cloudflare/CA integration is
/// connected — nothing in this phase can move a domain past it without a
/// genuine provider check.
enum SslStatus {
  not_configured
  pending
  provisioning
  active
  failed
  expired

  @@map("ssl_status")
}

/// Matches `CdnStatus` (`domain.types.ts`) exactly.
enum CdnStatus {
  not_configured
  active
  degraded
  error

  @@map("cdn_status")
}

/// Matches `InfrastructureProviderName` (`domain.types.ts`) exactly — a
/// single-entry union today, extensible without touching existing rows.
enum InfrastructureProviderName {
  cloudflare

  @@map("infrastructure_provider_name")
}

/// Mirrors `SubdomainAllocation` (`provisioning.types.ts`) field-for-field.
/// Written by a future P14, read by P11's `DomainService.
/// getDomainConfiguration` — see this section's doc comment above.
model SubdomainAllocation {
  id        String          @id @default(uuid())
  academyId String          @unique @map("academy_id")
  academy   Academy         @relation(fields: [academyId], references: [id], onDelete: Cascade)
  subdomain String          @unique
  status    SubdomainStatus
  /// Full backend-resolved host (e.g. `harvard.atlas.dev`) — never
  /// constructed on the frontend from a guessed root domain.
  fullHost  String?         @map("full_host")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@map("subdomain_allocations")
}

/// Mirrors `DomainConnection` (`provisioning.types.ts`) plus the SSL/CDN
/// fields `AcademyDomainConfiguration` (`domain.types.ts`) layers on top
/// — the master plan's own §5.11 schema keeps these on the same row
/// (`ssl_status`, `cdn_status`, `cdn_provider`), never a separate table.
model DomainConnection {
  id                    String                      @id @default(uuid())
  academyId             String                      @unique @map("academy_id")
  academy               Academy                     @relation(fields: [academyId], references: [id], onDelete: Cascade)
  hostname              String?                     @unique
  status                DomainStatus                @default(not_configured)
  /// `DomainVerificationRecord[]` (`{type, name, value}`) — display data
  /// only, generated from the real Cloudflare custom-hostname response,
  /// never fabricated locally.
  verificationRecords   Json?                       @map("verification_records")
  sslStatus             SslStatus                   @default(not_configured) @map("ssl_status")
  cdnStatus             CdnStatus                   @default(not_configured) @map("cdn_status")
  cdnProvider           InfrastructureProviderName? @map("cdn_provider")
  connectedAt           DateTime?                   @map("connected_at")
  /// P63 — the provider's own id for this custom hostname (Cloudflare
  /// Custom Hostname id). Lets re-check/disconnect address the exact
  /// resource instead of searching by hostname; `null` when the provider
  /// never accepted the hostname (e.g. no credentials configured).
  providerHostnameId    String?                     @map("provider_hostname_id")
  /// P63 — when Atlas last asked the provider about this hostname (manual
  /// "check now", operator check, or the verification sweep). `null` until
  /// the first check. What the customer and the Platform Owner see as
  /// "last checked".
  lastCheckedAt         DateTime?                   @map("last_checked_at")
  /// P63 — a stable, non-sensitive error code for the latest failed check
  /// (`provider_unavailable`, `provider_hostname_missing`, …). Never a raw
  /// provider message, never a credential. `null` after a successful check.
  lastCheckError        String?                     @map("last_check_error")
  /// P63c — the provider's own numeric error code for the latest refused
  /// registration/lookup (a number, never a message). `null` when none.
  lastProviderErrorCode String?                     @map("last_provider_error_code")
  /// P63 — result of Atlas's own outbound HTTPS probe of the hostname
  /// (`https://{hostname}/`): `true` reachable with a valid certificate,
  /// `false` not reachable, `null` never probed. Real telemetry, not a
  /// derived guess.
  httpsReachable        Boolean?                    @map("https_reachable")
  httpsCheckedAt        DateTime?                   @map("https_checked_at")
  /// P63d — the HTTP status the probe received (e.g. Cloudflare's 525 when
  /// the edge could not complete the origin handshake). `null` when no
  /// response arrived or the hostname was never probed. A 5xx is recorded
  /// as NOT reachable: the edge answered, the website did not.
  httpsStatusCode       Int?                        @map("https_status_code")
  /// P63d — why the last probe found the hostname unreachable, as one of
  /// `HTTPS_FAILURE_REASONS` (`origin_error`, `tls_failed`, …). `null` when
  /// reachable or never probed.
  httpsFailureReason    String?                     @map("https_failure_reason")
  /// P63g — consecutive checks that ended in a recorded error (provider
  /// refusal, provider error, DNS not pointing, …). Drives the sweep's
  /// exponential backoff so an abandoned or permanently refused hostname
  /// is not re-asked every five minutes forever. Reset to 0 by any
  /// successful check.
  consecutiveFailures   Int                         @default(0) @map("consecutive_failures")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")

  @@index([status])
  @@index([lastCheckedAt])
  @@map("domain_connections")
}

/// P63g — a provider resource Atlas has stopped using and must delete at
/// the provider: written in the SAME transaction as the replace/remove/
/// archive/operator-release that gave the hostname up, attempted right
/// after commit, and retried by the verification sweep until the provider
/// confirms the resource is gone (or reports it never existed). This is
/// what makes "release" safe: nothing is ever deleted at the provider
/// before the database has durably recorded the customer's intent, and a
/// failed delete can never silently orphan an active hostname at the edge.
model DomainProviderRelease {
  id                 String    @id @default(uuid())
  academyId          String    @map("academy_id")
  academy            Academy   @relation(fields: [academyId], references: [id], onDelete: Cascade)
  hostname           String
  providerHostnameId String?   @map("provider_hostname_id")
  /// `replaced` | `removed` | `archived` | `operator_release`
  reason             String
  attempts           Int       @default(0)
  lastAttemptedAt    DateTime? @map("last_attempted_at")
  /// A stable code (`provider_unavailable`, `provider_error`, `hostname_mismatch`), never a provider message.
  lastError          String?   @map("last_error")
  releasedAt         DateTime? @map("released_at")
  /// `deleted` | `not_found` | `reassigned` — how the release concluded.
  outcome            String?
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([releasedAt])
  @@index([academyId])
  @@map("domain_provider_releases")
}

/// Platform-owned singleton — mirrors `TrialPolicy` (P4) exactly: a fixed,
/// well-known id read/written via `upsert`, never a find-then-create race.
/// Not tenant-scoped, no RLS — matches `TrialPolicy`/`SchemaMeta`'s own
/// identical "platform-infrastructure metadata, not tenant data" rule.
model PlatformDomainConfiguration {
  id                   String    @id @default(uuid())
  baseDomain           String?   @map("base_domain")
  configured           Boolean   @default(false)
  updatedAt            DateTime  @updatedAt @map("updated_at")
  /// P63g — when the verification sweep last finished a tick, and what it
  /// did (`{considered, checked, changed, failed, releasesProcessed,
  /// durationMs}`). The Platform Owner readiness page shows it, so a
  /// silently vanished repeatable job is visible instead of inferred from
  /// customer complaints.
  lastSweepCompletedAt DateTime? @map("last_sweep_completed_at")
  lastSweepResult      Json?     @map("last_sweep_result")

  @@map("platform_domain_configuration")
}

// ---------------------------------------------------------------------------
// Phase P12 — Atlas Subscription Billing (master plan §5.7, §21 Phase P12).
//
// The money flow that already has a complete frontend contract: an
// Organization buys Atlas (a plan subscription or catalog add-on), via
// manual bank/wallet transfer, reviewed by a Platform Owner. Deliberately
// NOT Course Commerce (§23/P13) — `payments.organization_id` stays
// required/non-null in this phase; the `payer_user_id`/`payee_academy_id`
// extension §5.7 documents is P13's job, not this one's.
//
// `payment_methods` is additive beyond §5.7's own table list, required by
// the real, callable `GET /payment-methods` contract (`PaymentService.
// getPaymentMethods`) — mirrors the `plans`/`add_ons` catalog-table
// precedent exactly (platform-owned, no RLS), since `manualInstructions`
// must be real backend-supplied configuration, never hardcoded in the
// frontend (`BankTransferInstructions`'s own doc comment).
//
// `payment_webhook_events` is additive beyond §5.7 too, required by §12's
// own "Payment webhook processing" row ("Unique constraint on (provider,
// event_id)") and §18 scenario 8 ("a webhook received twice must never
// double-apply"). See migration.sql's own header comment for the RLS
// design, including the one new `SECURITY DEFINER` function this phase
// introduces (`resolve_payment_organization`) and the reused `app.current_
// user_id` + new `is_platform_owner` function pairing for
// `PlatformPaymentService`'s cross-tenant review surface.
// ---------------------------------------------------------------------------

/// What a Checkout is paying for — matches `CheckoutTargetType` (`checkout.types.ts`) exactly.
enum CheckoutTargetType {
  plan_subscription
  add_on

  @@map("checkout_target_type")
}

/// Matches `CheckoutStatus` (`checkout.types.ts`) exactly.
enum CheckoutStatus {
  draft
  pending_payment
  completed
  expired
  cancelled

  @@map("checkout_status")
}

/// Matches `PaymentMethodType` (`payment.types.ts`) exactly. Only the two
/// `manual_*` values are ever produced by this phase — `gateway` exists so
/// the schema/DTOs are ready before a real gateway is connected (master
/// plan §21 P12: "not yet connected").
enum PaymentMethodType {
  manual_bank_transfer
  manual_wallet_transfer
  /// InstaPay transfer to an InstaPay address (2 Oct 2026).
  manual_instapay
  gateway

  @@map("payment_method_type")
}

/// Matches `PaymentLifecycleStatus` (`payment.types.ts`) exactly — 9 states.
enum PaymentLifecycleStatus {
  created
  pending
  processing
  requires_action
  requires_confirmation
  succeeded
  failed
  cancelled
  expired

  @@map("payment_lifecycle_status")
}

/// Matches `ManualReviewStatus` (`payment.types.ts`) exactly.
enum ManualReviewStatus {
  not_required
  pending
  approved
  rejected

  @@map("manual_review_status")
}

/// Matches `PaymentAttemptStatus` (`payment.types.ts`) exactly.
enum PaymentAttemptStatus {
  initiated
  processing
  failed
  succeeded
  cancelled
  expired

  @@map("payment_attempt_status")
}

/// Matches `InvoiceStatus` (`payment.types.ts`) exactly.
enum InvoiceStatus {
  draft
  issued
  paid
  void

  @@map("invoice_status")
}

/// Platform-owned catalog entity — mirrors `plans`/`add_ons`'s precedent
/// exactly (no RLS; every authenticated caller reads the same catalog).
/// Backs `GET /payment-methods` (`CheckoutPaymentMethod`, `payment.types.ts`).
/// Not named in master plan §5.7's own table list, but required by the real
/// frontend contract — see this section's header comment above.
model PaymentMethod {
  id                 String            @id @default(uuid())
  key                String            @unique
  type               PaymentMethodType
  displayName        String            @map("display_name")
  description        String?
  enabled            Boolean           @default(true)
  /// Matches `Payment.provider`/`CheckoutPaymentMethod.provider` — `'atlas_manual'` for both manual methods today.
  provider           String
  /// Mirrors `PaymentMethodCapabilities` — 9 booleans, validated server-side, not schema-enforced (matches `plans.limits`'s established precedent).
  capabilities       Json
  /// Mirrors `ManualPaymentInstructions` (bank or wallet variant) — present only for the two `manual_*` types, never for `gateway`.
  manualInstructions Json?             @map("manual_instructions")
  displayOrder       Int               @default(0) @map("display_order")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@map("payment_methods")
}

/// Organization-scoped — mirrors `Checkout` (`checkout.types.ts`) field-for-field (master plan §5.7). No update endpoint exists for the frontend to call directly — `status` transitions happen server-side as a Payment against it progresses.
model Checkout {
  id             String                    @id @default(uuid())
  organizationId String                    @map("organization_id")
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targetType     CheckoutTargetType        @map("target_type")
  targetKey      String                    @map("target_key")
  billingCycle   SubscriptionBillingCycle? @map("billing_cycle")
  /// Frozen `CheckoutSnapshot` — written once at creation, never recomputed from live catalog data afterward (master plan §5.7).
  snapshot       Json
  status         CheckoutStatus            @default(draft)
  expiresAt      DateTime                  @map("expires_at")
  idempotencyKey String                    @map("idempotency_key")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  payments Payment[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId])
  @@map("checkouts")
}

/// Mirrors `Payment` (`payment.types.ts`) — the provider-agnostic core, one
/// shape for manual and gateway payments. Originally `organizationId`
/// required/non-null (P12) — Phase P13 (master plan §5.7's own documented
/// "Extension point for §23") makes it nullable and adds `payerUserId`/
/// `payeeAcademyId` (Course Commerce's buyer/seller pair) plus the §4.2
/// commission-snapshot columns, so ONE table continues to serve both money
/// flows (ADR-010) rather than a parallel `course_payments` table. A
/// database `CHECK` constraint (see this phase's migration.sql — Prisma's
/// schema language has no CHECK-constraint syntax) enforces exactly one of
/// `(organizationId)` or `(payerUserId, payeeAcademyId)` is populated per
/// row, keeping the two flows structurally distinguishable even though
/// they share a table, matching §5.7's own instruction verbatim.
model Payment {
  id                                String                 @id @default(uuid())
  checkoutId                        String?                @map("checkout_id")
  checkout                          Checkout?              @relation(fields: [checkoutId], references: [id])
  /// Atlas-subscription-billing flow only (P12) — null for a Course
  /// Commerce (P13) row, which uses `payerUserId`/`payeeAcademyId` instead.
  organizationId                    String?                @map("organization_id")
  organization                      Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Course Commerce (P13) only — the student who owes this Payment.
  payerUserId                       String?                @map("payer_user_id")
  payer                             User?                  @relation("PaymentPayer", fields: [payerUserId], references: [id])
  /// Course Commerce (P13) only — the Academy this Payment is ultimately for (never a raw banking destination, just the revenue-attribution key `revenue_ledger_entries` also uses).
  payeeAcademyId                    String?                @map("payee_academy_id")
  payeeAcademy                      Academy?               @relation(fields: [payeeAcademyId], references: [id])
  /// Course Commerce (P13) only — the CourseOrder this Payment is an attempt toward. Nullable/one-to-many, mirroring `checkoutId`'s own "a Checkout may see more than one Payment attempt" shape.
  courseOrderId                     String?                @map("course_order_id")
  courseOrder                       CourseOrder?           @relation(fields: [courseOrderId], references: [id])
  methodKey                         String                 @map("method_key")
  methodType                        PaymentMethodType      @map("method_type")
  provider                          String
  amountMinorUnits                  BigInt                 @map("amount_minor_units")
  currency                          String                 @map("currency")
  status                            PaymentLifecycleStatus @default(created)
  reviewStatus                      ManualReviewStatus     @default(not_required) @map("review_status")
  failureReason                     String?                @map("failure_reason")
  /// The latest manual review's notes, denormalized here for `Payment.reviewNotes` (frontend doc comment: "the Tenant needs to see why a rejection happened without a second fetch").
  reviewNotes                       String?                @map("review_notes")
  /// Mirrors `PaymentNextAction` — a discriminated union, validated server-side, not schema-enforced.
  nextAction                        Json?                  @map("next_action")
  /// The manual-transfer instructions the payer was shown when this payment
  /// was created — kept with the payment so a later edit or disabling of
  /// the method never changes what this payer was asked to do.
  instructionsSnapshot              Json?                  @map("instructions_snapshot")
  /// Academy Manual Payments — the academy's own method this payment was
  /// taken with (`provider = 'academy_manual'`). Null for every other row.
  academyPaymentMethodId            String?                @map("academy_payment_method_id")
  academyPaymentMethod              AcademyPaymentMethod?  @relation(fields: [academyPaymentMethodId], references: [id], onDelete: SetNull)
  providerReference                 String?                @map("provider_reference")
  expiresAt                         DateTime?              @map("expires_at")
  /// §4.1 snapshot — which payment-collection mode was effective for the
  /// Organization at the moment this Payment was created. Null for P12
  /// Atlas-subscription-billing rows (that flow predates and is outside
  /// the §4.1 mode concept entirely). Frozen, never recomputed (§4.2's
  /// "freeze at creation" discipline).
  paymentCollectionModeSnapshot     PaymentCollectionMode? @map("payment_collection_mode_snapshot")
  /// §4.2 snapshot — the effective Atlas commission rate resolved at
  /// creation time. Null when no commission applies (Organization-Owned
  /// Gateway mode, or a non-course-order Payment) — never a stray `0` used
  /// to mean two different things.
  commissionRateBasisPointsSnapshot Int?                   @map("commission_rate_basis_points_snapshot")
  /// §4.2 snapshot — `applyBasisPoints(amountMinorUnits, commissionRateBasisPointsSnapshot)`, computed once and frozen alongside the rate it came from.
  commissionAmountMinorUnits        BigInt?                @map("commission_amount_minor_units")
  createdAt                         DateTime               @default(now()) @map("created_at")
  updatedAt                         DateTime               @updatedAt @map("updated_at")

  attempts                      PaymentAttempt[]
  proofs                        PaymentProof[]
  reviews                       PaymentReview[]
  invoices                      TenantInvoice[]
  webhookEvents                 PaymentWebhookEvent[]
  refunds                       CourseOrderRefund[]
  RevenueLedgerEntry            RevenueLedgerEntry[]
  /// Phase P14 — Provisioning Orchestration (master plan §5.11/§21). Present only when a ProvisioningRequest's `triggeringPaymentId` references this row.
  triggeredProvisioningRequests ProvisioningRequest[]

  @@index([organizationId])
  @@index([checkoutId])
  @@index([payerUserId])
  @@index([courseOrderId])
  @@index([academyPaymentMethodId])
  @@map("payments")
}

/// Mirrors `PaymentAttempt` (`payment.types.ts`) — one provider interaction attempt toward completing a Payment.
model PaymentAttempt {
  id                String               @id @default(uuid())
  paymentId         String               @map("payment_id")
  payment           Payment              @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  status            PaymentAttemptStatus
  providerReference String?              @map("provider_reference")
  failureReason     String?              @map("failure_reason")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  @@index([paymentId])
  @@map("payment_attempts")
}

/// Mirrors `PaymentProof` (`payment.types.ts`) — a manual-transfer proof of payment.
model PaymentProof {
  id             String   @id @default(uuid())
  paymentId      String   @map("payment_id")
  payment        Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  fileName       String   @map("file_name")
  /// Private object-storage key — never a public asset path (master plan §5.7/§13: "private, signed-URL access only"). Served only through the authenticated `.../proof/file` download endpoint (`PaymentProofsController`), never returned as a raw storage URL.
  storageKey     String   @map("storage_key")
  mimeType       String   @map("mime_type")
  note           String?
  /// The transfer's reference / transaction number as the payer typed it (Academy Manual Payments). Optional.
  payerReference String?  @map("payer_reference")
  uploadedAt     DateTime @default(now()) @map("uploaded_at")

  @@index([paymentId])
  @@map("payment_proofs")
}

/// Mirrors `PaymentReview` (`payment.types.ts`) — an admin's manual-review decision on a Payment.
model PaymentReview {
  id         String             @id @default(uuid())
  paymentId  String             @map("payment_id")
  payment    Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  status     ManualReviewStatus
  reviewedBy String             @map("reviewed_by")
  reviewer   User               @relation("PaymentReviewer", fields: [reviewedBy], references: [id])
  notes      String?
  reviewedAt DateTime           @default(now()) @map("reviewed_at")

  @@index([paymentId])
  @@map("payment_reviews")
}

/// Mirrors `TenantInvoice` (`payment.types.ts`) — read-only, invoice-ready
/// contract. No invoice-generation endpoint/trigger is specified anywhere
/// (frontend's own `Reports/ARCHITECTURE.md` Backend Contract #7: "Read-
/// only; no invoice-generation endpoint defined here") — this table ships
/// real and RLS-protected, genuinely empty until a future phase defines
/// when/how a row gets created (same "no creation endpoint yet" precedent
/// as P4's `TenantSubscription`).
model TenantInvoice {
  id               String        @id @default(uuid())
  organizationId   String        @map("organization_id")
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentId        String?       @map("payment_id")
  payment          Payment?      @relation(fields: [paymentId], references: [id])
  number           String        @unique
  status           InvoiceStatus @default(draft)
  amountMinorUnits BigInt        @map("amount_minor_units")
  currency         String        @map("currency")
  issuedAt         DateTime?     @map("issued_at")
  dueAt            DateTime?     @map("due_at")
  paidAt           DateTime?     @map("paid_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("tenant_invoices")
}

/// Processed-webhook-event idempotency ledger (master plan §12 "Payment
/// webhook processing": "Unique constraint on (provider, event_id)"; §18
/// scenario 8). `organizationId` is denormalized from the referenced
/// Payment purely so this table can reuse the exact same tenant-scoped RLS
/// idiom as every other table in this section — never read/written by
/// anything except `PaymentWebhookService`, which resolves it via the one
/// `SECURITY DEFINER` exception this phase introduces (migration.sql).
model PaymentWebhookEvent {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String
  eventId        String       @map("event_id")
  eventType      String       @map("event_type")
  paymentId      String       @map("payment_id")
  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  processedAt    DateTime     @default(now()) @map("processed_at")

  @@unique([provider, eventId])
  @@index([organizationId])
  @@map("payment_webhook_events")
}

// ---------------------------------------------------------------------------
// Organization Payment Configuration (master plan §5.8, §4.1/§4.2 — the
// finalized two-mode payment-collection decision, prerequisite to Phase
// P13). Deliberately NOT Course Commerce (§23) — no `course_orders`, no
// `revenue_ledger_entries`, no payout tables here. Pure configuration:
// which of the two Organization-level modes an Organization has chosen
// (§4.1), its own-gateway credentials if it chose Organization-Owned
// Gateway, its Atlas Payments connected-account reference if it chose
// Atlas Payments, and its commission override (§4.2) — Platform-Owner-
// controlled, never self-service.
// ---------------------------------------------------------------------------

/// Matches the finalized §4.1 three-state model exactly. `unconfigured` is
/// the real default every Organization starts in — never nullable-as-a-
/// mode, and never silently treated as either real mode.
enum PaymentCollectionMode {
  unconfigured
  atlas_payments
  organization_gateway
  /// Academy Manual Payments (Oct 2026) — a SNAPSHOT value only, written on
  /// a course payment taken with one of the academy's own manual methods
  /// (`academy_payment_methods`): the learner paid the academy directly and
  /// the Client Owner reviews. Never an organization setting — the
  /// `PATCH payment-settings` DTO lists the three settable modes explicitly.
  academy_manual

  @@map("payment_collection_mode")
}

/// Lifecycle of an Organization's own-gateway configuration (§5.8).
enum OrganizationGatewayCredentialStatus {
  not_configured
  configured
  verified
  disabled

  @@map("organization_gateway_credential_status")
}

/// Atlas Payments custodial/onboarding lifecycle (§5.8) — schema/service
/// foundation only; no real Connect-style processor is integrated in this
/// phase (§21 P13 scope boundary).
enum OrganizationConnectedAccountOnboardingStatus {
  not_started
  pending
  action_required
  verified
  restricted
  disabled

  @@map("organization_connected_account_onboarding_status")
}

/// Matches §4.2's commission-override hierarchy exactly. `exempt` is a
/// distinct, explicit state from "default happens to resolve to 0" — never
/// conflated.
enum OrganizationCommissionMode {
  default
  custom
  exempt

  @@map("organization_commission_mode")
}

/// Which of the two §4.1 modes an Organization has chosen — Organization-
/// level only (no Academy-level override; §4.1 confirms the domain model
/// gives Academies no independent billing identity today). One row per
/// Organization, created lazily on first read/write (see
/// `OrganizationPaymentSettingsRepository`), so an Organization that has
/// never touched this setting still resolves to `unconfigured` rather than
/// having no row at all.
model OrganizationPaymentSettings {
  id                    String                @id @default(uuid())
  organizationId        String                @unique @map("organization_id")
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentCollectionMode PaymentCollectionMode @default(unconfigured) @map("payment_collection_mode")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  @@map("organization_payment_settings")
}

/// An Organization's own gateway configuration, for Organization-Owned
/// Gateway mode (§4.1/§5.8). One active configuration per Organization
/// (unique `organizationId`), matching the dashboard's single "Online
/// Gateway" selector, not a list. `encryptedConfig` is application-layer
/// envelope-encrypted before it ever reaches this column (§16,
/// `CredentialEncryptionService`) — never plaintext, and never selected by
/// any repository method used on a response path (see
/// `OrganizationGatewayCredentialsRepository`'s own doc comment). No
/// gateway-specific column is added here — `providerKey` is the only
/// structural field; everything provider-specific lives inside the
/// encrypted blob, decrypted only inside the resolved `PaymentProviderAdapter`
/// at call time.
model OrganizationGatewayCredential {
  id              String                              @id @default(uuid())
  organizationId  String                              @unique @map("organization_id")
  organization    Organization                        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerKey     String                              @map("provider_key")
  status          OrganizationGatewayCredentialStatus @default(not_configured)
  encryptedConfig String?                             @map("encrypted_config")
  enabled         Boolean                             @default(false)
  lastTestedAt    DateTime?                           @map("last_tested_at")
  /// Provider-agnostic success/failure summary only — never a raw provider error payload (§16).
  lastTestResult  Json?                               @map("last_test_result")
  createdAt       DateTime                            @default(now()) @map("created_at")
  updatedAt       DateTime                            @updatedAt @map("updated_at")

  @@map("organization_gateway_credentials")
}

/// An Organization's Atlas Payments custodial/onboarding relationship
/// (§4.1/§5.8) — the Organization-level replacement for the originally
/// Academy-scoped `academy_connected_accounts` design (master plan §5.8,
/// "Superseded by §4.1" note). Reference fields only, never a raw banking
/// credential. Schema/service foundation only in this phase — no real
/// Connect-style processor is integrated, so every row starts and stays
/// `not_started` until a future phase adds one.
model OrganizationConnectedAccount {
  id                       String                                       @id @default(uuid())
  organizationId           String                                       @unique @map("organization_id")
  organization             Organization                                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerKey              String?                                      @map("provider_key")
  externalAccountReference String?                                      @map("external_account_reference")
  onboardingStatus         OrganizationConnectedAccountOnboardingStatus @default(not_started) @map("onboarding_status")
  payoutsEnabled           Boolean                                      @default(false) @map("payouts_enabled")
  createdAt                DateTime                                     @default(now()) @map("created_at")
  updatedAt                DateTime                                     @updatedAt @map("updated_at")

  @@map("organization_connected_accounts")
}

/// The Organization-level commission override from §4.2. Write access is
/// Platform-Owner-only at every layer (RLS in migration.sql, guard at the
/// controller) — an Organization can read its own row but can never insert
/// or update it, the concrete enforcement of "an Organization must not be
/// able to grant itself a commission exemption or modify its own rate."
model OrganizationCommissionSettings {
  id                          String                     @id @default(uuid())
  organizationId              String                     @unique @map("organization_id")
  organization                Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  commissionMode              OrganizationCommissionMode @default(default) @map("commission_mode")
  /// Populated only when `commissionMode = 'custom'` — basis points (0–10000), never a float.
  customPercentageBasisPoints Int?                       @map("custom_percentage_basis_points")
  updatedBy                   String?                    @map("updated_by")
  updatedByUser               User?                      @relation("OrganizationCommissionSettingsUpdatedBy", fields: [updatedBy], references: [id])
  createdAt                   DateTime                   @default(now()) @map("created_at")
  updatedAt                   DateTime                   @updatedAt @map("updated_at")

  @@map("organization_commission_settings")
}

/// The platform-wide global default commission from §4.2. Platform-owned
/// singleton — mirrors `PlatformDomainConfiguration` (P11) exactly: a
/// fixed, well-known id and `upsert` close the concurrent-first-read race
/// atomically at the database level, never a find-then-create race. Not
/// tenant-scoped, no tenant RLS — same category as `Plan`/`AddOn`/
/// `PaymentMethod`. `defaultCommissionBasisPoints` starts and stays `null`
/// until a Platform Owner explicitly sets it (§4.2) — this schema does not
/// invent a default value.
model AtlasCommissionConfig {
  id                           String   @id @default(uuid())
  defaultCommissionBasisPoints Int?     @map("default_commission_basis_points")
  updatedBy                    String?  @map("updated_by")
  updatedByUser                User?    @relation("AtlasCommissionConfigUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt                    DateTime @updatedAt @map("updated_at")

  @@map("atlas_commission_config")
}

// ---------------------------------------------------------------------------
// Atlas Subscription Payment — Generic Payment Gateway Integration Readiness
// (implemented on top of §5.8's provider abstraction; distinct from both
// P12's existing `payment_methods` catalog and §5.8's Organization-owned
// `organization_gateway_credentials`/course-payment tables above). This is
// ATLAS's own configuration of which `PaymentProviderAdapter` currently
// backs Atlas Subscription Billing (Organization → Atlas) — never an
// Organization- or Student-facing concept.
// ---------------------------------------------------------------------------

/// Lifecycle of Atlas's own subscription-payment provider configuration —
/// same shape as `OrganizationGatewayCredentialStatus` (§5.8) by
/// coincidence of concept, deliberately a SEPARATE, clearly-named enum
/// (never reused across the Organization/Atlas ownership boundary).
enum AtlasSubscriptionPaymentProviderStatus {
  not_configured
  configured
  verified
  disabled

  @@map("atlas_subscription_payment_provider_status")
}

/// Platform-owned singleton — mirrors `AtlasCommissionConfig`/
/// `PlatformDomainConfiguration` exactly: a fixed, well-known id and
/// `upsert` close the concurrent-first-read race atomically at the
/// database level. Not tenant-scoped, no RLS — same category as
/// `PaymentMethod`/`AtlasCommissionConfig`.
///
/// Absence of a row (or `providerKey = null`) means Atlas Subscription
/// Payments are running on today's real default — Manual Transfer
/// (`ManualTransferProvider`, `payment_methods.provider = 'atlas_manual'`)
/// — resolved by `AtlasSubscriptionPaymentProviderService`, never a
/// second hardcoded default anywhere else. `encryptedConfig` is envelope-
/// encrypted the identical way `organization_gateway_credentials` already
/// is (`CredentialEncryptionService`, §5.8/§16) — never plaintext, never
/// selected on any response path.
model AtlasSubscriptionPaymentProviderConfig {
  id              String                                 @id @default(uuid())
  /// Null until a Platform Owner explicitly selects a provider other than the real default (Manual Transfer).
  providerKey     String?                                @map("provider_key")
  status          AtlasSubscriptionPaymentProviderStatus @default(not_configured)
  encryptedConfig String?                                @map("encrypted_config")
  enabled         Boolean                                @default(false)
  lastTestedAt    DateTime?                              @map("last_tested_at")
  /// Provider-agnostic success/failure summary only — never a raw provider error payload (§16).
  lastTestResult  Json?                                  @map("last_test_result")
  updatedBy       String?                                @map("updated_by")
  updatedByUser   User?                                  @relation("AtlasSubscriptionPaymentProviderConfigUpdatedBy", fields: [updatedBy], references: [id])
  createdAt       DateTime                               @default(now()) @map("created_at")
  updatedAt       DateTime                               @updatedAt @map("updated_at")

  @@map("atlas_subscription_payment_provider_config")
}

// ---------------------------------------------------------------------------
// Phase P13 — Course Pricing, Purchase & Payouts (master plan §5.8/§23,
// §21 Phase P13; product decisions §4.1/§4.2 finalized 2026-08-26, and the
// P13-scoping decisions this implementation session resolved: full-refund-
// only within a 30-day window, a third plan-tier commission level between
// the Organization override and the platform default, and Atlas Payments
// mode implemented today through the SAME `ManualTransferProvider`
// Atlas-subscription-billing already uses — no second payment engine).
//
// `PlanCommissionSettings` — the plan-tier level of §4.2's commission
// hierarchy, extended per this session's product direction: "Organization
// override → Plan commission → Platform default", never a silent
// four-state ambiguity. Platform-owned catalog-adjacent configuration
// (mirrors `AtlasCommissionConfig`'s "no RLS, Platform-Owner-write-gated
// at the application/controller layer" shape) — deliberately its own
// table, not a column on `Plan` itself, so `Plan`'s own response contract
// (mirroring the frontend's `Plan` type field-for-field) never
// accidentally grows a field the frontend has no contract for. Row
// ABSENCE means "no plan-tier override configured" — the same
// null-means-unconfigured convention `AtlasCommissionConfig`/
// `OrganizationCommissionSettings` already established, extended to a
// third tier rather than inventing a new pattern.
//
// `CourseOrder` — the course-purchase analog of `checkouts` (§5.8's own
// documented reason: "the scoping dimension is different (`student_id` +
// `course_id`, not `organization_id`)"). User-scoped like `enrollments`
// (P6) — a student is never an `organization_memberships` row of the
// Academy/Organization selling the course — reusing
// `TenancyContextService.runInUserContext`/`runInTenantAndUserContext`
// exactly as P6/P12's `PlatformPaymentService` already do, never a new
// tenancy mechanism. `organizationId`/`academyId` are both denormalized
// from the purchased Course at order-creation time (the exact
// `Enrollment.academyId`/`CourseLesson.courseId` "no join on the hot path"
// convention this schema has used since P5/P6), used here specifically so
// the commission/ledger/RLS machinery below can resolve an Organization's
// payment-collection mode and effective commission without a join back
// through `courses → academies → organizations` on every write.
//
// `Payment` (P12, extended above) — `payerUserId`/`payeeAcademyId`/
// `courseOrderId` plus the three commission-snapshot columns are this
// phase's own extension of §5.7's documented extension point. A
// `CHECK` constraint (migration.sql; Prisma's schema language has no
// CHECK syntax) enforces exactly one of `(organizationId)` or
// `(payerUserId, payeeAcademyId)` populated per row.
//
// `RevenueLedgerEntry` — append-only, NEVER updated in place (master plan
// §5.8: "a refund is a new negative-amount entry referencing the original,
// not a mutation of it"). Only ever inserted inside the SAME atomic
// transaction as the Payment/CourseOrder/Enrollment state change it
// records (master plan §10's transaction rule) — see
// `CourseOrderPaymentApplicationService`/`CourseOrderRefundsService`.
// Signed `amountMinorUnits`: a `sale` entry is the full price (+), a
// `platform_fee` entry is the commission taken out (-), so
// `SUM(amount_minor_units)` per Academy directly yields what that Academy
// is actually owed — no separate "gross vs. net" computation needed
// anywhere else in this codebase. A `refund`/`commission_reversal` pair
// exactly reverses a prior `sale`/`platform_fee` pair (§4.2's proportional-
// reversal rule; full refunds only in this phase, so the reversal is
// always exact, never fractional). Populated ONLY for Organizations in
// Atlas Payments mode — Organization-Owned Gateway transactions insert no
// ledger row at all, the concrete enforcement of "Atlas must not create an
// Atlas commission liability from a transaction it was never a party to."
//
// `AcademyPayout`/`AcademyPayoutItem` — mirrors §5.8 exactly. Computed and
// recorded by `PlatformAcademyPayoutsService` in this phase (a
// Platform-Owner-triggered computation/recording action, matching §4's
// own recommendation — "payout is a manually-triggered or simply-
// scheduled batch job against a ledger" — for the interim Model-A bridge);
// a scheduled/automated payout-execution worker remains explicitly future
// scope (§12's `payout-worker` row), not built here.
//
// `CourseOrderRefund` — the explicit refund-lifecycle row this session's
// product direction requires ("the refund lifecycle must be represented
// explicitly in the data model"). `refundType`/`status` are real enum
// columns carrying values beyond what this phase ever produces
// (`refundType` stays `full` only; `status` stays `succeeded` only, since
// every refund in this phase is synchronous and buyer-initiated with no
// async gateway leg) — deliberately structured so a future partial-refund
// or async-gateway-refund capability is an ADDITIVE enum value plus a
// relaxed uniqueness rule, never a redesign of this table's shape or the
// ledger convention above. `courseOrderId` is `@unique` — a real database
// constraint making a second refund on the same order structurally
// impossible, not merely an application-layer check (matching this
// session's explicit "duplicate refunds impossible" requirement).
//
// RLS (migration.sql) reuses every session-variable mechanism already
// established — `app.current_organization_id` (P2), `app.current_user_id`
// (P6), `is_platform_owner()` (P12) — and introduces exactly one function
// change: `resolve_payment_organization` (P12) is updated (`CREATE OR
// REPLACE`, additive) to also resolve a course-order Payment's
// organization transitively through `course_orders.organization_id` when
// `payments.organization_id` is null, so the existing webhook
// infrastructure stays correct for a future course-order-capable gateway
// even though this phase's own real Atlas Payments flow (manual transfer +
// Platform Owner review) never exercises that path. No other new
// `SECURITY DEFINER` function is introduced.
// ---------------------------------------------------------------------------

/// The plan-tier level of §4.2's now-three-tier commission hierarchy
/// (`Organization override → Plan commission → Platform default`). See
/// this section's header comment for why this is its own table rather
/// than a column on `Plan`.
model PlanCommissionSettings {
  planId                String   @id @map("plan_id")
  plan                  Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// Basis points (0–10000) — never a float, matching every other
  /// commission field in this schema. Required on this table (row absence
  /// IS the "not configured" state — see header comment — so once a row
  /// exists, it always carries a real value, never a second null-as-
  /// unconfigured signal nested inside an already-optional row).
  commissionBasisPoints Int      @map("commission_basis_points")
  updatedBy             String?  @map("updated_by")
  updatedByUser         User?    @relation("PlanCommissionSettingsUpdatedBy", fields: [updatedBy], references: [id])
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("plan_commission_settings")
}

/// Matches this session's finalized §4.1-consistent three-value shape —
/// `unconfigured` is impossible here by construction (a `CourseOrder`/
/// `Payment` is never created for an `unconfigured` Organization at all,
/// per §4.1's "must refuse to proceed" rule, enforced in
/// `CourseOrdersService`/`CourseOrderPaymentsService`) — but the column
/// still uses the SAME `PaymentCollectionMode` enum as
/// `organization_payment_settings`, never a narrower duplicate enum, so a
/// snapshot value is always a real, valid mode by the type system itself.
enum CourseOrderStatus {
  draft
  pending_payment
  paid
  expired
  cancelled
  refunded

  @@map("course_order_status")
}

/// The course-purchase analog of `Checkout` — see this section's header
/// comment.
model CourseOrder {
  id             String            @id @default(uuid())
  studentId      String            @map("student_id")
  student        User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId       String            @map("course_id")
  course         Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Denormalized from `course.academyId` at order-creation time.
  academyId      String            @map("academy_id")
  academy        Academy           @relation(fields: [academyId], references: [id], onDelete: Cascade)
  /// Denormalized from `academy.organizationId` at order-creation time —
  /// see header comment for why this table needs it directly.
  organizationId String            @map("organization_id")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Frozen `{course: {id, title}, price: {amountMinorUnits, currency}}` —
  /// written once, never recomputed from the live Course afterward (the
  /// exact `CheckoutSnapshot` discipline, master plan §5.7/§23).
  snapshot       Json
  status         CourseOrderStatus @default(draft)
  expiresAt      DateTime          @map("expires_at")
  idempotencyKey String            @map("idempotency_key")
  paidAt         DateTime?         @map("paid_at")
  enrollments    Enrollment[]
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  payments      Payment[]
  refund        CourseOrderRefund?
  ledgerEntries RevenueLedgerEntry[]

  @@unique([studentId, idempotencyKey])
  @@index([studentId, status])
  @@index([courseId])
  @@index([academyId])
  @@map("course_orders")
}

/// Academy Manual Payments (Oct 2026) — the manual methods ONE academy
/// accepts from its learners (bank transfer, InstaPay, mobile wallet), with
/// the details the learner is shown. Academy-scoped on purpose: every
/// academy is its own storefront (own subdomain, brand, currency and
/// learners), so Academy A can take Bank + InstaPay while Academy B takes a
/// wallet only. See `docs/ACADEMY_MANUAL_PAYMENTS.md`.
///
/// When an academy has at least one ENABLED method, its course payments
/// are taken with these methods (`payments.provider = 'academy_manual'`,
/// `payment_collection_mode_snapshot = 'academy_manual'`) and reviewed by
/// the Client Owner; no Atlas commission or ledger entry is written,
/// because the money never passes through Atlas. With none enabled, the
/// organization's `payment_collection_mode` applies exactly as before.
///
/// At most one method per type per academy. A method is never deleted
/// while payments reference it (disable it instead); every payment keeps
/// the instructions it was created with (`payments.instructions_snapshot`).
/// `organization_id` is denormalized from the academy for RLS.
model AcademyPaymentMethod {
  id              String            @id @default(uuid())
  academyId       String            @map("academy_id")
  academy         Academy           @relation(fields: [academyId], references: [id], onDelete: Cascade)
  organizationId  String            @map("organization_id")
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// One of the three `manual_*` types — `gateway` is refused by a CHECK constraint.
  type            PaymentMethodType
  enabled         Boolean           @default(false)
  /// `ManualPaymentInstructionsResponse` (bank, wallet or InstaPay variant), normalized and validated server-side by the same rules as the platform catalog (`billing/utils/manual-payment-instructions.util.ts`).
  instructions    Json
  displayOrder    Int               @default(0) @map("display_order")
  updatedByUserId String?           @map("updated_by_user_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  payments Payment[]

  @@unique([academyId, type])
  @@index([organizationId])
  @@map("academy_payment_methods")
}

/// See this section's header comment for the full sign/reversal
/// convention. `payout` is reserved for a future
/// `payout-worker`-authored entry type (master plan §5.8's own enum
/// list) — not produced by this phase's payout computation, which reads
/// `sale`/`platform_fee`/`refund`/`commission_reversal` rows directly
/// rather than writing a new ledger row for the payout itself (the
/// `AcademyPayoutItem` join is what marks a set of entries "settled";
/// see that model's own doc comment).
enum RevenueLedgerEntryType {
  sale
  platform_fee
  refund
  commission_reversal
  payout

  @@map("revenue_ledger_entry_type")
}

/// Append-only — see this section's header comment. No UPDATE/DELETE RLS
/// policy exists on this table at all (migration.sql), the same
/// "structurally impossible to mutate, not just discouraged" discipline
/// `payment_reviews`/`payment_webhook_events` already established in P12.
model RevenueLedgerEntry {
  id               String                 @id @default(uuid())
  academyId        String                 @map("academy_id")
  academy          Academy                @relation(fields: [academyId], references: [id], onDelete: Cascade)
  courseOrderId    String                 @map("course_order_id")
  courseOrder      CourseOrder            @relation(fields: [courseOrderId], references: [id], onDelete: Cascade)
  paymentId        String?                @map("payment_id")
  payment          Payment?               @relation(fields: [paymentId], references: [id])
  entryType        RevenueLedgerEntryType @map("entry_type")
  /// Signed — see header comment for the sign convention per `entryType`.
  amountMinorUnits BigInt                 @map("amount_minor_units")
  currency         String
  occurredAt       DateTime               @default(now()) @map("occurred_at")

  payoutItems AcademyPayoutItem[]

  @@index([academyId, occurredAt])
  @@index([courseOrderId])
  @@map("revenue_ledger_entries")
}

enum AcademyPayoutStatus {
  pending
  processing
  paid
  failed

  @@map("academy_payout_status")
}

/// Mirrors master plan §5.8 exactly. `providerReference` stays null under
/// every payout this phase creates (Model-A manual bridge, §4's own
/// recommendation) — populated only once a real Connect-style payout
/// integration exists.
model AcademyPayout {
  id                String              @id @default(uuid())
  academyId         String              @map("academy_id")
  academy           Academy             @relation(fields: [academyId], references: [id], onDelete: Cascade)
  status            AcademyPayoutStatus @default(pending)
  amountMinorUnits  BigInt              @map("amount_minor_units")
  currency          String
  periodStart       DateTime            @map("period_start")
  periodEnd         DateTime            @map("period_end")
  paidAt            DateTime?           @map("paid_at")
  providerReference String?             @map("provider_reference")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  items AcademyPayoutItem[]

  @@index([academyId, status])
  @@map("academy_payouts")
}

/// Line-item detail linking a payout back to the ledger entries it
/// settles (master plan §5.8) — the presence of a row here is what marks a
/// `RevenueLedgerEntry` "already paid out," so payout computation never
/// double-counts an entry into two payouts.
model AcademyPayoutItem {
  id                   String             @id @default(uuid())
  payoutId             String             @map("payout_id")
  payout               AcademyPayout      @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  revenueLedgerEntryId String             @map("revenue_ledger_entry_id")
  revenueLedgerEntry   RevenueLedgerEntry @relation(fields: [revenueLedgerEntryId], references: [id])
  createdAt            DateTime           @default(now()) @map("created_at")

  @@unique([revenueLedgerEntryId])
  @@index([payoutId])
  @@map("academy_payout_items")
}

/// Structurally ready for extension, not built out — see this section's
/// header comment. Only `full`/`succeeded` are ever produced by this
/// phase's own service.
enum CourseOrderRefundType {
  full

  @@map("course_order_refund_type")
}

enum CourseOrderRefundStatus {
  pending
  succeeded
  failed

  @@map("course_order_refund_status")
}

/// The explicit refund-lifecycle row — see this section's header comment.
/// `courseOrderId @unique` is the real database-level "duplicate refunds
/// impossible" guarantee.
model CourseOrderRefund {
  id               String                  @id @default(uuid())
  courseOrderId    String                  @unique @map("course_order_id")
  courseOrder      CourseOrder             @relation(fields: [courseOrderId], references: [id], onDelete: Cascade)
  paymentId        String                  @map("payment_id")
  payment          Payment                 @relation(fields: [paymentId], references: [id])
  refundType       CourseOrderRefundType   @default(full) @map("refund_type")
  status           CourseOrderRefundStatus @default(succeeded)
  amountMinorUnits BigInt                  @map("amount_minor_units")
  currency         String
  reason           String?
  requestedBy      String                  @map("requested_by")
  requester        User                    @relation(fields: [requestedBy], references: [id])
  idempotencyKey   String                  @map("idempotency_key")
  requestedAt      DateTime                @default(now()) @map("requested_at")
  processedAt      DateTime?               @map("processed_at")

  @@map("course_order_refunds")
}

// ---------------------------------------------------------------------------
// Phase P14 — Provisioning Orchestration (master plan §5.11/§21 Phase P14).
// The 7-step resumable state machine tying together Academy creation
// (reusing P3's `AcademiesService` verbatim, never a second creation path),
// subdomain allocation (this phase's own real first writer of
// `subdomain_allocations` — P11 shipped that table read-only, exactly as
// its own doc comment anticipated), domain-step observability (no real
// custom-domain data is ever collected by this flow — see below), and the
// triggering Payment reference (P12's real `Payment` row, never a second
// payment abstraction).
//
// `ProvisioningStepKey` — the exact 7-value enum confirmed directly against
// the real frontend contract (`atlas-front/src/types/provisioning.types.ts`,
// `PROVISIONING_STEP_KEYS`), not invented: `tenant, academy, theme,
// branding, subdomain, domain, finalization`. `tenant` is always
// `completed` immediately (a request is only ever created inside an
// already-authenticated Organization context — there is no "create the
// tenant" work left to do, matching that file's own doc comment verbatim).
// `theme`/`branding` are always `skipped` — `CreateProvisioningRequestPayload`
// carries no theme/branding selection field at all, and the frontend's own
// doc comment confirms no picker UI exists for either yet ("Prompt 8 does
// not implement a Theme Engine... reported 'skipped' until one exists").
// `domain` is likewise always `skipped` in this phase — the payload carries
// no custom-domain field either; connecting a REAL custom domain remains
// the existing, separate, already-implemented P11 `DomainService.
// addCustomDomain` flow (an Academy Owner's own later, deliberate action),
// never invented here. This is the concrete, current-repository-verified
// application of master plan §24's "DNS/SSL/CDN mutations... every status
// is honestly 'not configured'" rule to this phase: nothing here ever
// fabricates a connected custom domain.
//
// `ProvisioningStatus` — the exact 12-value enum from the same frontend
// file, used as the coarse "milestone" tracker `ProvisioningRequest.status`
// carries (distinct from the fine-grained `ProvisioningStep.status` each
// step row carries). The initial status is `payment_success` when the
// request carries a `triggeringPaymentId` (a real payment just completed,
// about to provision), or `tenant_created` directly when it does not (no
// payment milestone applies) — a reasonable, documented interpretation of
// the enum's own naming and the field's own "present only when triggered by
// a payment" semantics; master plan/frontend do not state this mapping
// explicitly, so it is called out again in the P14 implementation report
// rather than treated as self-evidently specified.
//
// `ProvisioningRequest.subdomain`/`.domain` (the frontend's own
// `SubdomainAllocation`/`DomainConnection` fields on `ProvisioningRequest`)
// are deliberately NOT redundant JSONB snapshot columns on this table —
// master plan §5.11's own schema sketch suggests `subdomain jsonb, domain
// jsonb`, but once `academyId` is set, the EXISTING, already-real
// `subdomain_allocations`/`domain_connections` tables (keyed by
// `academy_id`, already read via `SubdomainAllocationsRepository.
// findByAcademyId`/`DomainConnectionsRepository.findByAcademyId`, both
// already exported by `DomainModule`) are the single source of truth for
// that data — resolved live at response-build time instead. A documented,
// deliberate adaptation of the master plan's schema sketch to this
// repository's actual, already-established pattern (this session's own
// explicit "preserve architectural intent, adapt to current state, document
// the discrepancy" instruction) — avoids a second, staleness-prone copy of
// data `DomainService`'s own later writes (e.g. a real custom-domain
// connection) would otherwise need to keep in sync on two tables.
//
// `requestedByUserId` — one field beyond this session's own literal listed
// field set, added because it is structurally required to correctly reuse
// `AcademiesService.create(userId, payload)` (P3) — that method requires a
// real user id to add as the new Academy's first `owner`-role member, and
// using the Organization's own `owner_user_id` instead would misattribute
// Academy ownership to someone who may not be the actual requester (any
// Organization member may create a provisioning request, mirroring
// `POST /academies`' own `AcademyOrganizationScopeGuard`-only, no-extra-
// role-check authorization). Documented here rather than silently added.
//
// RLS mirrors the exact `checkouts`/`payments` (P12) org-tenant-scoped
// shape — `app.current_organization_id`, no new session variable — plus
// one narrow addition for the one genuinely new cross-tenant read this
// phase needs: `subdomain_is_taken(text)`, a `SECURITY DEFINER` function in
// the SAME documented category as `resolve_academy_organization`/
// `resolve_payment_organization` (P11/P12/P13) — subdomain uniqueness is
// necessarily a GLOBAL fact (matches `subdomain_allocations.subdomain`'s
// own `@unique` constraint, not scoped to one Organization), so checking
// availability cannot be answered from inside any one tenant's own RLS
// context. It answers only "is this exact string already taken," never
// leaking which Organization/Academy holds it.
// ---------------------------------------------------------------------------

/// The 7 real orchestration steps — see this section's header comment for
/// why each is real work (`academy`, `subdomain`) or structurally always
/// `completed`/`skipped` (`tenant`, `theme`, `branding`, `domain`) in this
/// phase.
enum ProvisioningStepKey {
  tenant
  academy
  theme
  branding
  subdomain
  domain
  finalization

  @@map("provisioning_step_key")
}

enum ProvisioningStepStatus {
  pending
  running
  completed
  failed
  skipped

  @@map("provisioning_step_status")
}

/// The coarse request-level milestone — see this section's header comment
/// for the exact status-per-step-completion mapping this phase uses.
enum ProvisioningStatus {
  payment_success
  tenant_created
  academy_created
  theme_applied
  branding_applied
  subdomain_assigned
  custom_domain_pending
  custom_domain_connected
  provisioning
  ready
  failed
  cancelled

  @@map("provisioning_status")
}

/// Mirrors `ProvisioningRequest` (`provisioning.types.ts`) field-for-field,
/// plus `requestedByUserId` (see header comment). Organization-scoped —
/// created only by an authenticated Organization member, mirroring
/// `Checkout`'s exact tenant-scoping shape, never a second tenancy
/// mechanism.
model ProvisioningRequest {
  id                      String              @id @default(uuid())
  organizationId          String              @map("organization_id")
  organization            Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Populated once the `academy` step completes — absent, not a placeholder id, before that (master plan §5.11's own exact wording).
  academyId               String?             @unique @map("academy_id")
  academy                 Academy?            @relation(fields: [academyId], references: [id])
  requestedByUserId       String              @map("requested_by_user_id")
  requestedByUser         User                @relation(fields: [requestedByUserId], references: [id])
  status                  ProvisioningStatus  @default(payment_success)
  currentStepKey          ProvisioningStepKey @default(tenant) @map("current_step_key")
  requestedAcademyName    String              @map("requested_academy_name")
  requestedSubdomain      String              @map("requested_subdomain")
  /// Present only when this request was triggered by a specific P12 Payment — the real row, never a second payment abstraction (this phase's explicit instruction).
  triggeringPaymentId     String?             @map("triggering_payment_id")
  triggeringPayment       Payment?            @relation(fields: [triggeringPaymentId], references: [id])
  /// Phase P19 — the Client's chosen theme key from the real Website Builder theme registry (`WEBSITE_THEME_KEYS`, matched exactly, never re-validated against a second catalog). Optional: the 'theme' provisioning step applies it if present, and otherwise leaves `WebsiteBootstrapService`'s own default theme in place — never a hard requirement, matching P9's own "always a sensible bootstrap default" design.
  selectedThemeKey        String?             @map("selected_theme_key")
  /// Phase 6 (Bilingual Academy Websites) — `'empty' | 'complete'` (`WEBSITE_SETUP_MODES`). Meaningless without `selectedThemeKey`; `null` is treated as `'empty'` by `executeThemeStep`, matching every Academy provisioned before this column existed.
  websiteSetupMode        String?             @map("website_setup_mode")
  /// W2 — the validated brand chosen in the setup form (`RequestedBrand`, `provisioning/dto/requested-brand.ts`): palette inputs, and the logo only ever as a media-asset reference once the Academy exists — never a data: URI. Applied by the orchestrator's `branding` step; `null` (every older request) keeps that step `skipped`.
  requestedBrand          Json?               @map("requested_brand")
  /// Academy Manual Payments — the manual methods chosen in the setup form (`RequestedPaymentMethods`, `provisioning/dto/requested-payment-methods.ts`). Saved to `academy_payment_methods` by the `academy` step once the Academy exists; `null` (every older request, or "set up later") saves nothing.
  requestedPaymentMethods Json?               @map("requested_payment_methods")
  /// W2 — stamped whenever the orchestrator starts, finishes or fails a step. The status endpoint derives `stalled` from it (falling back to `startedAt`/`createdAt` on older rows).
  lastProgressAt          DateTime?           @map("last_progress_at")
  idempotencyKey          String              @map("idempotency_key")
  attemptCount            Int                 @default(0) @map("attempt_count")
  /// Mirrors `ProvisioningError` (`{code, messageKey, detail?}`) — set only while `status = 'failed'`.
  lastError               Json?               @map("last_error")
  startedAt               DateTime?           @map("started_at")
  completedAt             DateTime?           @map("completed_at")
  failedAt                DateTime?           @map("failed_at")
  /// Phase 8 — set exactly once, the moment `ProvisioningOrchestratorService`
  /// auto-opens a support case for this request after it crosses the
  /// consecutive-failure threshold (reusing `attemptCount`, never a second
  /// failure counter). Checked before creating another — a request that
  /// keeps failing on retry never opens a second ticket for the same
  /// failure episode. Cleared back to `null` only if the request later
  /// reaches `ready` and is genuinely retried again from scratch — never
  /// today's actual retry path, so in practice this is set once per
  /// request's lifetime.
  autoSupportCaseId       String?             @map("auto_support_case_id")
  autoSupportCase         SupportCase?        @relation(fields: [autoSupportCaseId], references: [id])
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  steps ProvisioningStep[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@index([organizationId, requestedSubdomain])
  @@map("provisioning_requests")
}

/// Mirrors `ProvisioningStep` (`provisioning.types.ts`) field-for-field.
/// Mutable state, unlike the P13 revenue ledger — a step row is updated in
/// place across attempts (`attemptNumber` increments), never re-inserted;
/// `@@unique([provisioningRequestId, key])` is the real database-level
/// guarantee that a duplicate step row for the same request/key is
/// structurally impossible, not merely an application-layer convention.
model ProvisioningStep {
  id                    String                 @id @default(uuid())
  provisioningRequestId String                 @map("provisioning_request_id")
  provisioningRequest   ProvisioningRequest    @relation(fields: [provisioningRequestId], references: [id], onDelete: Cascade)
  key                   ProvisioningStepKey
  status                ProvisioningStepStatus @default(pending)
  attemptNumber         Int                    @default(0) @map("attempt_number")
  startedAt             DateTime?              @map("started_at")
  completedAt           DateTime?              @map("completed_at")
  failedAt              DateTime?              @map("failed_at")
  /// Mirrors `ProvisioningError` — set only while `status = 'failed'`.
  error                 Json?

  @@unique([provisioningRequestId, key])
  @@index([provisioningRequestId])
  @@map("provisioning_steps")
}

// =============================================================================
// Phase P15 — Platform Owner Control Plane (master plan §5.12/§21/§7 point 4)
// =============================================================================
//
// P15 does NOT add any new cross-tenant DATA — `organizations`/`academies`/
// `users`/`tenant_subscriptions`/etc. already exist (P2–P14). What P15 adds
// is: (a) narrow, additive `_platform_select` RLS policies on those EXISTING
// tenant tables so a verified Platform Owner can read across every tenant —
// never a global RLS bypass, never a second tenancy mechanism (see the
// migration's own header comment for the exact policy list); (b) three
// genuinely new, Platform-owned tables below.
//
// `AuditLogEntry` — append-only, backend-sole-writer (master plan §5.12).
// `actorUserId` is a REQUIRED FK (every audited mutation has a real,
// authenticated acting user; there is no "system" actor in this codebase),
// `organizationId` is nullable (a Platform-Owner-only action, e.g. a
// commission-config change, has no single owning Organization). `context`
// is a small `Json` bag of non-secret diagnostic fields — see
// `AuditLogWriterService`'s own doc comment for the "never log secrets"
// discipline this column must uphold.
//
// `SupportCase`/`SupportCaseMessage` — mirrors `SupportCaseSummary`/
// `SupportCaseDetail`/`SupportCaseMessage` (frontend `support.types.ts`)
// field-for-field. `requesterUserId` is nullable — a support case's
// requester is not necessarily a registered Atlas user (matches
// `requesterName`/`requesterEmail` being their own denormalized columns,
// not a live join, since the frontend contract itself carries them
// directly on `SupportCaseSummary`, and master plan §5.12 lists no
// `requester_name`/`requester_email` FK-through-join design). There is
// deliberately NO create-case endpoint (master plan §24: "Support case
// creation from the dashboard | SPECIFICATION-UNDEFINED | No creation
// endpoint in any frontend contract") — every row here is provisioned
// outside this phase's API surface (fixture/seed/future channel), exactly
// like `payment_methods`' own P12 seed-only precedent.
//
// `PlatformSettings` — a Platform-owned singleton, NO RLS, matching
// `PlatformDomainConfiguration`/`TrialPolicy`'s own identical precedent
// exactly (a single global config row is not tenant data; `PlatformOwnerGuard`
// at the application layer is the real, sufficient protection, the same
// as those two tables already established).

enum SupportCaseStatus {
  open
  in_progress
  resolved
  closed

  @@map("support_case_status")
}

enum SupportCasePriority {
  low
  medium
  high
  urgent

  @@map("support_case_priority")
}

enum SupportCaseMessageAuthorRole {
  requester
  agent

  @@map("support_case_message_author_role")
}

/// Mirrors `AuditLogEntrySummary`/`AuditLogEntryDetail` (frontend
/// `audit-log.types.ts`) field-for-field.
model AuditLogEntry {
  id             String        @id @default(uuid())
  actorUserId    String        @map("actor_user_id")
  actor          User          @relation(fields: [actorUserId], references: [id])
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  /// Phase 8 — set whenever the audited mutation is Academy-scoped
  /// (Course/Instructor/Learning content, Academy-scoped support cases),
  /// so a Manager's "recent activity" dashboard widget can be scoped to
  /// their own Academy without ever seeing another Academy's rows under
  /// the same Organization. `null` for Organization-level-only actions
  /// (e.g. `provisioning_request.created`, which has no single Academy
  /// yet) and for every row written before this column existed.
  academyId      String?       @map("academy_id")
  academy        Academy?      @relation(fields: [academyId], references: [id])
  /// Phase 8 — the actor's real role AT THE TIME of the action (Academy
  /// membership role — `owner`/`administrator`/`manager`/`instructor`/
  /// `staff` — or the literal `'platform_owner'`), resolved server-side
  /// from the acting user's own membership row, never client-supplied.
  /// `null` for every row written before this column existed, and for
  /// actions with no single applicable role (e.g. a Student's own
  /// action, or an Organization Owner action where "owner" is already
  /// implied by there being no Academy role to record).
  role           String?
  /// A dotted event name, e.g. `"academy.provisioned"`, `"payment.approved"`.
  action         String
  targetType     String        @map("target_type")
  targetId       String        @map("target_id")
  targetLabel    String?       @map("target_label")
  /// Mirrors `AuditLogEntryDetail.context` — a flat, non-secret diagnostic
  /// bag (`Record<string, string | number | boolean | null>`), never a
  /// nested object, never a token/credential/password.
  context        Json?
  /// P58 — structured before/after, `{field: {from, to}}`. Separate from
  /// `context` (a flat scalar bag) so the writer can REDACT one known
  /// shape rather than inspecting an arbitrary object. Null for every row
  /// written before P58 and for any mutation with no recorded diff —
  /// never backfilled, because inventing history is worse than admitting
  /// it was not captured.
  changes        Json?
  /// P58 — non-identifying request metadata (request id, method, route,
  /// outcome). Deliberately excludes anything credential-shaped.
  requestContext Json?         @map("request_context")
  occurredAt     DateTime      @default(now()) @map("occurred_at")

  @@index([occurredAt(sort: Desc)])
  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([academyId, occurredAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([action, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@map("audit_log_entries")
}

/// Mirrors `SupportCaseSummary`/`SupportCaseDetail` field-for-field.
model SupportCase {
  id              String              @id @default(uuid())
  organizationId  String?             @map("organization_id")
  organization    Organization?       @relation(fields: [organizationId], references: [id])
  /// Phase 8 — set for a ticket created from an Academy-scoped context
  /// (a Manager submitting a ticket, or the provisioning auto-ticket,
  /// which always concerns one specific Academy request). `null` for a
  /// ticket with no single-Academy scope (e.g. an Organization Owner's
  /// billing question) — never guessed at when genuinely absent.
  academyId       String?             @map("academy_id")
  academy         Academy?            @relation(fields: [academyId], references: [id])
  requesterUserId String?             @map("requester_user_id")
  requester       User?               @relation(fields: [requesterUserId], references: [id])
  subject         String
  status          SupportCaseStatus   @default(open)
  priority        SupportCasePriority @default(medium)
  requesterName   String              @map("requester_name")
  requesterEmail  String              @map("requester_email")
  /// Display-only — no agent-directory table exists (frontend's own
  /// documented boundary, `support.types.ts`).
  assignedToName  String?             @map("assigned_to_name")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  messages             SupportCaseMessage[]
  /// Phase 8 — back-relation for `ProvisioningRequest.autoSupportCase`.
  /// In practice never more than one row (dedup is per request, and one
  /// request auto-opens at most one ticket), but left as a list since
  /// that is the one-to-many direction of the relation.
  autoOpenedByRequests ProvisioningRequest[]

  @@index([status, createdAt(sort: Desc)])
  @@index([organizationId])
  @@index([academyId])
  @@map("support_cases")
}

/// Mirrors `SupportCaseMessage` field-for-field.
model SupportCaseMessage {
  id         String                       @id @default(uuid())
  caseId     String                       @map("case_id")
  case       SupportCase                  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorName String                       @map("author_name")
  authorRole SupportCaseMessageAuthorRole @map("author_role")
  body       String
  createdAt  DateTime                     @default(now()) @map("created_at")

  /// P53 — optional image evidence on this message. A ticket is still a
  /// subject plus a text thread; an attachment never replaces the body.
  attachments SupportCaseMessageAttachment[]

  @@index([caseId, createdAt(sort: Asc)])
  @@map("support_case_messages")
}

/// P53 — an image attached to one support-ticket message.
///
/// DELIBERATELY NOT A `MediaAsset`. `media_assets.academyId` is required
/// while `support_cases.academyId` is nullable; media rows ARE the Academy
/// Media Library (visible to every academy manager, whereas a ticket is
/// private to the one person who filed it); media is quota-counted while
/// support must keep working for a lapsed or over-quota customer; and media
/// bytes are served by the UNAUTHENTICATED public route. See the P53
/// migration's header for the full reasoning.
///
/// The storage write itself reuses the existing R2 `MediaStorageProvider`,
/// the existing magic-byte allowlist and the existing size ceiling — this
/// is a second OWNERSHIP model over one storage pipeline, never a second
/// storage pipeline.
model SupportCaseMessageAttachment {
  id         String             @id @default(uuid())
  messageId  String             @map("message_id")
  message    SupportCaseMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName   String             @map("file_name")
  /// `support-cases/{caseId}/{uuid}.{ext}` — generated server-side from a
  /// verified case id, never from client input.
  storageKey String             @map("storage_key")
  mimeType   String             @map("mime_type")
  /// `bigint` at rest, matching `media_assets.sizeBytes`'s own precedent.
  sizeBytes  BigInt             @map("size_bytes")
  createdAt  DateTime           @default(now()) @map("created_at")

  @@index([messageId])
  @@map("support_case_message_attachments")
}

/// Mirrors `PlatformConfiguration` (frontend `platform-settings.types.ts`)
/// field-for-field. `sessionTimeoutMinutes` is nullable — `null` means the
/// frontend's `'never'` literal; 15/30/60 are the only other server-
/// validated values (DTO-enforced, not a Postgres CHECK — matching this
/// codebase's established "validate server-side, not schema-enforced"
/// convention for small closed sets, e.g. `PlatformSessionTimeout` itself).
model PlatformSettings {
  id                    String   @id
  platformName          String   @map("platform_name")
  platformDescription   String?  @map("platform_description")
  supportEmail          String?  @map("support_email")
  twoFactorRequired     Boolean  @default(false) @map("two_factor_required")
  sessionTimeoutMinutes Int?     @map("session_timeout_minutes")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// ---------------------------------------------------------------------------
// Phase P17 — Notifications, Email & Search (master plan §5 "notifications",
// §12 "Notification fan-out"/"Transactional email", §15 "Search").
//
// `Notification` mirrors master plan §5's own `notifications` table
// definition and the frontend `Notification` type (`notifications.
// types.ts`) field-for-field — `title_key`/`message_key` are i18n
// translation keys, never literal English/Arabic text, matching every
// other translated-content column in this schema (`support_cases.
// subject` is the one narrow exception, already documented there).
// User-owned (master plan §7's resource-ownership table: "own
// Notifications") — RLS is self-scoped for SELECT/UPDATE, but INSERT is
// deliberately unrestricted (`WITH CHECK (true)`, migration.sql) because
// the writer is always a trusted, server-side business-process action on
// behalf of ANOTHER user (e.g. a Platform Owner approving a payment
// writes a notification for the paying Organization's owner) — never a
// user-submitted row. Mirrors `audit_log_entries`' own identical,
// extensively-documented precedent (P15) exactly, including the same
// raw-`$executeRaw`-INSERT-with-no-RETURNING technique
// (`NotificationsRepository.create`) to sidestep the same "RLS filters
// the implicit RETURNING clause through the table's own SELECT policy"
// bug class that precedent already discovered and fixed.
//
// `dedupeKey` + `@@unique([userId, dedupeKey])` is this phase's chosen
// "deduped by a natural key (event + user)" idempotency strategy (master
// plan §12's own words for `notification-worker`) — Postgres treats every
// `NULL` in a unique index as distinct from every other `NULL`, so an
// event type that has no meaningful retry/duplicate risk (e.g. a security
// alert, which SHOULD fire every time) simply passes `dedupeKey: null`
// and is naturally exempted from the constraint, never forced into an
// artificial key.
// ---------------------------------------------------------------------------

/// Matches `NotificationType` (`notifications.types.ts`) exactly — 6 values.
enum NotificationType {
  system
  account
  billing
  security
  activity
  announcement

  @@map("notification_type")
}

/// Matches `NotificationPriority` (`notifications.types.ts`) exactly.
enum NotificationPriority {
  low
  medium
  high
  urgent

  @@map("notification_priority")
}

model Notification {
  id             String                     @id @default(uuid())
  userId         String                     @map("user_id")
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           NotificationType
  priority       NotificationPriority
  titleKey       String                     @map("title_key")
  messageKey     String                     @map("message_key")
  /// Interpolation values for `titleKey`/`messageKey` — matches
  /// `Notification.values` (frontend) exactly, resolved client-side via
  /// `t(titleKey, values)`.
  values         Json?
  isRead         Boolean                    @default(false) @map("is_read")
  actionUrl      String?                    @map("action_url")
  actionLabelKey String?                    @map("action_label_key")
  metadata       Json?
  /// Natural idempotency key — see this section's header comment. Null for
  /// event types that intentionally never dedupe.
  dedupeKey      String?                    @map("dedupe_key")
  /// P64 Communications — feed retention class from the event catalogue
  /// (`standard` 180 d, `extended` 365 d for billing/security/account).
  /// Pruned by the maintenance sweep under `notifications_retention_delete`.
  retentionClass NotificationRetentionClass @default(standard) @map("retention_class")
  /// Notification context isolation — WHERE this notification belongs.
  /// One person can be a Management user and a learner at several
  /// academies at once; the feed a request sees is the one its session's
  /// context owns (management → `management` + `account`; an academy
  /// session → `academy` rows of THAT academy + `account`). Set at creation
  /// from the catalogue audience; `unscoped` (the default) is shown on no
  /// surface — a writer that forgets the context leaks nothing.
  context        NotificationContext        @default(unscoped)
  /// The academy an `academy`-context notification belongs to (required
  /// for it, null for every other context — a CHECK constraint holds both).
  academyId      String?                    @map("academy_id")
  academy        Academy?                   @relation(fields: [academyId], references: [id], onDelete: Cascade)
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  @@unique([userId, dedupeKey])
  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, context, academyId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Notification context isolation — see `Notification.context`.
enum NotificationContext {
  /// Atlas Management dashboard (staff, owner, platform events).
  management
  /// One academy's learner area — `Notification.academyId` names it.
  academy
  /// The global account's own security notices (password, sign-in
  /// methods, 2FA): shown in every context, because the credential is.
  account
  /// Context could not be determined (legacy rows): shown nowhere.
  unscoped

  @@map("notification_context")
}

/// P64 Communications — retention class of a feed row (see the event catalogue).
enum NotificationRetentionClass {
  standard
  extended

  @@map("notification_retention_class")
}

enum CommunicationCategory {
  security
  transactional
  lifecycle
  engagement
  operational

  @@map("communication_category")
}

enum CommunicationOutboxState {
  pending
  dispatched
  deferred
  suppressed
  failed

  @@map("communication_outbox_state")
}

enum CommunicationChannel {
  email
  in_app

  @@map("communication_channel")
}

enum CommunicationDeliveryStatus {
  queued
  sent
  delivered
  bounced
  complained
  failed
  suppressed
  deferred

  @@map("communication_delivery_status")
}

enum CommunicationSuppressionReason {
  hard_bounce
  soft_bounce
  complaint
  manual
  invalid

  @@map("communication_suppression_reason")
}

enum CommunicationDigestState {
  open
  sent
  empty

  @@map("communication_digest_state")
}

/// P64 Communications C1 — the transactional outbox. Written INSIDE the
/// caller's transaction next to the business change (the same "row in the
/// transaction, delivery after commit" discipline P17's fan-out
/// established), drained by the `communications` BullMQ worker. The row is
/// the durable intent; the queue job is only a hint — a 1-minute sweeper
/// re-enqueues anything left `pending`/`deferred` past `availableAt`.
///
/// The recipient is a USER ID, never an address: the email is read from
/// `users` at dispatch, so an anonymised account is never mailed and no
/// caller can supply a recipient. Invites are the one non-user target and
/// point at `academy_invites` instead.
model CommunicationOutbox {
  id                String                   @id @default(uuid())
  /// Catalogue key, e.g. `learner.payment.approved` — stable audit vocabulary.
  key               String
  category          CommunicationCategory
  recipientUserId   String?                  @map("recipient_user_id")
  recipient         User?                    @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipientInviteId String?                  @map("recipient_invite_id")
  /// Customer Requests — an ADDRESS recipient with no Atlas account (a
  /// team inbox the Platform Owner configured). Set only when
  /// `recipientUserId` is null; email-only, no preferences, no in-app.
  recipientEmail    String?                  @map("recipient_email")
  /// Tenancy snapshot for owner/manager visibility and for branding.
  organizationId    String?                  @map("organization_id")
  academyId         String?                  @map("academy_id")
  entityType        String?                  @map("entity_type")
  entityId          String?                  @map("entity_id")
  /// Natural idempotency key per recipient (`payment:{id}` etc.). Null for
  /// events that intentionally never dedupe.
  dedupeKey         String?                  @map("dedupe_key")
  locale            String                   @default("en")
  /// `academy` | `platform` — which brand/host the email renders under.
  branding          String                   @default("platform")
  values            Json?
  /// The channel policy resolved at emit time, e.g. `{"inApp":true,"email":"always"}`.
  channels          Json
  priority          NotificationPriority     @default(medium)
  state             CommunicationOutboxState @default(pending)
  availableAt       DateTime                 @default(now()) @map("available_at")
  attempts          Int                      @default(0)
  lastError         String?                  @map("last_error")
  digestId          String?                  @map("digest_id")
  digest            CommunicationDigest?     @relation(fields: [digestId], references: [id], onDelete: SetNull)
  createdAt         DateTime                 @default(now()) @map("created_at")
  dispatchedAt      DateTime?                @map("dispatched_at")
  /// W3-compose — the campaign this row was released by, if any.
  /// Attribution only (no FK): the row stays the delivery record.
  campaignId        String?                  @map("campaign_id")

  deliveries CommunicationDelivery[]

  @@unique([recipientUserId, dedupeKey])
  @@index([state, availableAt])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([recipientUserId, createdAt(sort: Desc)])
  @@map("communication_outbox")
}

/// P64 Communications C1 — one row per channel attempt. `providerMessageId`
/// is what provider webhooks key on; `templateVersion` makes a copy change
/// traceable to the email a person actually received.
model CommunicationDelivery {
  id                String                      @id @default(uuid())
  outboxId          String                      @map("outbox_id")
  outbox            CommunicationOutbox         @relation(fields: [outboxId], references: [id], onDelete: Cascade)
  channel           CommunicationChannel
  provider          String?
  providerMessageId String?                     @map("provider_message_id")
  status            CommunicationDeliveryStatus @default(queued)
  errorCode         String?                     @map("error_code")
  attempts          Int                         @default(0)
  templateVersion   String?                     @map("template_version")
  sentAt            DateTime?                   @map("sent_at")
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")

  @@index([providerMessageId])
  @@index([status, updatedAt])
  @@index([outboxId])
  @@map("communication_deliveries")
}

/// P64 Communications C0 — addresses that must not be mailed. Keyed on a
/// SHA-256 of the canonical address (never the address itself) so the
/// table leaks nothing if read. Fed by provider webhooks and the platform
/// console. `expiresAt` null = permanent (complaints, hard bounces).
model CommunicationSuppression {
  id          String                         @id @default(uuid())
  emailHash   String                         @unique @map("email_hash")
  emailDomain String?                        @map("email_domain")
  reason      CommunicationSuppressionReason
  source      String
  note        String?
  createdAt   DateTime                       @default(now()) @map("created_at")
  expiresAt   DateTime?                      @map("expires_at")

  @@index([reason, createdAt(sort: Desc)])
  @@map("communication_suppressions")
}

/// P64 Communications C3 — a batch window per recipient and kind
/// (`staff_daily`, `platform_ops_daily`, `learner_engagement_daily`).
/// Deferred outbox rows attach to the open digest; the hourly digest job
/// sends due windows in the recipient's local hour.
model CommunicationDigest {
  id              String                   @id @default(uuid())
  recipientUserId String                   @map("recipient_user_id")
  recipient       User                     @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  kind            String
  windowStart     DateTime                 @map("window_start")
  windowEnd       DateTime                 @map("window_end")
  itemCount       Int                      @default(0) @map("item_count")
  state           CommunicationDigestState @default(open)
  sentAt          DateTime?                @map("sent_at")
  createdAt       DateTime                 @default(now()) @map("created_at")

  items CommunicationOutbox[]

  @@unique([recipientUserId, kind, windowStart])
  @@index([state, windowEnd])
  @@map("communication_digests")
}

/// Authentication audit (Decision 1) — the emailed confirmation code that
/// authorises deleting the caller's OWN account. A table of its own, never a
/// sign-in challenge with a flag: no sign-in path can read or accept one, and
/// one can only ever confirm a deletion. Bound to the account AND the session
/// that asked for it; the code is HMAC(serverKey, id.salt.code); one-time
/// consumption is a conditional UPDATE. RLS: the account's own context only.
model AccountDeletionChallenge {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The requesting session (`refresh_tokens.session_id`); another session of
  /// the same account cannot complete it.
  sessionId  String    @map("session_id")
  codeHash   String    @map("code_hash")
  salt       String
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("account_deletion_challenges")
}

/// P64 Communications C4 — an email OTP challenge. A TABLE, not Redis, so
/// it is auditable and survives a cache flush; the attempt counter that
/// throttles guesses still lives in Redis beside the 2FA one. `codeHash`
/// is HMAC-SHA256(serverSecret, salt || code): a database read yields
/// nothing a verifier can replay.
model AuthEmailChallenge {
  id                String      @id @default(uuid())
  userId            String      @map("user_id")
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  surface           String
  academyId         String?     @map("academy_id")
  codeHash          String      @map("code_hash")
  salt              String
  attempts          Int         @default(0)
  resends           Int         @default(0)
  deviceFingerprint String?     @map("device_fingerprint")
  ipAddress         String?     @map("ip_address")
  /// Google Identity — the first factor of the sign-in this code completes,
  /// carried to the session it mints. Null means password (every challenge
  /// opened before this column existed was a password sign-in).
  authMethod        AuthMethod? @map("auth_method")
  expiresAt         DateTime    @map("expires_at")
  consumedAt        DateTime?   @map("consumed_at")
  createdAt         DateTime    @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("auth_email_challenges")
}

/// W3 — OTP & Security Monitoring event types (`security_events`).
enum SecurityEventType {
  otp_sent
  otp_resent
  otp_verified
  otp_failed
  otp_expired
  otp_locked
  otp_rate_limited
  otp_suppressed
  deletion_code_sent
  deletion_code_verified
  deletion_code_failed
  deletion_code_locked
  deletion_code_rate_limited
  signin_rate_limited

  @@map("security_event_type")
}

/// W3 — one authentication-security event for the Platform Owner's
/// OTP & Security Monitoring page. Never holds a code, token, password,
/// raw email or raw IP: the subject and the client address are keyed
/// HMACs (`SecurityEventsService`). Platform-owner SELECT only (RLS);
/// 90-day retention. Rate-limited events are folded per minute into one
/// row (`bucketKey`, `occurrences`).
model SecurityEvent {
  id                String            @id @default(uuid())
  eventType         SecurityEventType @map("event_type")
  surface           String?           @db.VarChar(16)
  userId            String?           @map("user_id")
  subjectHash       String?           @map("subject_hash") @db.VarChar(64)
  ipHash            String?           @map("ip_hash") @db.VarChar(64)
  academyId         String?           @map("academy_id")
  challengeId       String?           @map("challenge_id")
  reason            String?           @db.VarChar(64)
  attemptsRemaining Int?              @map("attempts_remaining") @db.SmallInt
  occurrences       Int               @default(1)
  bucketKey         String?           @unique @map("bucket_key") @db.VarChar(200)
  createdAt         DateTime          @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@index([academyId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([ipHash, createdAt(sort: Desc)])
  @@index([subjectHash, createdAt(sort: Desc)])
  @@map("security_events")
}

/// P64 Communications C4 — a browser this user has proven email ownership
/// from. Separate from `student_devices` (the CONTENT device cap) on
/// purpose: trust is about authentication, the cap is about playback.
/// `tokenHash` is SHA-256 of the `atlas_trust` cookie value. Revoked on
/// password change/reset, "sign out everywhere", and by the user.
model TrustedDevice {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  surface    String
  /// Launch Stabilization A6 — the academy an `academy`-surface trust was
  /// earned on. A trust never skips the emailed code for another academy
  /// or for management. Null for management trust, and for academy rows
  /// recorded before this column (which therefore no longer match).
  academyId  String?   @map("academy_id")
  tokenHash  String    @unique @map("token_hash")
  label      String
  userAgent  String?   @map("user_agent")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId, revokedAt])
  @@index([userId, surface, academyId, revokedAt])
  @@index([expiresAt])
  @@map("trusted_devices")
}

/// Google Identity — an external sign-in provider.
enum AuthIdentityProvider {
  google

  @@map("auth_identity_provider")
}

/// Google Identity (docs/GOOGLE_IDENTITY.md) — an external identity bound to
/// ONE global Atlas account. The binding key is the provider's stable
/// subject (Google's `sub`), NEVER the email: an address can change owner,
/// a subject cannot. `emailAtLink` is display-only ("connected as …").
///
/// Platform-scoped like `users`/`refresh_tokens`/`user_two_factor`: it is
/// read before any user context exists (that is what sign-in is), carries
/// no tenant id, and is reached only through the identity module — so, like
/// them, it has no RLS policy.
model UserAuthIdentity {
  id              String               @id @default(uuid())
  userId          String               @map("user_id")
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        AuthIdentityProvider
  providerSubject String               @map("provider_subject") @db.VarChar(255)
  emailAtLink     String               @map("email_at_link")
  linkedAt        DateTime             @default(now()) @map("linked_at")
  lastUsedAt      DateTime?            @map("last_used_at")

  /// One Atlas account per external identity — the final arbiter of every
  /// link and every concurrent first sign-in.
  @@unique([provider, providerSubject])
  /// One identity per provider per account (v1).
  @@unique([userId, provider])
  @@map("user_auth_identities")
}

/// Google Identity — one sign-in attempt through an external provider, from
/// the button press to the session. Modelled on `live_provider_oauth_states`
/// (hashed single-use state, PKCE verifier, server-derived context) and
/// `auth_email_challenges` (short-lived, retention-deleted).
///
/// EVERY secret is stored as a SHA-256 hash (`state`, `nonce`, the browser
/// binder cookie, the handoff) except the PKCE verifier, which must be sent
/// to the token endpoint and dies with the row. The origin host, surface and
/// academy are derived from the request HOST when the flow starts, never
/// from the browser, and the callback can only ever send the browser back
/// to that host. Provider claims are held only until the flow completes and
/// are purged with the row (24 h).
model AuthOAuthFlow {
  id                    String               @id @default(uuid())
  provider              AuthIdentityProvider
  stateHash             String               @unique @map("state_hash")
  nonceHash             String               @map("nonce_hash")
  binderHash            String               @map("binder_hash")
  codeVerifier          String               @map("code_verifier")
  /// `sign_in` | `sign_up` | `link` | `setup`.
  intent                String
  surface               String
  academyId             String?              @map("academy_id")
  /// The web ORIGIN (`scheme://host[:port]`) the flow started on — the only
  /// place the callback may send the browser and the only one that may complete.
  originHost            String               @map("origin_host")
  returnPath            String?              @map("return_path")
  /// `link` only — the signed-in account the identity is being connected to.
  linkUserId            String?              @map("link_user_id")
  linkUser              User?                @relation("AuthOAuthFlowLinkUser", fields: [linkUserId], references: [id], onDelete: Cascade)
  providerSubject       String?              @map("provider_subject") @db.VarChar(255)
  providerEmail         String?              @map("provider_email")
  providerEmailVerified Boolean?             @map("provider_email_verified")
  providerHostedDomain  String?              @map("provider_hosted_domain")
  providerName          String?              @map("provider_name")
  handoffHash           String?              @unique @map("handoff_hash")
  handoffExpiresAt      DateTime?            @map("handoff_expires_at")
  callbackAt            DateTime?            @map("callback_at")
  handedOffAt           DateTime?            @map("handed_off_at")
  completedAt           DateTime?            @map("completed_at")
  ipAddress             String?              @map("ip_address")
  expiresAt             DateTime             @map("expires_at")
  createdAt             DateTime             @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("auth_oauth_flows")
}

/// P64 Communications C5/C6 — where a tenant is in the post-trial /
/// post-subscription sequence and the hosted-video retention clock. The
/// subscription sweep evaluates it every tick and emits the next step's
/// event when its condition holds, so nothing is scheduled far ahead and a
/// reactivation simply stops producing steps.
model TenantLifecycleState {
  id                  String       @id @default(uuid())
  organizationId      String       @unique @map("organization_id")
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// `active` | `trial_sequence` | `paid_sequence` | `retention_warning` | `deletion_scheduled` | `deleted` | `held`
  phase               String       @default("active")
  /// `trial` | `paid` — which retention window applies.
  origin              String?
  /// The date inactivity is measured from (trial end / grace end / cancellation effective date).
  anchorAt            DateTime?    @map("anchor_at")
  lastStep            String?      @map("last_step")
  lastStepAt          DateTime?    @map("last_step_at")
  deletionScheduledAt DateTime?    @map("deletion_scheduled_at")
  legalHold           Boolean      @default(false) @map("legal_hold")
  holdReason          String?      @map("hold_reason")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  createdAt           DateTime     @default(now()) @map("created_at")

  @@index([phase, deletionScheduledAt])
  @@map("tenant_lifecycle_state")
}

// ---------------------------------------------------------------------------
// Phase 12 — Live Sessions add-on (Zoom).
//
// A Live Session is a FIRST-CLASS COURSE ACTIVITY, not a page that links
// out to Zoom. It sits in the curriculum beside Lesson/Quiz/Assignment and
// follows their established shape exactly: `course_id` required (direct
// scoping without a join, master plan §5.3), `section_id` OPTIONAL (the
// same placement model `quizzes`/`assignments` already use), and an
// `order` so it can be sequenced within its unit (the one thing only
// `course_lessons` had, and the reason a session could otherwise never sit
// "between lesson 2 and the quiz").
//
// `academy_id` is denormalized onto every table below for the same reason
// `enrollments` already carries it: RLS resolves the tenant transitively
// through `academies.organization_id`, and a denormalized academy id keeps
// those policies a single join deep instead of three.
//
// WHAT IS DELIBERATELY NOT HERE: any provider credential. Secrets live
// encrypted in `academy_live_provider_connections.encrypted_credentials`
// via the existing `CredentialEncryptionService` (AES-256-GCM) — the same
// one seam `organization_gateway_credentials` already uses. No new crypto,
// no second secret store.
// ---------------------------------------------------------------------------

/// The live-meeting providers Atlas can speak to. Zoom is the only one
/// today; the enum exists so a second provider is a catalog addition
/// rather than a schema migration across every table below.
enum LiveProviderKey {
  zoom

  @@map("live_provider_key")
}

/// Health of an academy's provider connection.
///
/// `expired` and `revoked` are separate from `error` on purpose: the first
/// two are recoverable by reconnecting and the UI can say so precisely,
/// while `error` covers a provider that is reachable but unhappy.
enum LiveProviderConnectionStatus {
  not_connected
  connected
  expired
  revoked
  error
  /// The stored authorization can no longer be refreshed — Zoom refresh
  /// tokens expire after 90 days, the customer may have deauthorized the
  /// app, or the authorizing Zoom user may be gone. Distinct from
  /// `disconnected`: nobody at Atlas chose this, and the fix is a
  /// re-authorization by the Organization Owner rather than a new setup.
  /// Deliberately NOT `error`, which means "the last health check failed"
  /// and may be transient.
  reconnect_required

  @@map("live_provider_connection_status")
}

/// One academy's connection to one live-meeting provider.
///
/// ACADEMY-SCOPED, NOT GLOBAL. Two academies under the same organization
/// may hold entirely separate Zoom accounts, and one academy's credentials
/// must never authorize a meeting for another. `academy_id` is UNIQUE, so a
/// single academy cannot accumulate competing connections for one provider.
model AcademyLiveProviderConnection {
  id                      String                       @id @default(uuid())
  academyId               String                       @unique @map("academy_id")
  academy                 Academy                      @relation(fields: [academyId], references: [id], onDelete: Cascade)
  providerKey             LiveProviderKey              @default(zoom) @map("provider_key")
  status                  LiveProviderConnectionStatus @default(not_connected)
  /// AES-256-GCM ciphertext produced by `CredentialEncryptionService` —
  /// the identical `base64(iv).base64(tag).base64(ciphertext)` envelope
  /// `organization_gateway_credentials.encrypted_config` stores. NEVER
  /// decrypted outside a server-side provider adapter, and never present
  /// in any response DTO.
  /// AES-256-GCM ciphertext of the OAuth TOKEN SET (access token, refresh
  /// token) — the same envelope and the same `CredentialEncryptionService`
  /// seam as before. What changed is the CONTENT: Atlas no longer stores a
  /// customer's Zoom client secret, because customers no longer create
  /// Zoom apps. Atlas owns the app; this holds only the authorization a
  /// customer granted it.
  encryptedCredentials    String?                      @map("encrypted_credentials")
  /// The Zoom `account_id` of the CUSTOMER's account. Non-secret, stored
  /// in the clear, and the authoritative key a verified webhook is
  /// resolved through — Zoom sends one app-level payload carrying
  /// `payload.account_id`, and this is what maps it to an academy.
  ///
  /// UNIQUE among live connections: two academies binding the same Zoom
  /// account would make that mapping ambiguous, and a webhook could then
  /// be attributed to the wrong tenant. Enforced as a partial unique index
  /// (see the P49 migration) so that disconnected rows, which keep the id
  /// for display, do not block a legitimate rebind.
  externalAccountId       String?                      @map("external_account_id")
  /// When the current access token expires. Stored because a refresh must
  /// happen BEFORE a provider call, not after it fails.
  accessTokenExpiresAt    DateTime?                    @map("access_token_expires_at")
  /// When the refresh token itself expires (Zoom: 90 days). Once past,
  /// no refresh can succeed and only re-authorization recovers it.
  refreshTokenExpiresAt   DateTime?                    @map("refresh_token_expires_at")
  /// The scopes Zoom actually granted — which is not necessarily what was
  /// requested. Stored so a missing capability is diagnosable without
  /// guessing, and never decrypted to read.
  grantedScopes           String[]                     @default([]) @map("granted_scopes")
  /// The Zoom USER who authorized, distinct from `connectedByUserId`
  /// (the Atlas user who clicked Connect). Zoom OAuth tokens are
  /// user-scoped, so meetings are created as this Zoom identity; keeping
  /// it visible is what makes "the person who set this up has left"
  /// diagnosable instead of mysterious.
  externalUserId          String?                      @map("external_user_id")
  /// Display-only, for the connected-account panel. Never used for
  /// identity matching — that is always `externalAccountId`.
  externalUserEmail       String?                      @map("external_user_email")
  /// SHA-256 of the CURRENT refresh token.
  ///
  /// The rotation guard. Zoom invalidates the old refresh token the
  /// instant it issues a new one, so two concurrent refreshes race: the
  /// loser holds a token Zoom has already killed, and writing it second
  /// would overwrite the live one and break the connection. The refresh
  /// write is conditional on this column still matching the token the
  /// refresh STARTED from, so a stale rotation writes nothing.
  ///
  /// A digest, never the token — the guard must not become a place a
  /// credential sits in a WHERE clause.
  refreshTokenFingerprint String?                      @map("refresh_token_fingerprint")
  /// Provider-agnostic success/failure summary only — never a raw provider
  /// error payload (§16, mirroring `lastTestResult` on gateway credentials).
  lastCheckResult         Json?                        @map("last_check_result")
  lastCheckedAt           DateTime?                    @map("last_checked_at")
  connectedByUserId       String?                      @map("connected_by_user_id")
  connectedByUser         User?                        @relation("LiveProviderConnector", fields: [connectedByUserId], references: [id], onDelete: SetNull)
  connectedAt             DateTime?                    @map("connected_at")
  createdAt               DateTime                     @default(now()) @map("created_at")
  updatedAt               DateTime                     @updatedAt @map("updated_at")

  @@index([providerKey, externalAccountId])
  @@map("academy_live_provider_connections")
}

/// A single-use Zoom OAuth authorization state.
///
/// WHY THIS IS A TABLE AND NOT A SIGNED COOKIE OR A JWT. The callback
/// arrives as a top-level browser navigation from Zoom, so anything
/// relying on a SameSite cookie is fragile across the redirect. More
/// importantly, the security property needed here is SINGLE USE, and that
/// is a property of storage, not of a signature: a signed value proves
/// authenticity but can be replayed forever. Consuming a row lets the
/// database decide the race, the same way `live_session_join_grants`
/// already does for student joins.
///
/// WHAT IT CARRIES, AND WHAT IT DELIBERATELY DOES NOT. The academy and
/// the initiating user — both server-derived at authorize time and
/// re-checked on callback — so the browser never gets to nominate which
/// academy a returning authorization binds to. It holds NO secret: the
/// state value itself is the only unguessable part, and it is stored as a
/// HASH so a database reader cannot replay a live authorization.
model LiveProviderOAuthState {
  id             String    @id @default(uuid())
  /// SHA-256 of the state value handed to Zoom. The plaintext exists only
  /// in the redirect URL and is never persisted, matching how
  /// `live_session_join_grants` stores `token_hash`.
  stateHash      String    @unique @map("state_hash")
  academyId      String    @map("academy_id")
  academy        Academy   @relation(fields: [academyId], references: [id], onDelete: Cascade)
  organizationId String    @map("organization_id")
  /// The Atlas user who initiated. The callback must be completed by the
  /// SAME user — an authorization started by an owner cannot be finished
  /// by whoever else happens to open the callback URL.
  userId         String    @map("user_id")
  user           User      @relation("LiveProviderOAuthInitiator", fields: [userId], references: [id], onDelete: Cascade)
  /// PKCE verifier, when used. Not a long-lived secret, but still never
  /// returned anywhere.
  codeVerifier   String?   @map("code_verifier")
  /// Set the moment the state is spent. A second callback with the same
  /// state matches nothing and is refused.
  consumedAt     DateTime? @map("consumed_at")
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("live_provider_oauth_states")
}

/// A Live Session's lifecycle.
///
/// Mirrors the draft/published split `course_lessons`/`quizzes`/
/// `assignments` already use, extended with the states a scheduled
/// real-time event genuinely has. `scheduled` is the published-but-not-yet
/// -started state; `failed` means the provider could not create or start
/// the meeting and is retryable.
enum LiveSessionStatus {
  draft
  scheduled
  live
  ended
  cancelled
  failed

  @@map("live_session_status")
}

model LiveSession {
  id                     String            @id @default(uuid())
  courseId               String            @map("course_id")
  course                 Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Optional unit placement — the same model `quizzes`/`assignments` use.
  sectionId              String?           @map("section_id")
  section                CourseSection?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  /// Denormalized for RLS and cross-academy isolation; set at creation
  /// from the course's own academy and never changed afterwards.
  academyId              String            @map("academy_id")
  academy                Academy           @relation(fields: [academyId], references: [id], onDelete: Cascade)
  title                  String
  description            String?
  /// Ordering within the unit, matching `course_lessons.order`.
  order                  Int               @default(0)
  status                 LiveSessionStatus @default(draft)
  scheduledStartAt       DateTime          @map("scheduled_start_at")
  scheduledEndAt         DateTime          @map("scheduled_end_at")
  /// The instructor who hosts. A real Atlas user, so host authority is an
  /// Atlas fact rather than a provider-side display name.
  hostUserId             String            @map("host_user_id")
  hostUser               User              @relation("LiveSessionHost", fields: [hostUserId], references: [id])
  /// ATLAS IS AUTHORITATIVE FOR RECORDING, AND IT IS OFF BY DEFAULT.
  /// A provider account whose own default is "record everything" must
  /// never produce an Atlas recording while this is false — the webhook
  /// handler checks this column before importing anything.
  recordingEnabled       Boolean           @default(false) @map("recording_enabled")
  providerKey            LiveProviderKey   @default(zoom) @map("provider_key")
  /// The provider's meeting identifier. Not a secret, and the key a
  /// webhook is resolved through.
  providerMeetingId      String?           @map("provider_meeting_id")
  startedAt              DateTime?         @map("started_at")
  endedAt                DateTime?         @map("ended_at")
  cancelledAt            DateTime?         @map("cancelled_at")
  /// When the starting-soon reminder was sent for the CURRENT scheduled
  /// time. Cleared on reschedule, so a moved class earns a new reminder
  /// rather than reusing the old one's "already sent" mark.
  startingSoonNotifiedAt DateTime?         @map("starting_soon_notified_at")
  /// When the provider's post-session report was successfully applied.
  /// The sweep skips anything already reconciled, which is what makes it
  /// safe to run every few minutes.
  attendanceReconciledAt DateTime?         @map("attendance_reconciled_at")
  /// Bounded retries for a report the provider never makes available —
  /// without this, a session whose report 404s forever would be retried
  /// on every tick for the life of the platform.
  reconciliationAttempts Int               @default(0) @map("reconciliation_attempts")
  /// Provider-agnostic reason a session failed. Never a raw payload.
  failureReason          String?           @map("failure_reason")
  createdByUserId        String?           @map("created_by_user_id")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")

  participants LiveSessionParticipant[]
  attendance   LiveSessionAttendanceInterval[]
  recording    LiveSessionRecording?

  @@index([courseId, sectionId, order])
  @@index([academyId, status, scheduledStartAt])
  @@index([providerKey, providerMeetingId])
  @@map("live_sessions")
}

/// THE DETERMINISTIC ATLAS↔PROVIDER IDENTITY MAP.
///
/// Attendance must never be matched by display name or email similarity —
/// two students called "Ahmed" would silently merge, and a participant who
/// renames themselves in the provider UI would corrupt the record. Instead
/// Atlas mints an opaque `participant_key` per (session, user) when a join
/// is authorized, hands it to the provider as the participant's identity,
/// and resolves webhook events back through it. Exact, or unmatched —
/// never approximate.
///
/// `provider_participant_id` is recorded when the provider reports one,
/// purely as a reconciliation aid for post-session reports. It is NOT the
/// identity: it is provider-assigned, can differ between the live event
/// stream and the after-the-fact report, and is meaningless across sessions.
model LiveSessionParticipant {
  id                    String      @id @default(uuid())
  liveSessionId         String      @map("live_session_id")
  liveSession           LiveSession @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  userId                String      @map("user_id")
  user                  User        @relation("LiveSessionParticipant", fields: [userId], references: [id], onDelete: Cascade)
  academyId             String      @map("academy_id")
  /// Opaque, unguessable, unique across all sessions. This is the identity.
  participantKey        String      @unique @map("participant_key")
  /// Provider-assigned id, for reconciliation only — never the identity.
  providerParticipantId String?     @map("provider_participant_id")
  role                  String      @default("attendee")
  createdAt             DateTime    @default(now()) @map("created_at")

  attendance LiveSessionAttendanceInterval[]

  @@unique([liveSessionId, userId])
  @@index([liveSessionId])
  @@map("live_session_participants")
}

/// Where one attendance interval came from.
///
/// `sdk_event` is deliberately the WEAKEST source and never the only one
/// trusted: a browser can stop sending events by closing a laptop lid.
/// `provider_webhook` is the live authoritative stream; `provider_report`
/// is the post-session reconciliation that corrects it; `manual` is an
/// explicit human override, always visibly marked as such.
enum LiveAttendanceSource {
  sdk_event
  provider_webhook
  provider_report
  manual

  @@map("live_attendance_source")
}

/// ONE JOIN→LEAVE INTERVAL. Attendance is interval-based, never a boolean:
/// a student who joins three times has three rows, and total participation
/// is their sum — which is the only way "attended 6 of 45 minutes" can be
/// distinguished from "attended throughout".
///
/// `left_at` is nullable while a participant is still in the meeting.
model LiveSessionAttendanceInterval {
  id            String                 @id @default(uuid())
  liveSessionId String                 @map("live_session_id")
  liveSession   LiveSession            @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  participantId String                 @map("participant_id")
  participant   LiveSessionParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  academyId     String                 @map("academy_id")
  joinedAt      DateTime               @map("joined_at")
  leftAt        DateTime?              @map("left_at")
  source        LiveAttendanceSource
  /// Idempotency key derived from the provider event, so a duplicate or
  /// replayed webhook cannot create a second identical interval.
  eventKey      String?                @unique @map("event_key")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  @@index([liveSessionId, participantId, joinedAt])
  @@map("live_session_attendance_intervals")
}

/// Recording lifecycle, separate from recording POLICY
/// (`live_sessions.recording_enabled`) and from QUOTA consumption.
///
/// Conflating the three is how a checkbox ends up costing a customer a
/// recorded session they never got: ticking the box sets policy, the
/// provider actually starting to record is the business event that
/// consumes quota, and `available` is only reached once files exist.
enum LiveSessionRecordingStatus {
  requested
  processing
  available
  failed

  @@map("live_session_recording_status")
}

/// AT MOST ONE PER SESSION — `live_session_id` is UNIQUE, and that is what
/// makes the quota count recorded SESSIONS rather than recording files. A
/// provider that produces three files for one meeting creates three
/// `live_session_recording_files` rows under this single row, consuming
/// exactly one unit of `recordedSessions`.
///
/// `quota_consumed_at` records WHEN the business event happened. It is set
/// in the same transaction that passes the limit check, so a retry or a
/// duplicate provider event finds it already set and does not charge twice.
model LiveSessionRecording {
  id                  String                     @id @default(uuid())
  liveSessionId       String                     @unique @map("live_session_id")
  liveSession         LiveSession                @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  academyId           String                     @map("academy_id")
  /// Denormalized so the quota count is a single-table scan per organization.
  organizationId      String                     @map("organization_id")
  status              LiveSessionRecordingStatus @default(requested)
  providerRecordingId String?                    @map("provider_recording_id")
  /// Set exactly once, in the transaction that passed the limit check.
  quotaConsumedAt     DateTime?                  @map("quota_consumed_at")
  failureReason       String?                    @map("failure_reason")
  startedAt           DateTime?                  @map("started_at")
  availableAt         DateTime?                  @map("available_at")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  files LiveSessionRecordingFile[]

  @@index([organizationId, quotaConsumedAt])
  @@index([academyId, status])
  @@map("live_session_recordings")
}

/// One provider recording FILE, imported into the academy's existing media
/// library. Many files may belong to one recording; none of them
/// individually consume quota.
///
/// `media_asset_id` is nullable while the import is still in flight, and
/// the row is keyed by `provider_file_id` so a duplicate webhook cannot
/// import the same file twice.
model LiveSessionRecordingFile {
  id             String               @id @default(uuid())
  recordingId    String               @map("recording_id")
  recording      LiveSessionRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  academyId      String               @map("academy_id")
  providerFileId String               @map("provider_file_id")
  /// The imported asset in the EXISTING academy media library — never a
  /// second, parallel media store.
  mediaAssetId   String?              @map("media_asset_id")
  mediaAsset     MediaAsset?          @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  fileType       String?              @map("file_type")
  sizeBytes      BigInt?              @map("size_bytes")
  importedAt     DateTime?            @map("imported_at")
  createdAt      DateTime             @default(now()) @map("created_at")

  @@unique([recordingId, providerFileId])
  @@map("live_session_recording_files")
}

/// A SHORT-LIVED, SINGLE-USE AUTHORIZATION TO JOIN ONE SESSION.
///
/// Atlas never hands a student a provider credential or a raw meeting URL.
/// When a join is authorized, this row is minted bound to exactly one
/// (session, user, role) with an expiry, and redeemed once. An expired or
/// already-redeemed grant is refused, so a captured link cannot be replayed
/// or forwarded to a classmate.
///
/// This does NOT claim to stop a determined person from screen-recording or
/// relaying what they see — no software can. It makes the JOIN itself
/// non-transferable, which is the part that is actually enforceable.
model LiveSessionJoinGrant {
  id            String    @id @default(uuid())
  liveSessionId String    @map("live_session_id")
  userId        String    @map("user_id")
  academyId     String    @map("academy_id")
  /// Hash of the opaque token handed to the client — the token itself is
  /// never stored, matching the refresh-token precedent in this codebase.
  tokenHash     String    @unique @map("token_hash")
  role          String    @default("attendee")
  expiresAt     DateTime  @map("expires_at")
  redeemedAt    DateTime? @map("redeemed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([liveSessionId, userId])
  @@index([expiresAt])
  @@map("live_session_join_grants")
}

/// Provider events, recorded BEFORE they are acted on.
///
/// Exactly the pattern `payment_webhook_events` already established:
/// verify the signature, persist with a UNIQUE provider event id so a
/// duplicate delivery is a no-op, then process. An event that cannot be
/// resolved to a known session is stored `unmatched` rather than dropped,
/// because silent discard is indistinguishable from a bug.
enum LiveProviderEventStatus {
  received
  processed
  unmatched
  failed

  @@map("live_provider_event_status")
}

model LiveProviderEvent {
  id              String                  @id @default(uuid())
  providerKey     LiveProviderKey         @default(zoom) @map("provider_key")
  /// The provider's own event id. UNIQUE — this is what makes redelivery
  /// idempotent at the database rather than in application code.
  providerEventId String                  @unique @map("provider_event_id")
  eventType       String                  @map("event_type")
  status          LiveProviderEventStatus @default(received)
  /// Resolved from stored provider identifiers, never from a tenant id
  /// supplied in the request body.
  academyId       String?                 @map("academy_id")
  liveSessionId   String?                 @map("live_session_id")
  /// Non-sensitive extract only — never the raw payload, never signatures.
  summary         Json?
  failureReason   String?                 @map("failure_reason")
  receivedAt      DateTime                @default(now()) @map("received_at")
  processedAt     DateTime?               @map("processed_at")

  @@index([status, receivedAt])
  @@index([liveSessionId])
  @@map("live_provider_events")
}

// ---------------------------------------------------------------------------
// W3-compose — person-authored messages (Platform Owner broadcasts and
// academy Messages) and the per-academy monthly email quota. See
// `prisma/migrations/20261104000100_communication_campaigns` for RLS.
// ---------------------------------------------------------------------------

enum CommunicationCampaignScope {
  platform
  academy

  @@map("communication_campaign_scope")
}

enum CommunicationCampaignStatus {
  queued
  expanding
  sending
  completed
  cancelled
  failed

  @@map("communication_campaign_status")
}

model CommunicationCampaign {
  id                     String                      @id
  scope                  CommunicationCampaignScope
  organizationId         String?                     @map("organization_id")
  organization           Organization?               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academyId              String?                     @map("academy_id")
  academy                Academy?                    @relation(fields: [academyId], references: [id], onDelete: Cascade)
  createdBy              String?                     @map("created_by")
  author                 User?                       @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  idempotencyScope       String                      @map("idempotency_scope") @db.VarChar(80)
  idempotencyKey         String                      @map("idempotency_key") @db.VarChar(100)
  key                    String                      @db.VarChar(100)
  channels               Json
  audience               Json
  subject                String                      @db.VarChar(150)
  bodyHtml               String                      @map("body_html")
  bodyText               String                      @map("body_text")
  contentLocale          String                      @default("en") @map("content_locale") @db.VarChar(8)
  status                 CommunicationCampaignStatus @default(queued)
  recipientCount         Int                         @default(0) @map("recipient_count")
  expectedEmailCount     Int                         @default(0) @map("expected_email_count")
  expansionCursor        String?                     @map("expansion_cursor")
  expandedCount          Int                         @default(0) @map("expanded_count")
  emailReleasedCount     Int                         @default(0) @map("email_released_count")
  inAppReleasedCount     Int                         @default(0) @map("in_app_released_count")
  excludedOptedOut       Int                         @default(0) @map("excluded_opted_out")
  excludedSuppressed     Int                         @default(0) @map("excluded_suppressed")
  excludedQuota          Int                         @default(0) @map("excluded_quota")
  quotaPeriodStart       DateTime?                   @map("quota_period_start")
  quotaReserved          Int                         @default(0) @map("quota_reserved")
  largeAudienceConfirmed Boolean                     @default(false) @map("large_audience_confirmed")
  lastError              String?                     @map("last_error") @db.VarChar(500)
  startedAt              DateTime?                   @map("started_at")
  completedAt            DateTime?                   @map("completed_at")
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime                    @default(now()) @updatedAt @map("updated_at")

  recipients CampaignRecipient[]

  @@unique([idempotencyScope, idempotencyKey], map: "communication_campaigns_idempotency_key")
  @@index([academyId, createdAt(sort: Desc), id(sort: Desc)], map: "communication_campaigns_academy_id_created_at_idx")
  @@index([scope, createdAt(sort: Desc), id(sort: Desc)], map: "communication_campaigns_scope_created_at_idx")
  @@map("communication_campaigns")
}

model CampaignRecipient {
  campaignId    String                @map("campaign_id")
  campaign      CommunicationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId        String                @map("user_id")
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEligible Boolean               @map("email_eligible")
  exclusion     String?               @db.VarChar(32)
  state         Int                   @default(0) @db.SmallInt
  outboxId      String?               @map("outbox_id")
  releasedAt    DateTime?             @map("released_at")

  @@id([campaignId, userId])
  @@index([campaignId, state, userId])
  @@map("campaign_recipients")
}

model TenantEmailUsagePeriod {
  academyId      String       @map("academy_id")
  academy        Academy      @relation(fields: [academyId], references: [id], onDelete: Cascade)
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  periodStart    DateTime     @map("period_start")
  periodEnd      DateTime     @map("period_end")
  /// The limit in force at the latest reservation; null = unlimited.
  limitSnapshot  Int?         @map("limit_snapshot")
  used           Int          @default(0)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at")

  @@id([academyId, periodStart])
  @@map("tenant_email_usage_periods")
}

model TenantEmailUsageLedger {
  id             String       @id
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academyId      String       @map("academy_id")
  academy        Academy      @relation(fields: [academyId], references: [id], onDelete: Cascade)
  periodStart    DateTime     @map("period_start")
  /// The campaign id.
  messageId      String       @map("message_id")
  /// `charge` | `release` | `refund`.
  kind           String       @db.VarChar(16)
  quantity       Int
  createdBy      String?      @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([messageId, kind])
  @@index([academyId, periodStart])
  @@map("tenant_email_usage_ledger")
}

// ---------------------------------------------------------------------------
// Customer Requests — custom services (logo, domain, theme, section,
// feature) an academy's owner/administrator asks the Atlas team for.
// ---------------------------------------------------------------------------

enum CustomerRequestType {
  logo
  domain
  theme
  custom_section
  custom_feature

  @@map("customer_request_type")
}

enum CustomerRequestStatus {
  submitted
  received
  under_review
  in_progress
  waiting_for_customer
  completed
  rejected
  cancelled

  @@map("customer_request_status")
}

enum CustomerRequestPriority {
  low
  normal
  high

  @@map("customer_request_priority")
}

enum CustomerRequestEventKind {
  created
  status_changed
  assigned
  customer_message
  team_message
  internal_note

  @@map("customer_request_event_kind")
}

enum CustomerRequestEventVisibility {
  /// The academy sees it (and the team).
  customer
  /// The Atlas team only — never readable by a tenant (RLS).
  internal

  @@map("customer_request_event_visibility")
}

model CustomerRequest {
  id               String                  @id @default(uuid())
  organizationId   String                  @map("organization_id")
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  academyId        String                  @map("academy_id")
  academy          Academy                 @relation(fields: [academyId], references: [id], onDelete: Cascade)
  requesterUserId  String?                 @map("requester_user_id")
  requester        User?                   @relation("CustomerRequestRequester", fields: [requesterUserId], references: [id], onDelete: SetNull)
  /// Snapshots — the request keeps who filed it even if the account goes.
  requesterName    String                  @map("requester_name")
  requesterEmail   String                  @map("requester_email")
  type             CustomerRequestType
  title            String
  description      String
  priority         CustomerRequestPriority @default(normal)
  /// Type-specific fields (`CUSTOMER_REQUEST_DETAIL_FIELDS`), validated server-side.
  details          Json                    @default("{}")
  status           CustomerRequestStatus   @default(submitted)
  assignedToUserId String?                 @map("assigned_to_user_id")
  assignedTo       User?                   @relation("CustomerRequestAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  /// Idempotency: a retried submit from the same person returns the same row.
  clientRequestId  String                  @map("client_request_id")
  lastActivityAt   DateTime                @default(now()) @map("last_activity_at")
  closedAt         DateTime?               @map("closed_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  events CustomerRequestEvent[]

  @@unique([requesterUserId, clientRequestId])
  @@index([academyId, lastActivityAt(sort: Desc)])
  @@index([status, lastActivityAt(sort: Desc)])
  @@index([type, lastActivityAt(sort: Desc)])
  @@index([organizationId])
  @@map("customer_requests")
}

/// The request's history AND its conversation, in one timeline.
model CustomerRequestEvent {
  id             String                         @id @default(uuid())
  requestId      String                         @map("request_id")
  request        CustomerRequest                @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// Denormalised from the request so tenant RLS needs no join.
  organizationId String                         @map("organization_id")
  kind           CustomerRequestEventKind
  visibility     CustomerRequestEventVisibility
  actorUserId    String?                        @map("actor_user_id")
  actorName      String                         @map("actor_name")
  /// `customer` | `team`.
  actorSide      String                         @map("actor_side")
  body           String?
  fromStatus     CustomerRequestStatus?         @map("from_status")
  toStatus       CustomerRequestStatus?         @map("to_status")
  assigneeUserId String?                        @map("assignee_user_id")
  createdAt      DateTime                       @default(now()) @map("created_at")

  @@index([requestId, createdAt(sort: Asc)])
  @@map("customer_request_events")
}

/// Which team inbox receives each request type. Platform Owners only.
model CustomerRequestRoutingRule {
  type            CustomerRequestType @id
  email           String
  updatedByUserId String?             @map("updated_by_user_id")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@map("customer_request_routing_rules")
}

/// Forensic video watermark (docs/FORENSIC_WATERMARK.md) — which surface a
/// code was drawn on.
enum ForensicWatermarkSurface {
  /// A hosted (MP4 / Cloudflare Stream) or YouTube video inside a lesson,
  /// for an enrolled learner or a staff previewer.
  lesson_video
  /// A free preview lesson on an academy website — possibly anonymous.
  course_preview
  /// An embedded live class (Zoom Meeting SDK).
  live_session

  @@map("forensic_watermark_surface")
}

/// One forensic watermark code: what was shown, to whom, on which session
/// and device. Issued (or reused) on every video grant and live-class join,
/// drawn by the player over the picture, and looked up by the Platform Owner
/// when a recording leaks.
///
/// NO FOREIGN KEYS, ON PURPOSE. The record must outlive everything it points
/// at — a deleted account, an archived academy, a removed lesson — because a
/// leaked recording outlives them too. Ids are kept as plain values and the
/// identity is snapshotted, encrypted, at issue time.
///
/// FORCE RLS: readable only by a Platform Owner; written only through the
/// `forensic_watermark_*` SECURITY DEFINER functions, which admit a row only
/// for the caller's own `app.current_user_id` (or, for an anonymous course
/// preview, only with no user context at all). See migration
/// `20261110000300_forensic_watermarks`.
model ForensicWatermark {
  id               String                   @id @default(uuid())
  /// Ten Crockford base32 symbols (nine random + one mod-37 check), stored
  /// without the display dash: `7K3QMX9TR2` is shown as `7K3QM-X9TR2`.
  code             String                   @unique @db.VarChar(10)
  /// SHA-256 of (surface, viewer, session, target). One code per key: the
  /// same session watching the same video again reuses its code; a new
  /// session gets a new one.
  sessionKey       String                   @unique @map("session_key") @db.VarChar(64)
  surface          ForensicWatermarkSurface
  /// Null only for an anonymous course preview. Never a foreign key — see
  /// the model comment.
  userId           String?                  @map("user_id")
  organizationId   String?                  @map("organization_id")
  academyId        String                   @map("academy_id")
  courseId         String?                  @map("course_id")
  lessonId         String?                  @map("lesson_id")
  liveSessionId    String?                  @map("live_session_id")
  /// The refresh-token family (`refresh_tokens.session_id`) the viewer was
  /// signed in with. Null for an anonymous preview.
  sessionId        String?                  @map("session_id")
  deviceId         String?                  @map("device_id")
  /// SHA-256 of the `atlas_device` cookie — how an anonymous preview's
  /// views are tied together.
  deviceCookieHash String?                  @map("device_cookie_hash") @db.VarChar(64)
  sessionStartedAt DateTime?                @map("session_started_at")
  issuedAt         DateTime                 @default(now()) @map("issued_at")
  /// Bumped by the grant refresh and (throttled) by the playback heartbeat.
  lastSeenAt       DateTime                 @default(now()) @map("last_seen_at")
  clientIp         String?                  @map("client_ip") @db.VarChar(64)
  country          String?                  @db.VarChar(2)
  userAgent        String?                  @map("user_agent") @db.VarChar(512)
  deviceLabel      String?                  @map("device_label") @db.VarChar(120)
  /// How many times the player reported the overlay being removed or hidden.
  tamperEventCount Int                      @default(0) @map("tamper_event_count")
  lastTamperAt     DateTime?                @map("last_tamper_at")
  /// AES-256-GCM ciphertext (`WatermarkSnapshotCipher`) of the viewer's name,
  /// email and phone at issue time, authenticated against `code`. Never
  /// plaintext. Survives account deletion by design (anti-piracy).
  identitySnapshot String?                  @map("identity_snapshot")

  @@index([userId, issuedAt])
  @@index([sessionId])
  @@index([deviceCookieHash])
  @@index([lastSeenAt])
  @@map("forensic_watermarks")
}
